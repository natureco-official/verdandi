{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urdr.local/schemas/context-capsule-v0.2.json",
  "title": "Verðandi Context Compiler Task Capsule",
  "description": "A compact, model-facing task capsule plus adapter-only routing metadata. The model_payload is budget-dependent and must remain within the requested bound (200-1200 estimated tokens). Adapters must not expose control metadata to the model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "model_payload", "control"],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "model_payload": {
      "type": "object",
      "description": "The only portion intended to enter model context.",
      "additionalProperties": false,
      "required": [
        "goal",
        "relevant_symbols",
        "probable_files",
        "decisions",
        "success_criteria"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "relevant_symbols": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/symbol_reference"
          }
        },
        "probable_files": {
          "type": "array",
          "minItems": 0,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "decisions": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary"],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 280
              },
              "urdr_leaf_id": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "success_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "control": {
      "type": "object",
      "description": "Adapter-only metadata. It must be withheld from model-visible tool content. If confidence is below 0.72, the adapter must silently route the task to level 3. Once escalation_attempt reaches max_escalation_attempts, no additional retrieval/escalation attempt may run and handoff_required must be true.",
      "additionalProperties": false,
      "required": [
        "estimated_payload_tokens",
        "retrieval_confidence",
        "uncertainty_reasons",
        "selected_budget_level",
        "silent_escalation",
        "escalation_attempt",
        "max_escalation_attempts",
        "handoff_required"
      ],
      "properties": {
        "estimated_payload_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1200
        },
        "retrieval_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "uncertainty_reasons": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "selected_budget_level": {
          "type": "integer",
          "enum": [0, 1, 2, 3]
        },
        "silent_escalation": {
          "type": "boolean"
        },
        "escalation_attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "description": "Number of retrieval/escalation attempts already consumed by this task."
        },
        "max_escalation_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "default": 3,
          "description": "Hard upper bound. When escalation_attempt reaches this value, the task must be handed to a human."
        },
        "handoff_required": {
          "type": "boolean",
          "description": "True when the attempt limit is exhausted or automated execution can no longer preserve quality."
        },
        "handoff_reason": {
          "type": "string",
          "maxLength": 280
        },
        "retrieval_snapshot": {
          "type": "string",
          "maxLength": 128,
          "description": "Content hash or index generation used to detect stale evidence."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "retrieval_confidence": {
                "exclusiveMaximum": 0.72
              }
            },
            "required": ["retrieval_confidence"]
          },
          "then": {
            "properties": {
              "selected_budget_level": {
                "const": 3
              },
              "silent_escalation": {
                "const": true
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "symbol_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "file", "kind", "hop_distance", "relation"],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "kind": {
          "type": "string",
          "enum": [
            "function",
            "method",
            "class",
            "interface",
            "type",
            "enum",
            "variable",
            "module",
            "test",
            "unknown"
          ]
        },
        "hop_distance": {
          "type": "integer",
          "enum": [0, 1],
          "description": "0 for a direct retrieval match; 1 for a required call-graph neighbor."
        },
        "relation": {
          "type": "string",
          "enum": [
            "direct_match",
            "caller",
            "callee",
            "importer",
            "imported",
            "test_target",
            "tested_by",
            "type_dependency"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Normalized public relevance score. Internal BM25 scores are not exposed."
        }
      }
    }
  }
}
