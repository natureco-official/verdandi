{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc 'git diff --check && git diff -- packages/core-internal/src/shared/inboundClassification.ts packages/core-internal/test/shared/standardHeaderValidation.test.ts packages/core-internal/test/shared/inboundClassification.test.ts'","aggregated_output":"diff --git a/packages/core-internal/src/shared/inboundClassification.ts b/packages/core-internal/src/shared/inboundClassification.ts\nindex 35f694c..727e498 100644\n--- a/packages/core-internal/src/shared/inboundClassification.ts\n+++ b/packages/core-internal/src/shared/inboundClassification.ts\n@@ -77,6 +77,11 @@ import { envelopeClaimVersion, hasEnvelopeClaim, requestMetaOf, validateEnvelope\n import { decodeMcpParamValue } from './mcpParamHeaders';\n import { isModernProtocolVersion } from './protocolEras';\n \n+/** Remove RFC 9110 optional whitespace without accepting any other characters. */\n+function trimHeaderOws(value: string): string {\n+    return value.replace(/^[ \\t]+|[ \\t]+$/g, '');\n+}\n+\n /* ------------------------------------------------------------------------ *\n  * Classifier input\n  * ------------------------------------------------------------------------ */\n@@ -537,7 +542,8 @@ export function validateStandardRequestHeaders(request: InboundHttpRequest, rout\n         );\n     }\n \n-    const decoded = decodeMcpParamValue(request.mcpNameHeader);\n+    const mcpNameHeader = trimHeaderOws(request.mcpNameHeader);\n+    const decoded = decodeMcpParamValue(mcpNameHeader);\n     if (decoded === undefined) {\n         return crossCheckMismatch(\n             'name-header-invalid-encoding',\n@@ -824,7 +830,19 @@ export function classifyInboundRequest(request: InboundHttpRequest): InboundClas\n         return { kind: 'legacy', reason: 'http-method' };\n     }\n \n-    const body = request.body;\n+    // RFC 9110 permits optional SP / HTAB around field values. Normalize only\n+    // that edge whitespace before validating the standard MCP headers; the\n+    // remaining value is still compared exactly with the body.\n+    const normalizedRequest: InboundHttpRequest = {\n+        ...request,\n+        ...(request.protocolVersionHeader !== undefined && {\n+            protocolVersionHeader: trimHeaderOws(request.protocolVersionHeader)\n+        }),\n+        ...(request.mcpMethodHeader !== undefined && { mcpMethodHeader: trimHeaderOws(request.mcpMethodHeader) }),\n+        ...(request.mcpNameHeader !== undefined && { mcpNameHeader: trimHeaderOws(request.mcpNameHeader) })\n+    };\n+\n+    const body = normalizedRequest.body;\n     if (Array.isArray(body)) {\n         return classifyBatch(body);\n     }\n@@ -835,10 +853,10 @@ export function classifyInboundRequest(request: InboundHttpRequest): InboundClas\n         return { kind: 'legacy', reason: 'response' };\n     }\n     if (isPlainObject(body) && isJSONRPCRequest(body)) {\n-        return classifyRequestBody(request, body);\n+        return classifyRequestBody(normalizedRequest, body);\n     }\n     if (isPlainObject(body) && isJSONRPCNotification(body)) {\n-        return classifyNotificationBody(request, body);\n+        return classifyNotificationBody(normalizedRequest, body);\n     }\n     return rejection(\n         'jsonrpc-shape',\ndiff --git a/packages/core-internal/test/shared/inboundClassification.test.ts b/packages/core-internal/test/shared/inboundClassification.test.ts\nindex 16017d7..e216176 100644\n--- a/packages/core-internal/test/shared/inboundClassification.test.ts\n+++ b/packages/core-internal/test/shared/inboundClassification.test.ts\n@@ -278,6 +278,20 @@ describe('header cross-checks (-32020 HeaderMismatch) and the missing-envelope r\n         expect(outcome.kind).toBe('modern');\n     });\n \n+    test('standard header comparisons ignore leading and trailing SP / HTAB only', () => {\n+        const outcome = classifyInboundRequest(\n+            post(modernToolsCall(), { protocolVersion: ` \\t${MODERN_REVISION}\\t `, mcpMethod: ' \\ttools/call\\t ' })\n+        );\n+        expect(outcome.kind).toBe('modern');\n+\n+        expectMismatch(\n+            classifyInboundRequest(\n+                post(modernToolsCall(), { protocolVersion: ` \\t${MODERN_REVISION}-wrong\\t `, mcpMethod: ' \\ttools/call\\t ' })\n+            ),\n+            'header-body-version-mismatch'\n+        );\n+    });\n+\n     test('the Mcp-Method header is never enforced on legacy requests', () => {\n         const outcome = classifyInboundRequest(post(legacyToolsList(), { protocolVersion: '2025-06-18', mcpMethod: 'tools/call' }));\n         expect(outcome).toMatchObject({ kind: 'legacy', reason: 'no-claim' });\ndiff --git a/packages/core-internal/test/shared/standardHeaderValidation.test.ts b/packages/core-internal/test/shared/standardHeaderValidation.test.ts\nindex 8a15037..c1e36d2 100644\n--- a/packages/core-internal/test/shared/standardHeaderValidation.test.ts\n+++ b/packages/core-internal/test/shared/standardHeaderValidation.test.ts\n@@ -71,6 +71,14 @@ describe('SEP-2243 standard-header validation (Mcp-Method presence)', () => {\n         expect(validateStandardRequestHeaders(request, route)).toBeUndefined();\n     });\n \n+    test('Mcp-Method accepts leading and trailing OWS but still rejects a wrong inner value', () => {\n+        const padded = modernPost('tools/list', {}, { mcpMethod: ' \\ttools/list\\t ' });\n+        expect(validateStandardRequestHeaders(padded.request, padded.route)).toBeUndefined();\n+\n+        const wrong = modernPost('tools/list', {}, { mcpMethod: ' \\ttools/call\\t ' });\n+        expect(classifyInboundRequest(wrong.request)).toMatchObject({ kind: 'reject', cell: 'method-header-mismatch' });\n+    });\n+\n     test('the Mcp-Method mismatch cell stays inside classifyInboundRequest (precedence over presence)', () => {\n         // The mismatch is answered by the classifier itself; this function\n         // never sees a route for that input. Asserted here so the\n@@ -162,6 +170,22 @@ describe('SEP-2243 standard-header validation (Mcp-Name presence and cross-check\n         expect(validateStandardRequestHeaders(request, route)).toBeUndefined();\n     });\n \n+    test('Mcp-Name accepts leading and trailing OWS but still rejects a wrong inner value', () => {\n+        const matching = modernPost(\n+            'tools/call',\n+            { name: 'echo', arguments: {} },\n+            { mcpMethod: 'tools/call', mcpName: ' \\techo\\t ' }\n+        );\n+        expect(validateStandardRequestHeaders(matching.request, matching.route)).toBeUndefined();\n+\n+        const wrong = modernPost(\n+            'tools/call',\n+            { name: 'echo', arguments: {} },\n+            { mcpMethod: 'tools/call', mcpName: ' \\tnot-echo\\t ' }\n+        );\n+        expectRejection(validateStandardRequestHeaders(wrong.request, wrong.route), 'name-header-mismatch');\n+    });\n+\n     test('a matching Mcp-Name on a resources/read compares against params.uri', () => {\n         const uri = 'file:///projects/app/config.json';\n         const { request, route } = modernPost('resources/read', { uri }, { mcpMethod: 'resources/read', mcpName: uri });\n","exit_code":0,"status":"completed"}}
