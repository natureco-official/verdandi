{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba src/shared/inboundClassification.ts | sed -n '76,90p;535,555p;825,865p' && nl -ba test/shared/inboundClassification.test.ts | sed -n '272,305p' && nl -ba test/shared/standardHeaderValidation.test.ts | sed -n '65,100p;165,205p'\"","aggregated_output":"    76\t// function bodies, never at module-evaluation time).\n    77\timport { decodeMcpParamValue } from './mcpParamHeaders';\n    78\timport { isModernProtocolVersion } from './protocolEras';\n    79\t\n    80\t/** Remove RFC 9110 optional whitespace without accepting any other characters. */\n    81\tfunction trimHeaderOws(value: string): string {\n    82\t    return value.replaceAll(/^[ \\t]+|[ \\t]+$/g, '');\n    83\t}\n    84\t\n    85\t/* ------------------------------------------------------------------------ *\n    86\t * Classifier input\n    87\t * ------------------------------------------------------------------------ */\n    88\t\n    89\t/**\n    90\t * The transport-neutral description of an inbound HTTP request the classifier\n   535\t            return undefined;\n   536\t        }\n   537\t        return crossCheckMismatch(\n   538\t            'name-header-missing',\n   539\t            '(missing)',\n   540\t            `the body carries params.${sourceField}=\"${bodyValue}\" but the required Mcp-Name header is absent`,\n   541\t            'standard-header-validation'\n   542\t        );\n   543\t    }\n   544\t\n   545\t    const mcpNameHeader = trimHeaderOws(request.mcpNameHeader);\n   546\t    const decoded = decodeMcpParamValue(mcpNameHeader);\n   547\t    if (decoded === undefined) {\n   548\t        return crossCheckMismatch(\n   549\t            'name-header-invalid-encoding',\n   550\t            request.mcpNameHeader,\n   551\t            'the Mcp-Name header carries an invalid Base64 sentinel value',\n   552\t            'standard-header-validation'\n   553\t        );\n   554\t    }\n   555\t    if (bodyValue !== undefined && decoded !== bodyValue) {\n   825\t */\n   826\texport function classifyInboundRequest(request: InboundHttpRequest): InboundClassificationOutcome {\n   827\t    if (request.httpMethod.toUpperCase() !== 'POST') {\n   828\t        // Body-less 2025-era session operations (and any other non-POST\n   829\t        // method): the modern era is POST-only.\n   830\t        return { kind: 'legacy', reason: 'http-method' };\n   831\t    }\n   832\t\n   833\t    // RFC 9110 permits optional SP / HTAB around field values. Normalize only\n   834\t    // that edge whitespace before validating the standard MCP headers; the\n   835\t    // remaining value is still compared exactly with the body.\n   836\t    const normalizedRequest: InboundHttpRequest = {\n   837\t        ...request,\n   838\t        ...(request.protocolVersionHeader !== undefined && {\n   839\t            protocolVersionHeader: trimHeaderOws(request.protocolVersionHeader)\n   840\t        }),\n   841\t        ...(request.mcpMethodHeader !== undefined && { mcpMethodHeader: trimHeaderOws(request.mcpMethodHeader) }),\n   842\t        ...(request.mcpNameHeader !== undefined && { mcpNameHeader: trimHeaderOws(request.mcpNameHeader) })\n   843\t    };\n   844\t\n   845\t    const body = normalizedRequest.body;\n   846\t    if (Array.isArray(body)) {\n   847\t        return classifyBatch(body);\n   848\t    }\n   849\t    if (isJSONRPCResultResponse(body) || isJSONRPCErrorResponse(body)) {\n   850\t        // Posted responses are 2025-era session traffic (replies to\n   851\t        // server-initiated requests over a session); the modern era has no\n   852\t        // such channel.\n   853\t        return { kind: 'legacy', reason: 'response' };\n   854\t    }\n   855\t    if (isPlainObject(body) && isJSONRPCRequest(body)) {\n   856\t        return classifyRequestBody(normalizedRequest, body);\n   857\t    }\n   858\t    if (isPlainObject(body) && isJSONRPCNotification(body)) {\n   859\t        return classifyNotificationBody(normalizedRequest, body);\n   860\t    }\n   861\t    return rejection(\n   862\t        'jsonrpc-shape',\n   863\t        'invalid-json-rpc-body',\n   864\t        400,\n   865\t        new ProtocolError(ProtocolErrorCode.InvalidRequest, 'Bad Request: the request body is not a valid JSON-RPC message'),\n   272\t        const outcome = classifyInboundRequest(post(modernToolsCall(), { protocolVersion: MODERN_REVISION, mcpMethod: 'tools/list' }));\n   273\t        expectMismatch(outcome, 'method-header-mismatch');\n   274\t    });\n   275\t\n   276\t    test('a matching Mcp-Method header passes', () => {\n   277\t        const outcome = classifyInboundRequest(post(modernToolsCall(), { protocolVersion: MODERN_REVISION, mcpMethod: 'tools/call' }));\n   278\t        expect(outcome.kind).toBe('modern');\n   279\t    });\n   280\t\n   281\t    test('standard header comparisons ignore leading and trailing SP / HTAB only', () => {\n   282\t        const outcome = classifyInboundRequest(\n   283\t            post(modernToolsCall(), { protocolVersion: ` \\t${MODERN_REVISION}\\t `, mcpMethod: ' \\ttools/call\\t ' })\n   284\t        );\n   285\t        expect(outcome.kind).toBe('modern');\n   286\t\n   287\t        expectMismatch(\n   288\t            classifyInboundRequest(\n   289\t                post(modernToolsCall(), { protocolVersion: ` \\t${MODERN_REVISION}-wrong\\t `, mcpMethod: ' \\ttools/call\\t ' })\n   290\t            ),\n   291\t            'header-body-version-mismatch'\n   292\t        );\n   293\t    });\n   294\t\n   295\t    test('the Mcp-Method header is never enforced on legacy requests', () => {\n   296\t        const outcome = classifyInboundRequest(post(legacyToolsList(), { protocolVersion: '2025-06-18', mcpMethod: 'tools/call' }));\n   297\t        expect(outcome).toMatchObject({ kind: 'legacy', reason: 'no-claim' });\n   298\t    });\n   299\t});\n   300\t\n   301\tdescribe('notification routing (header determinative when the body carries no claim)', () => {\n   302\t    test('a modern protocol-version header routes a claim-less notification to modern serving', () => {\n   303\t        const outcome = classifyInboundRequest(post(notification(), { protocolVersion: MODERN_REVISION }));\n   304\t        expect(outcome).toMatchObject({\n   305\t            kind: 'modern',\n    65\t        const { request, route } = modernPost('tools/list', {});\n    66\t        expectRejection(validateStandardRequestHeaders(request, route), 'method-header-missing');\n    67\t    });\n    68\t\n    69\t    test('a present Mcp-Method header passes for a method with no Mcp-Name source', () => {\n    70\t        const { request, route } = modernPost('tools/list', {}, { mcpMethod: 'tools/list' });\n    71\t        expect(validateStandardRequestHeaders(request, route)).toBeUndefined();\n    72\t    });\n    73\t\n    74\t    test('Mcp-Method accepts leading and trailing OWS but still rejects a wrong inner value', () => {\n    75\t        const padded = modernPost('tools/list', {}, { mcpMethod: ' \\ttools/list\\t ' });\n    76\t        expect(validateStandardRequestHeaders(padded.request, padded.route)).toBeUndefined();\n    77\t\n    78\t        expect(\n    79\t            classifyInboundRequest({\n    80\t                httpMethod: 'POST',\n    81\t                protocolVersionHeader: MODERN,\n    82\t                mcpMethodHeader: ' \\ttools/call\\t ',\n    83\t                body: { jsonrpc: '2.0', id: 1, method: 'tools/list', params: { _meta: ENVELOPE } }\n    84\t            })\n    85\t        ).toMatchObject({ kind: 'reject', cell: 'method-header-mismatch' });\n    86\t    });\n    87\t\n    88\t    test('the Mcp-Method mismatch cell stays inside classifyInboundRequest (precedence over presence)', () => {\n    89\t        // The mismatch is answered by the classifier itself; this function\n    90\t        // never sees a route for that input. Asserted here so the\n    91\t        // standard-header rung's two halves stay observably ordered.\n    92\t        const inbound: InboundHttpRequest = {\n    93\t            httpMethod: 'POST',\n    94\t            protocolVersionHeader: MODERN,\n    95\t            mcpMethodHeader: 'prompts/list',\n    96\t            body: { jsonrpc: '2.0', id: 1, method: 'tools/list', params: { _meta: ENVELOPE } }\n    97\t        };\n    98\t        const outcome = classifyInboundRequest(inbound);\n    99\t        expect(outcome.kind).toBe('reject');\n   100\t        expect((outcome as InboundLadderRejection).cell).toBe('method-header-mismatch');\n   165\t    test('an invalid Base64 sentinel in Mcp-Name is rejected (name-header-invalid-encoding)', () => {\n   166\t        const { request, route } = modernPost(\n   167\t            'tools/call',\n   168\t            { name: 'echo', arguments: {} },\n   169\t            { mcpMethod: 'tools/call', mcpName: '=?base64?SGVs!!!bG8=?=' }\n   170\t        );\n   171\t        expectRejection(validateStandardRequestHeaders(request, route), 'name-header-invalid-encoding');\n   172\t    });\n   173\t\n   174\t    test('a matching Mcp-Name on a prompts/get passes', () => {\n   175\t        const { request, route } = modernPost('prompts/get', { name: 'greeting' }, { mcpMethod: 'prompts/get', mcpName: 'greeting' });\n   176\t        expect(validateStandardRequestHeaders(request, route)).toBeUndefined();\n   177\t    });\n   178\t\n   179\t    test('Mcp-Name accepts leading and trailing OWS but still rejects a wrong inner value', () => {\n   180\t        const matching = modernPost('tools/call', { name: 'echo', arguments: {} }, { mcpMethod: 'tools/call', mcpName: ' \\techo\\t ' });\n   181\t        expect(validateStandardRequestHeaders(matching.request, matching.route)).toBeUndefined();\n   182\t\n   183\t        const wrong = modernPost('tools/call', { name: 'echo', arguments: {} }, { mcpMethod: 'tools/call', mcpName: ' \\tnot-echo\\t ' });\n   184\t        expectRejection(validateStandardRequestHeaders(wrong.request, wrong.route), 'name-header-mismatch');\n   185\t    });\n   186\t\n   187\t    test('a matching Mcp-Name on a resources/read compares against params.uri', () => {\n   188\t        const uri = 'file:///projects/app/config.json';\n   189\t        const { request, route } = modernPost('resources/read', { uri }, { mcpMethod: 'resources/read', mcpName: uri });\n   190\t        expect(validateStandardRequestHeaders(request, route)).toBeUndefined();\n   191\t    });\n   192\t\n   193\t    test('the Mcp-Name source map covers exactly the spec table', () => {\n   194\t        expect(MCP_NAME_HEADER_SOURCE).toEqual({ 'tools/call': 'name', 'prompts/get': 'name', 'resources/read': 'uri' });\n   195\t    });\n   196\t\n   197\t    test('a method colliding with Object.prototype members is treated as off-table (passes through to dispatch)', () => {\n   198\t        // `constructor` would return Object.prototype.constructor on a bare\n   199\t        // lookup; the Object.hasOwn guard keeps the early-return firing.\n   200\t        const { request, route } = modernPost('constructor', {}, { mcpMethod: 'constructor', mcpName: '=?base64?!!?=' });\n   201\t        expect(validateStandardRequestHeaders(request, route)).toBeUndefined();\n   202\t    });\n   203\t});\n   204\t\n   205\tdescribe('classifyInboundRequest is unchanged by the standard-header presence rung', () => {\n","exit_code":0,"status":"completed"}}
