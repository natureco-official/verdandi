.test.ts:35:    headers?: Record<string, string | string[]>;\n./packages/middleware/node/test/toWebRequest.test.ts:40:        headers: init.headers ?? {},\n./packages/middleware/node/test/toWebRequest.test.ts:54:                headers: { host: 'localhost:3000', 'content-type': 'application/json' },\n./packages/middleware/node/test/toWebRequest.test.ts:61:        expect(request.headers.get('content-type')).toBe('application/json');\n./packages/middleware/node/test/toWebRequest.test.ts:65:    it('re-serializes a supplied parsedBody, rewrites the entity headers, and never touches the Node stream', async () => {\n./packages/middleware/node/test/toWebRequest.test.ts:73:                headers: {\n./packages/middleware/node/test/toWebRequest.test.ts:87:        expect(request.headers.get('content-type')).toBe('application/json');\n./packages/middleware/node/test/toWebRequest.test.ts:88:        // Multi-valued Node headers are appended, not collapsed to the first value.\n./packages/middleware/node/test/toWebRequest.test.ts:89:        expect(request.headers.get('accept')).toBe('application/json, text/event-stream');\n./packages/middleware/node/test/toWebRequest.test.ts:90:        // The entity headers described the original raw bytes; they are gone or rewritten.\n./packages/middleware/node/test/toWebRequest.test.ts:91:        expect(request.headers.get('content-encoding')).toBeNull();\n./packages/middleware/node/test/toWebRequest.test.ts:92:        expect(request.headers.get('transfer-encoding')).toBeNull();\n./packages/middleware/node/test/toWebRequest.test.ts:95:        expect(request.headers.get('content-length')).toBe(String(text.length + 1));\n./packages/middleware/node/test/toWebRequest.test.ts:100:            unreadableNodeRequest({ method: 'POST', url: '/mcp', headers: { host: 'localhost', 'content-length': '42' } }),\n./packages/middleware/node/test/toWebRequest.test.ts:105:        expect(request.headers.get('content-length')).toBeNull();\n./packages/middleware/node/test/toWebRequest.test.ts:108:    it('derives the URL host from the Host header (falling back to localhost)', async () => {\n./packages/middleware/node/test/toWebRequest.test.ts:109:        const withHost = await toWebRequest(nodeRequest({ method: 'GET', url: '/a?b=1', headers: { host: 'api.example.test' } }));\n./packages/middleware/node/test/toWebRequest.test.ts:118:    it('derives the URL host from :authority for an HTTP/2 request (no host header) and drops pseudo-headers', async () => {\n./packages/middleware/node/test/toWebRequest.test.ts:119:        // A real HTTP/2 client sends only the pseudo-header — no `host` entry.\n./packages/middleware/node/test/toWebRequest.test.ts:124:                headers: { ':authority': 'h2.example.test:8443', ':path': '/mcp', ':scheme': 'http', 'mcp-protocol-version': '2026-07-28' }\n./packages/middleware/node/test/toWebRequest.test.ts:128:        // Pseudo-header names are skipped — `Headers` rejects them.\n./packages/middleware/node/test/toWebRequest.test.ts:129:        expect(request.headers.get('mcp-protocol-version')).toBe('2026-07-28');\n./packages/middleware/node/test/toWebRequest.test.ts:132:    it('prefers the host header over :authority when both are present', async () => {\n./packages/middleware/node/test/toWebRequest.test.ts:134:            nodeRequest({ method: 'GET', url: '/mcp', headers: { host: 'h1.example.test', ':authority': 'h2.example.test' } })\n./packages/middleware/node/test/toWebRequest.test.ts:140:        const request = await toWebRequest(nodeRequest({ method: 'GET', url: '/mcp', headers: { host: 'localhost' } }), {\n./packages/middleware/node/test/toWebRequest.test.ts:149:        const request = await toWebRequest(nodeRequest({ method: 'GET', url: '/mcp', headers: { host: 'localhost' } }), undefined, {\n./packages/middleware/node/test/toWebRequest.test.ts:160:            nodeRequest({ method: 'POST', url: '/mcp', headers: { host: 'localhost', 'content-type': 'application/json' }, body: raw })\n./packages/server-legacy/src/auth/handlers/metadata.ts:12:    // Configure CORS to allow any origin, to make accessible to web-based MCP clients\n./test/e2e/scenarios/jsonschema.test.ts:67: * The low-level Server applies no server-side output validation, so the\n./test/e2e/scenarios/jsonschema.test.ts:146:    // The good tool is callable and validates.\n./test/e2e/scenarios/jsonschema.test.ts:193:    // enforces prefixItems → validation fails; a draft-07 Ajv with strict:false\n./test/e2e/scenarios/jsonschema.test.ts:227: * validation fails.\n./test/e2e/scenarios/jsonschema.test.ts:256:verifies('client:jsonschema:falsy-structured-content-validated', async ({ transport }: TestArgs) => {\n./test/e2e/scenarios/jsonschema.test.ts:259:    // check on the client: a falsy value is treated as PRESENT and validated,\n./test/e2e/scenarios/jsonschema.test.ts:424:    // result satisfies the wrapped schema (and the legacy client validates it).\n./test/e2e/scenarios/jsonschema.test.ts:508:    // The wrapped schema compiles on the client (the rewritten `$ref` resolves) and validates the\n./test/e2e/scenarios/jsonschema.test.ts:525:    // succeeds (fromJsonSchema below calls it eagerly), validation does not — so the tool is\n./test/e2e/requirements.ts:188:        note: 'The client funnel inspects the raw resultType before schema validation, closing the masking hazard where the tools/call result schema would default content to [] and report a hollow success. Raw relay servers stand in for a 2026-era peer; the streamableHttp leg uses a hand handler (custom fetch), so the cells exercise both an in-process and an HTTP response path.'\n./test/e2e/requirements.ts:312:            \"server.setRequestHandler with a schema whose method literal is NOT in the MCP spec registers a handler; client.request({method:'<custom>'}, ResultSchema) returns the handler's result, not -32601 MethodNotFound. Capability assertions on both sides pass through unknown methods.\"\n./test/e2e/requirements.ts:485:        behavior: 'The client skips structured-content validation when the tool result has isError true.'\n./test/e2e/requirements.ts:487:    'client:output-schema:validate': {\n./test/e2e/requirements.ts:494:        behavior: 'A tool that declares an output schema but returns no structuredContent fails client-side validation.'\n./test/e2e/requirements.ts:500:    'typescript:mcpserver:output-schema:server-validate': {\n./test/e2e/requirements.ts:502:        behavior: 'McpServer validates structuredContent against outputSchema before returning; mismatch produces a server error.'\n./test/e2e/requirements.ts:506:        behavior: 'Server-side output schema validation is skipped when the tool returns an isError result.'\n./test/e2e/requirements.ts:514:            'A tool whose advertised outputSchema uses same-document $ref (\"#/$defs/…\" or \"#anchor\") compiles on the client and validates structuredContent against the referenced subschema.'\n./test/e2e/requirements.ts:531:            'A tool whose advertised outputSchema has a non-object root (e.g. type:\"array\") is accepted by the client validator on the 2026-07-28 era: structuredContent matching that root validates and is returned typed unknown.',\n./test/e2e/requirements.ts:547:            'A tool whose advertised outputSchema declares no $schema is validated by the client with the 2020-12 engine (the default): a 2020-12-only keyword (prefixItems) in the schema is enforced, so structuredContent violating it causes callTool to throw InvalidParams.',\n./test/e2e/requirements.ts:550:    'client:jsonschema:falsy-structured-content-validated': {\n./test/e2e/requirements.ts:555:            'A falsy structuredContent value (0, false, \"\", null) is treated as present by the client and validated against the cached outputSchema — the presence check is `=== undefined`, not falsy, so a tool returning structuredContent: 0 against outputSchema {type:\"integer\"} resolves with the value rather than throwing \"did not return structured content\".',\n./test/e2e/requirements.ts:579:            'On a 2025-era listing, a McpServer tool registered with a non-object-root outputSchema has the outputSchema wrapped in {type:\"object\",properties:{result:<natural>},required:[\"result\"]} (the SEP-2106 legacy interop envelope): the tool stays listed, the schema is valid 2025 wire data, and a 2025 client can compile/validate against the wrapped shape.',\n./test/e2e/requirements.ts:595:            'On a 2025-era listing, a non-object outputSchema with same-document $ref JSON Pointers (\"#\", \"#/…\") wrapped under #/properties/result has every such $ref rewritten to keep resolving: the wrapped schema compiles on the client and validates the wrapped {result:…} structuredContent.',\n./test/e2e/requirements.ts:651:    'mcpserver:tool:input-validation': {\n./test/e2e/requirements.ts:654:            \"Arguments that fail the tool's input validation produce a tool execution error (isError true with the validation failure described in content) without invoking the function.\"\n./test/e2e/requirements.ts:656:    'mcpserver:tool:naming-validation': {\n./test/e2e/requirements.ts:671:            'inputSchema accepts Zod union, intersection, nested-object, preprocess, transform, and pipe schemas; validation/coercion runs before the handler.'\n./test/e2e/requirements.ts:862:    'mcpserver:prompt:args-validation': {\n./test/e2e/requirements.ts:923:            'MCPServer advertises the completions capability when at least one completion source is registered, and omits it otherwise.'\n./test/e2e/requirements.ts:1034:            \"A sampling request the user rejects is answered with a JSON-RPC error (the spec's code for this case is -1, 'User rejected sampling request'), surfaced to the requesting handler as an MCPError.\",\n./test/e2e/requirements.ts:1229:    'elicitation:form:response-validation': {\n./test/e2e/requirements.ts:1232:            'Accepted form-mode content is validated against the requested schema: the client validates the response before sending and the server validates the content it receives.',\n./test/e2e/requirements.ts:1282:        behavior: 'A roots callback that answers with an error surfaces to the requesting handler as an MCPError.',\n./test/e2e/requirements.ts:1334:        behavior: 'Bursts of registration changes on MCPServer are debounced into one list_changed notification per kind.',\n./test/e2e/requirements.ts:1428:    'validation:cfworker-provider': {\n./test/e2e/requirements.ts:1431:            'Passing jsonSchemaValidator: new CfWorkerJsonSchemaValidator() to the Client produces the same accept/reject outcomes as the default Ajv provider for client-side tool outputSchema validation.'\n./test/e2e/requirements.ts:1433:    'validation:pluggable-provider': {\n./test/e2e/requirements.ts:1436:            'ClientOptions.jsonSchemaValidator swaps the JSON Schema validator implementation: the configured provider is the one consulted for client-side tool outputSchema validation and its verdicts are honored.'\n./test/e2e/requirements.ts:1443:        behavior: 'CORS configuration exposes the Mcp-Session-Id header so browser clients can read it.',\n./test/e2e/requirements.ts:1449:        behavior: 'An initialize POST without a session id creates a session and returns Mcp-Session-Id in the response headers.',\n./test/e2e/requirements.ts:1496:                note: \"The SDK's documented hosting pattern rejects unknown session ids with 400 at the app level (see src/examples servers); the transport's own validateSession 404 is never reached, while the spec requires 404.\"\n./test/e2e/requirements.ts:1519:        behavior: 'In stateless mode no Mcp-Session-Id is emitted and no session validation is performed.',\n./test/e2e/requirements.ts:1538:                note: 'webStandardStreamableHttp.ts:833-836: validateSession() returns undefined in stateless mode, so GET opens an SSE stream and DELETE succeeds with 200 instead of 405.'\n./test/e2e/requirements.ts:1573:    'hosting:auth:aud-validation': {\n./test/e2e/requirements.ts:1575:        behavior: 'The resource server validates that the token audience matches its resource identifier.',\n./test/e2e/requirements.ts:1580:                note: 'src/server/auth/middleware/bearerAuth.ts: authInfo.resource is never compared to the resource identifier — audience validation missing.'\n./test/e2e/requirements.ts:1605:            'The MCP server publishes protected-resource metadata at its well-known endpoint, and the authorization server (which the SDK can also host) publishes authorization-server metadata at its own.',\n./test/e2e/requirements.ts:1612:            \"A request without an Authorization header is rejected with 401; the WWW-Authenticate header carries resource_metadata (one of the spec's two permitted discovery mechanisms).\",\n./test/e2e/requirements.ts:1688:        behavior: 'A request whose Accept header does not allow the response representation returns 406.',\n./test/e2e/requirements.ts:1726:        behavior: 'An unsupported HTTP method on the MCP endpoint returns 405.',\n./test/e2e/requirements.ts:1757:        source: 'https://modelcontextprotocol.io/specification/2025-11-25/basic/transports#protocol-version-header',\n./test/e2e/requirements.ts:1758:        behavior: 'An invalid or unsupported MCP-Protocol-Version header returns 400 Bad Request.',\n./test/e2e/requirements.ts:1798:            'createMcpExpressApp() returns an Express app with JSON body parsing and localhost host-header validation pre-applied: an MCP endpoint mounted on it serves an initialize POST over real HTTP from 127.0.0.1 and rejects a spoofed Host header with 403.',\n./test/e2e/requirements.ts:1801:    'hosting:http:host-validation-middleware': {\n./test/e2e/requirements.ts:1805:            \"hostHeaderValidation()/localhostHostValidation() Express middleware reject requests whose Host header is missing or not in the allow-list with 403 (port-agnostic), independent of the transport's enableDnsRebindingProtection.\",\n./test/e2e/requirements.ts:1821:            'removed in v2: the bundled dynamic client registration endpoint no longer exists, so its redirect_uri scheme validation cannot be exercised (this was a knownFailure on v1.x).'\n./test/e2e/requirements.ts:1876:        source: 'https://modelcontextprotocol.io/specification/2025-11-25/basic/transports#protocol-version-header',\n./test/e2e/requirements.ts:1878:            'When no MCP-Protocol-Version header is received and the version cannot be determined another way, the server assumes protocol version 2025-03-26.',\n./test/e2e/requirements.ts:1903:    'client-transport:http:accept-header-get': {\n./test/e2e/requirements.ts:1905:        behavior: 'The client GET to the MCP endpoint includes an Accept header listing text/event-stream.',\n./test/e2e/requirements.ts:1909:    'client-transport:http:accept-header-post': {\n./test/e2e/requirements.ts:1911:        behavior: 'Every client POST to the MCP endpoint includes an Accept header listing both application/json and text/event-stream.',\n./test/e2e/requirements.ts:1927:    'client-transport:http:custom-headers': {\n./test/e2e/requirements.ts:1929:        behavior: 'Caller-supplied headers are sent on every POST, GET, and DELETE to the MCP endpoint.',\n./test/e2e/requirements.ts:1951:    'client-transport:http:protocol-version-header': {\n./test/e2e/requirements.ts:1952:        source: 'https://modelcontextprotocol.io/specification/2025-11-25/basic/transports#protocol-version-header',\n./test/e2e/requirements.ts:1953:        behavior: 'After initialization, the client sends the negotiated MCP-Protocol-Version header on every subsequent HTTP request.',\n./test/e2e/requirements.ts:2011:        note: 'Session-id continuity testing requires the per-session host (validates session recovery/GET stream behavior).',\n./test/e2e/requirements.ts:2049:            'Step-up re-authorization is bounded per send by maxStepUpRetries (default 1), independent of WWW-Authenticate header content; reaching the cap throws an SdkHttpError without further auth() calls.',\n./test/e2e/requirements.ts:2081:    'client-auth:bearer-header:every-request': {\n./test/e2e/requirements.ts:2084:            'Once authorized, the client sends the bearer token in the Authorization header on every HTTP request to the MCP server, never in the query string.',\n./test/e2e/requirements.ts:2109:        behavior: 'An invalid-client or unauthorized-client error during authorization invalidates all stored credentials.',\n./test/e2e/requirements.ts:2115:        behavior: 'An invalid-grant error during authorization invalidates only the stored tokens.',\n./test/e2e/requirements.ts:2211:    'client-auth:as-metadata-discovery:issuer-validation': {\n./test/e2e/requirements.ts:2220:        source: 'https://modelcontextprotocol.io/specification/draft/basic/authorization#authorization-response-issuer-validation',\n./test/e2e/requirements.ts:2222:            \"When the authorization callback's iss exactly matches the issuer recorded from validated AS metadata, finishAuth() proceeds to redeem the authorization code (RFC 9207 §2.4, table row 1).\",\n./test/e2e/requirements.ts:2228:        source: 'https://modelcontextprotocol.io/specification/draft/basic/authorization#authorization-response-issuer-validation',\n./test/e2e/requirements.ts:2236:        source: 'https://modelcontextprotocol.io/specification/draft/basic/authorization#authorization-response-issuer-validation',\n./test/e2e/requirements.ts:2244:        source: 'https://modelcontextprotocol.io/specification/draft/basic/authorization#authorization-response-issuer-validation',\n./test/e2e/requirements.ts:2252:        source: 'https://modelcontextprotocol.io/specification/draft/basic/authorization#authorization-response-issuer-validation',\n./test/e2e/requirements.ts:2262:            'AuthOptions.skipIssuerMetadataValidation: true suppresses only the RFC 8414 §3.3 metadata-issuer-echo check (AU-02) — it does not relax the RFC 9207 callback-iss validation, which continues to reject mismatches.',\n./test/e2e/requirements.ts:2268:        source: 'https://modelcontextprotocol.io/specification/draft/basic/authorization#authorization-response-issuer-validation',\n./test/e2e/requirements.ts:2270:            \"transport.finishAuth(URLSearchParams) extracts code and iss, validates iss against the recorded issuer first, and on mismatch throws IssuerMismatchError without surfacing the callback's error/error_description/error_uri values; the authorization code is never sent to a token endpoint.\",\n./test/e2e/requirements.ts:2276:        source: 'https://modelcontextprotocol.io/specification/draft/basic/authorization#authorization-response-issuer-validation',\n./test/e2e/requirements.ts:2285:            \"When every protected-resource metadata probe fails, the client falls back to discovering authorization-server metadata directly at the MCP server's origin (the legacy 2025-03-26 path) rather than aborting.\",\n./test/e2e/requirements.ts:2396:            'withLogging() wraps fetch: invokes the configured logger once per HTTP request with {method, url, status, duration} and passes the response through unmodified so the MCP call result is unaffected.',\n./test/e2e/requirements.ts:2518:            \"registerTool() accepts a valibot object schema wrapped with @valibot/to-json-schema's toStandardJsonSchema() as inputSchema: tools/list advertises the derived JSON Schema and tools/call passes validated, parsed arguments to the handler.\"\n./test/e2e/requirements.ts:2523:            'registerTool() accepts an arktype type as inputSchema: tools/list advertises the JSON Schema derived from it and tools/call passes validated, parsed arguments to the handler.'\n./test/e2e/requirements.ts:2525:    'standardschema:tool:output-schema-validation': {\n./test/e2e/requirements.ts:2531:                note: \"McpServer's tools/call handler catches the output-validation ProtocolError (-32602) and returns it as an isError result instead of a JSON-RPC error; the nonconforming structuredContent is still withheld from the caller.\"\n./test/e2e/requirements.ts:2538:            'registerPrompt() accepts any Standard Schema as argsSchema: prompts/list exposes the argument names derived from it and prompts/get arguments are validated against it before the callback runs.'\n./test/e2e/requirements.ts:2543:            'tools/call arguments that fail the registered Standard Schema validation are rejected with JSON-RPC -32602 (Input validation error) and the tool handler is not invoked.',\n./test/e2e/requirements.ts:2546:                note: \"McpServer's tools/call handler catches the input-validation ProtocolError (-32602) and returns it as an isError result, so callTool() resolves instead of rejecting; the handler is still not invoked.\"\n./test/e2e/requirements.ts:2561:                note: \"McpServer's tools/call handler catches the input-validation ProtocolError (-32602) and returns it as an isError result, so callTool() resolves instead of rejecting; the handler is still not invoked.\"\n./test/e2e/requirements.ts:2568:            'fromJsonSchema(schema, validator) uses the supplied jsonSchemaValidator implementation for argument validation instead of the runtime default.'\n./test/e2e/requirements.ts:2575:    'guards:spec-type-schemas:sync-validate': {\n./test/e2e/requirements.ts:2578:            \"specTypeSchemas.X['~standard'].validate() validates synchronously: it returns an object (not a Promise) carrying value for conforming input and issues for non-conforming input.\"\n./test/e2e/requirements.ts:2587:    'hosting:hono:host-header-validation': {\n./test/e2e/requirements.ts:2590:            'A createMcpHonoApp() bound to the default localhost host rejects requests whose Host header is not an allowed localhost name with HTTP 403 (DNS-rebinding protection), while requests with a localhost Host succeed.',\n./test/e2e/requirements.ts:2601:    'hosting:fastify:host-header-validation': {\n./test/e2e/requirements.ts:2604:            'A createMcpFastifyApp() bound to the default localhost host rejects requests whose Host header is not an allowed localhost name with HTTP 403 (DNS-rebinding protection), while requests with a localhost Host succeed.',\n./test/e2e/requirements.ts:2615:    'hosting:express:adapter-host-header-validation': {\n./test/e2e/requirements.ts:2618:            'An app created by createMcpExpressApp() with the default localhost host applies DNS-rebinding protection: a request whose Host header is not an allowed local host is rejected with 403 before reaching the MCP transport.',\n./test/e2e/requirements.ts:2646:        note: \"Runs on the entryModern arm (which hosts the entry strict via legacy: 'reject'); the 2025-shaped initialize and the plain-client connect attempt are driven against the harness-hosted endpoint via wired.fetch/wired.url. The numeric error code is asserted by message and supported-list shape only, since it shares a code with the still-disputed header/body mismatch family.\"\n./test/e2e/requirements.ts:2705:        note: 'Runs on the createMcpHandler entry arms; each non-POST method is sent through wired.fetch so the HTTP status and body are observed directly. The entry does not emit an Allow header (the per-session server transport does), so only the status and JSON-RPC error shape are pinned.'\n./test/e2e/requirements.ts:2717:            \"A 2025-era POST whose Accept header does not allow both application/json and text/event-stream is answered 406 by a createMcpHandler endpoint's stateless legacy slot (the legacy fallback delegates to the streamable HTTP server transport, whose Accept negotiation is unchanged).\",\n./test/e2e/requirements.ts:2725:            \"A 2025-era POST whose Content-Type is not application/json is answered 415 by a createMcpHandler endpoint's stateless legacy slot (the legacy fallback delegates to the streamable HTTP server transport, whose Content-Type validation is unchanged).\",\n./test/e2e/requirements.ts:2728:        note: 'Runs on the entryStateless arm and is bounded to the 2025-11-25 axis: Content-Type validation is enforced by the legacy server transport the fallback delegates to. The entry classifier reads the body before that delegate runs, so a body that happens to be valid JSON is still rejected on Content-Type alone.'\n./test/e2e/requirements.ts:2730:    'typescript:hosting:entry:legacy-protocol-version-header-400': {\n./test/e2e/requirements.ts:2731:        source: 'https://modelcontextprotocol.io/specification/2025-11-25/basic/transports#protocol-version-header',\n./test/e2e/requirements.ts:2733:            \"A 2025-era POST carrying an MCP-Protocol-Version header naming an unknown revision is answered 400 by a createMcpHandler endpoint's stateless legacy slot, with the response body naming the supported version(s).\",\n./test/e2e/requirements.ts:2736:        note: 'Runs on the entryStateless arm and is bounded to the 2025-11-25 axis: the protocol-version header check is enforced by the legacy server transport the fallback delegates to. Header/body cross-checks on the modern path are pinned by the entry std-header rows; this row pins only that a non-modern unsupported header still surfaces as 400 through the fallback.'\n./test/e2e/requirements.ts:2739:        source: 'https://modelcontextprotocol.io/specification/2025-11-25/basic/transports#protocol-version-header',\n./test/e2e/requirements.ts:2741:            \"A 2025-era POST without an MCP-Protocol-Version header is served by a createMcpHandler endpoint's stateless legacy slot under the assumed default protocol version (2025-03-26): a tools/list round-trips without the header.\",\n./test/e2e/requirements.ts:2744:        note: 'Runs on the entryStateless arm and is bounded to the 2025-11-25 axis. The probe is POSTed through wired.fetch with only Accept and Content-Type headers so the default-version path is the one exercised.'\n./test/e2e/requirements.ts:2749:            'A createMcpHandler endpoint emits no Mcp-Session-Id response header on either leg: the stateless legacy fallback hosts a sessionless server transport per request, and the modern per-request path has no session at all — every recorded exchange of a connect-then-tools/call round trip carries no session header.',\n./test/e2e/requirements.ts:2753:    'typescript:hosting:entry:ctx-http-req-headers': {\n./test/e2e/requirements.ts:2756:            \"A custom HTTP header set on the StreamableHTTP client transport reaches a tool handler's ctx.http.req as Fetch Headers when the server is hosted by createMcpHandler, on both legs: the stateless legacy fallback and the modern per-request path each thread the original Request through to handler context.\",\n./test/e2e/requirements.ts:2758:        note: \"The body hosts createMcpHandler itself (the wire() entry arm builds the client transport without a custom-header hook) and the matrix arm selects the legacy posture and client pin: entryStateless drives a plain client through legacy: 'stateless', entryModern drives a 2026-07-28-pinned client through legacy: 'reject'.\"\n./test/e2e/requirements.ts:2770:            'A bearer-protected createMcpHandler deployment — a user-composed verification gate in front of handler.fetch — answers a request without an Authorization header with 401 and a WWW-Authenticate challenge on both legs, and the entry is never reached for that request (no factory call).',\n./test/e2e/requirements.ts:2772:        note: \"The body hosts createMcpHandler itself behind the documented bearer-gate composition (verify the Authorization header, then call handler.fetch(request, { authInfo })); the matrix arm selects the legacy posture and client pin. The 401/WWW-Authenticate is the gate's own response — the entry performs no token verification — and the body asserts the gate composes correctly with both serving paths.\"\n./test/e2e/requirements.ts:2779:        note: 'The body hosts createMcpHandler itself behind the documented bearer-gate composition; the matrix arm selects the legacy posture and client pin. authInfo is strictly pass-through — the entry never derives it from request headers — so the cell pins delivery, not verification. The OAuth client flow that obtains the token is hosting-agnostic and is covered by the client-auth family; the dedicated client-completes-OAuth-then-negotiates-2026 journey rides the auth-package redo (M13.1) so it is targeted at the surviving auth surface.'\n./test/e2e/requirements.ts:2784:            'A bearer-protected createMcpHandler deployment whose gate enforces a per-operation scope (deriving the operation from the standard Mcp-Method/Mcp-Name request headers on the modern leg) answers an under-scoped request with 403 and a WWW-Authenticate insufficient_scope challenge naming the required scope, without the entry ever being reached for that request.',\n./test/e2e/requirements.ts:2786:        note: 'The body hosts createMcpHandler behind a per-operation scoped bearer gate; the matrix arm selects the legacy posture and client pin. On the legacy leg the gate falls back to a single required scope (no Mcp-Name header). The cell pins the documented RS-side composition that the client-auth:stepup family drives from the client side.'\n./test/e2e/requirements.ts:2799:            \"A server handler registered with setRequestHandler('<vendor>/method', { params, result }, handler) for a non-spec method receives schema-validated params and its return value is delivered to a client calling request() with the matching result schema.\"\n./test/e2e/requirements.ts:2808:    'custom-methods:params-validation-error': {\n./test/e2e/requirements.ts:2816:            'A notification handler registered for a non-spec method with a params schema receives schema-validated custom notifications sent by the remote side.',\n./test/e2e/requirements.ts:2824:            'client.request() called with a spec method string and no result schema resolves with the result already parsed and validated for that method (ResultTypeMap inference), e.g. tools/list yields a usable tools array without passing a schema.'\n./test/e2e/requirements.ts:2826:    'protocol:result-validation:invalid-result-sdkerror': {\n./test/e2e/requirements.ts:2856:    'hosting:context:web-request-headers': {\n./test/e2e/requirements.ts:2859:            \"Under HTTP hosting, a request handler's ctx.http.req exposes the incoming HTTP request's headers as Fetch Headers, so a custom header sent by the client transport is readable inside the handler.\",\n./test/e2e/requirements.ts:2897:            'An AuthProvider supplied to StreamableHTTPClientTransport has token() called before each request and the returned token is attached as an Authorization: Bearer header on the HTTP requests.',\n./test/e2e/requirements.ts:2978:            'A sessionId passed to the StreamableHTTPClientTransport constructor is sent as the Mcp-Session-Id header from the first request onwards.',\n./test/e2e/requirements.ts:3039:    'client-auth:no-tokens:no-auth-header': {\n./test/e2e/requirements.ts:3042:            \"When the OAuth provider's tokens() returns undefined the transport sends no Authorization header and the resulting 401 re-enters the auth flow, and a token response without refresh_token leads back to a full authorization-code flow on expiry rather than a refresh attempt.\",\n./test/e2e/requirements.ts:3065:    // SEP-2243 request-metadata headers (protocol revision 2026-07-28)\n./test/e2e/requirements.ts:3066:    'sep-2243:param-header:roundtrip': {\n./test/e2e/requirements.ts:3067:        source: 'https://modelcontextprotocol.io/specification/draft/basic/transports/streamable-http#custom-headers-from-tool-parameters',\n./test/e2e/requirements.ts:3069:            'A tools/call to a tool whose inputSchema declares an x-mcp-header property carries the corresponding Mcp-Param-{Name} HTTP header on the wire, encoded per the SEP-2243 value-encoding rules, and the call completes successfully against a validating server.',\n./test/e2e/requirements.ts:3072:        note: 'Runs on the entryModern arm; the Mcp-Param-{Name} header is asserted on the arm-recorded HTTP request headers and the encoded value is checked against the SEP-2243 codec.'\n./test/e2e/requirements.ts:3074:    'sep-2243:std-header:mismatch-rejected': {\n./test/e2e/requirements.ts:3075:        source: 'https://modelcontextprotocol.io/specification/draft/basic/transports/streamable-http#standard-request-headers',\n./test/e2e/requirements.ts:3077:            'A 2026-07-28 request whose Mcp-Method header disagrees with the JSON-RPC method in the body is rejected by the createMcpHandler entry with HTTP 400 carrying a JSON-RPC error with the SEP-2243 HeaderMismatch code.',\n./test/e2e/requirements.ts:3080:        note: 'Runs on the entryModern arm; the body POSTs a raw envelope-carrying tools/call with an Mcp-Method: tools/list header through wired.fetch and asserts the 400 status and the HeaderMismatch error code on the response bytes.'\n./packages/middleware/node/test/toNodeHandler.test.ts:5: * pass-through, HTTP/2 pseudo-header skipping, and write-backpressure pacing.\n./packages/middleware/node/test/toNodeHandler.test.ts:39:/** SEP-2243 standard headers a conformant client derives from a modern body. */\n./packages/middleware/node/test/toNodeHandler.test.ts:89:        Object.assign(req.headers, bodyDerivedStandardHeaders(parsed));\n./packages/middleware/node/test/toNodeHandler.test.ts:100:        // and hands the parsed object as the third argument; the raw headers\n./packages/middleware/node/test/toNodeHandler.test.ts:104:        req.headers['content-length'] = '999';\n./packages/middleware/node/test/toNodeHandler.test.ts:105:        req.headers['transfer-encoding'] = 'chunked';\n./packages/middleware/node/test/toNodeHandler.test.ts:125:    it('skips HTTP/2 pseudo-headers when copying node request headers', async () => {\n./packages/middleware/node/test/toNodeHandler.test.ts:130:        Object.assign(req.headers, {\n./packages/middleware/node/test/toNodeHandler.test.ts:289:        Object.assign(req.headers, bodyDerivedStandardHeaders(parsed));\n./packages/middleware/node/test/toNodeHandler.test.ts:311:        Object.assign(req.headers, bodyDerivedStandardHeaders(parsed));\n./packages/middleware/node/test/toNodeHandler.test.ts:338:        Object.assign(req.headers, bodyDerivedStandardHeaders(parsed));\n./packages/middleware/node/test/toNodeHandler.test.ts:354:    headers: Record<string, string> | undefined;\n./packages/middleware/node/test/toNodeHandler.test.ts:361:        headers: Record<string, string>;\n./packages/middleware/node/test/toNodeHandler.test.ts:371:        headers: {\n./packages/middleware/node/test/toNodeHandler.test.ts:386:        headers: undefined,\n./packages/middleware/node/test/toNodeHandler.test.ts:387:        writeHead(statusCode: number, headers?: Record<string, string>) {\n./packages/middleware/node/test/toNodeHandler.test.ts:389:            this.headers = headers;\n./packages/server-legacy/src/auth/handlers/register.ts:58:    // Configure CORS to allow any origin, to make accessible to web-based MCP clients\n./test/e2e/scenarios/hosting-fastify.test.ts:37:    const headers = new Headers();\n./test/e2e/scenarios/hosting-fastify.test.ts:38:    for (const [name, value] of Object.entries(request.headers)) {\n./test/e2e/scenarios/hosting-fastify.test.ts:41:        if (typeof value === 'string') headers.set(name, value);\n./test/e2e/scenarios/hosting-fastify.test.ts:42:        else if (Array.isArray(value)) for (const item of value) headers.append(name, item);\n./test/e2e/scenarios/hosting-fastify.test.ts:44:    return new Request(new URL(request.url, `http://${request.headers.host ?? '127.0.0.1'}`), {\n./test/e2e/scenarios/hosting-fastify.test.ts:46:        headers,\n./test/e2e/scenarios/hosting-fastify.test.ts:59:        const sessionId = request.headers['mcp-session-id'];\n./test/e2e/scenarios/hosting-fastify.test.ts:102: * Unl