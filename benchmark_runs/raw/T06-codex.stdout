, vendor: 'mylib', validate: () => ({ value: {} }) } };\n./packages/server/test/server/streamableHttpUnsupportedVersionLiteral.test.ts:51:function postRequest(body: JSONRPCMessage, headers: Record<string, string> = {}): Request {\n./packages/server/test/server/streamableHttpUnsupportedVersionLiteral.test.ts:54:        headers: {\n./packages/server/test/server/streamableHttpUnsupportedVersionLiteral.test.ts:57:            ...headers\n./packages/server/test/server/streamableHttpUnsupportedVersionLiteral.test.ts:66:    return response.headers.get('mcp-session-id') as string;\n./packages/server/test/server/streamableHttpUnsupportedVersionLiteral.test.ts:84:    it('rejects an unsupported MCP-Protocol-Version header with HTTP 400, code -32000, and the sniffed literal substring', async () => {\n./packages/server/test/server/streamableHttpUnsupportedVersionLiteral.test.ts:97:            expect(response.headers.get('content-type')).toContain('application/json');\n./packages/client/test/client/bodyDerivedProbeHeaders.test.ts:2: * Body-derived per-request headers on the streamable HTTP client transport:\n./packages/client/test/client/bodyDerivedProbeHeaders.test.ts:5: * `MCP-Protocol-Version` and `Mcp-Method` headers derive from the message\n./packages/client/test/client/bodyDerivedProbeHeaders.test.ts:7: * those sends, and envelope-less (2025-era) traffic gets no new headers.\n./packages/client/test/client/bodyDerivedProbeHeaders.test.ts:15:describe('body-derived probe headers', () => {\n./packages/client/test/client/bodyDerivedProbeHeaders.test.ts:22:        headers: new Headers({ 'content-type': 'application/json' }),\n./packages/client/test/client/bodyDerivedProbeHeaders.test.ts:53:        return init.headers as Headers;\n./packages/client/test/client/bodyDerivedProbeHeaders.test.ts:56:    it('derives MCP-Protocol-Version and Mcp-Method from the probe message body', async () => {\n./packages/client/test/client/bodyDerivedProbeHeaders.test.ts:63:        const headers = sent