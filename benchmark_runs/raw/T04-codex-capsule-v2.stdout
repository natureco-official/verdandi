ialRequest.headers.get('Authorization')).toBe('Bearer invalid-token');\n+            expect(authProvider.onUnauthorized).toHaveBeenCalledTimes(1);\n+            expect(authProvider.token).toHaveBeenCalledTimes(2);\n+            expect(retryRequest.body).toBe(initialRequest.body);\n+            expect(retryRequest.headers.get('Authorization')).toBe('Bearer refreshed-token');\n+        });\n+\n         it('should throw error when server returns 401 after successful auth', async () => {\n             const message: JSONRPCMessage = {\n                 jsonrpc: '2.0',\n","exit_code":0,"status":"completed"}}
