       return false;\n    30\t        }\n    31\t        throw error;\n    32\t    }\n    33\t}\n    34\t\n    35\tfunction signalProcessGroup(processGroupId: number, signal: NodeJS.Signals): void {\n    36\t    try {\n    37\t        process.kill(-processGroupId, signal);\n    38\t    } catch (error) {\n    39\t        if ((error as NodeJS.ErrnoException).code !== 'ESRCH') {\n    40\t            throw error;\n    41\t        }\n    42\t    }\n    43\t}\n    44\t\n    45\tasync function waitForProcessGroupExit(processGroupId: number, timeoutMs: number): Promise<boolean> {\n    46\t    const deadline = Date.now() + timeoutMs;\n    47\t    while (Date.now() < deadline) {\n    48\t        if (!isProcessGroupRunning(processGroupId)) {\n    49\t            return true;\n    50\t        }\n    51\t        await new Promise(resolve => setTimeout(resolve, 50));\n    52\t    }\n    53\t    return !isProcessGroupRunning(processGroupId);\n    54\t}\n    55\t\n    56\t/**\n    57\t * Terminate Wrangler and every process it spawned (including workerd).\n    58\t *\n    59\t * On POSIX, Wrangler is started as a process-group leader so signalling the negative PID reaches\n    60\t * the whole tree. On Windows, taskkill's /T option provides the equivalent tree termination.\n    61\t */\n    62\tasync function terminateProcessTree(proc: ChildProcess): Promise<void> {\n    63\t    if (proc.pid === undefined) {\n    64\t        return;\n    65\t    }\n    66\t\n    67\t    if (process.platform === 'win32') {\n    68\t        await new Promise<void>(resolve => {\n    69\t            const taskkill = spawn('taskkill', ['/pid', String(proc.pid), '/T', '/F'], { stdio: 'ignore' });\n    70\t            taskkill.once('error', () => resolve());\n    71\t            taskkill.once('close', () => resolve());\n    72\t        });\n    73\t        return;\n    74\t    }\n    75\t\n    76\t    const processGroupId = proc.pid;\n    77\t    if (!isProcessGroupRunning(processGroupId)) {\n    78\t        return;\n    79\t    }\n    80\t\n    81\t    signalProcessGroup(processGroupId, 'SIGTERM');\n    82\t    if (await waitForProcessGroupExit(processGroupId, PROCESS_SHUTDOWN_TIMEOUT_MS)) {\n    83\t        return;\n    84\t    }\n    85\t\n    86\t    signalProcessGroup(processGroupId, 'SIGKILL');\n    87\t    if (!(await waitForProcessGroupExit(processGroupId, PROCESS_SHUTDOWN_TIMEOUT_MS))) {\n    88\t        throw new Error(`Process group ${processGroupId} did not exit after SIGKILL`);\n    89\t    }\n    90\t}\n    91\t\n    92\t/**\n    93\t * Wait until the worker can serve a real MCP `initialize` request.\n    94\t *\n    95\t * Wrangler's \"Ready on …\" stdout line is unreliable: miniflare can print it before the user\n    96\t * worker is actually wired, and subsequent POSTs come back as `500 Network connection lost` or\n    97\t * `ECONNREFUSED`. The only signal we can trust is \"the server returned an MCP-shaped response\n    98\t * to a protocol request\".\n    99\t *\n   100\t * Polls the configured port with an MCP `initialize` POST every {@link READINESS_POLL_INTERVAL_MS}ms\n   101\t * until either a JSON-RPC result body comes back, the wrangler process exits, or\n   102\t * {@link READINESS_TIMEOUT_MS} elapses.\n   103\t */\n   104\tasync function waitForMcpReady(proc: ChildProcess): Promise<void> {\n   105\t    let stderrTail = '';\n   106\t    proc.stderr?.on('data', d => {\n   107\t        stderrTail = (stderrTail + d.toString()).slice(-2048);\n   108\t    });\n   109\t\n   110\t    let processExitedWithCode: number | null = null;\n   111\t    proc.on('exit', code => {\n   112\t        processExitedWithCode = code ?? -1;\n   113\t    });\n   114\t\n   115\t    const deadline = Date.now() + READINESS_TIMEOUT_MS;\n   116\t    let lastFailure = 'no attempts made';\n   117\t\n   118\t    while (Date.now() < deadline) {\n   119\t        if (processExitedWithCode !== null) {\n   120\t            throw new Error(`wrangler dev exited with code ${processExitedWithCode} before becoming ready.\\nstderr tail:\\n${stderrTail}`);\n   121\t        }\n   122\t\n   123\t        try {\n   124\t            const response = await fetch(`http://127.0.0.1:${PORT}/`, {\n   125\t                method: 'POST',\n   126\t                signal: AbortSignal.timeout(READINESS_REQUEST_TIMEOUT_MS),\n   127\t                headers: {\n   128\t                    'Content-Type': 'application/json',\n   129\t                    Accept: 'application/json, text/event-stream'\n   130\t                },\n   131\t                body: JSON.stringify({\n   132\t                    jsonrpc: '2.0',\n   133\t                    id: 'readiness-probe',\n   134\t                    method: 'initialize',\n   135\t                    params: {\n   136\t                        protocolVersion: '2025-06-18',\n   137\t                        capabilities: {},\n   138\t                        clientInfo: { name: 'readiness-probe', version: '0' }\n   139\t                    }\n   140\t                })\n   141\t            });\n   142\t            const body = await response.text();\n   143\t            if (response.ok && body.includes('\"jsonrpc\"') && body.includes('\"result\"')) {\n   144\t                return;\n   145\t            }\n   146\t            lastFailure = `status=${response.status} body=${body.slice(0, 200)}`;\n   147\t        } catch (error) {\n   148\t            lastFailure = (error as { cause?: { code?: string }; message: string }).cause?.code ?? (error as Error).message;\n   149\t        }\n   150\t\n   151\t        await new Promise(resolve => setTimeout(resolve, READINESS_POLL_INTERVAL_MS));\n   152\t    }\n   153\t\n   154\t    throw new Error(\n   155\t        `Worker did not become ready within ${READINESS_TIMEOUT_MS}ms.\\nLast probe: ${lastFailure}\\nstderr tail:\\n${stderrTail}`\n   156\t    );\n   157\t}\n   158\t\n   159\tdescribe('Cloudflare Workers compatibility (no nodejs_compat)', () => {\n   160\t    let tempDir: string | null = null;\n   161\t    let proc: ChildProcess | null = null;\n   162\t\n   163\t    const cleanup = async (): Promise<void> => {\n   164\t        const processToStop = proc;\n   165\t        proc = null;\n   166\t        const directoryToRemove = tempDir;\n   167\t        tempDir = null;\n   168\t\n   169\t        try {\n   170\t            if (processToStop !== null) {\n   171\t                await terminateProcessTree(processToStop);\n   172\t            }\n   173\t        } finally {\n   174\t            if (directoryToRemove !== null) {\n   175\t                try {\n   176\t                    fs.rmSync(directoryToRemove, { recursive: true, force: true });\n   177\t                } catch {\n   178\t                    // The process tree is the critical resource; do not mask a test failure if\n   179\t                    // the temporary directory cannot be removed.\n   180\t                }\n   181\t            }\n   182\t        }\n   183\t    };\n   184\t\n   185\t    beforeAll(async () => {\n   186\t        tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cf-worker-test-'));\n   187\t\n   188\t        try {\n   189\t            // Pack server package\n   190\t            const serverPkgPath = path.resolve(__dirname, '../../../../packages/server');\n   191\t            const packOutput = execSync(`pnpm pack --pack-destination ${tempDir}`, {\n   192\t                cwd: serverPkgPath,\n   193\t                encoding: 'utf8'\n   194\t            });\n   195\t            const tarballName = path.basename(packOutput.trim().split('\\n').pop()!);\n   196\t\n   197\t            // Write package.json\n   198\t            const pkgJson = {\n   199\t                name: 'cf-worker-test',\n   200\t                private: true,\n   201\t                type: 'module',\n   202\t                dependencies: {\n   203\t                    '@modelcontextprotocol/server': `file:./${tarballName}`\n   204\t                },\n   205\t                devDependencies: {\n   206\t                    wrangler: '^4.14.4'\n   207\t                }\n   208\t            };\n   209\t            fs.writeFileSync(path.join(tempDir, 'package.json'), JSON.stringify(pkgJson, null, 2));\n   210\t\n   211\t            // Write wrangler config\n   212\t            const wranglerConfig = {\n   213\t                $schema: 'node_modules/wrangler/config-schema.json',\n   214\t                name: 'cf-worker-test',\n   215\t                main: 'server.ts',\n   216\t                compatibility_date: '2025-01-01'\n   217\t            };\n   218\t            fs.writeFileSync(path.join(tempDir, 'wrangler.jsonc'), JSON.stringify(wranglerConfig, null, 2));\n   219\t\n   220\t            // Write server source\n   221\t            const serverSource = `\n   222\timport { McpServer, WebStandardStreamableHTTPServerTransport } from '@modelcontextprotocol/server';\n   223\t\n   224\tconst server = new McpServer({ name: \"test-server\", version: \"1.0.0\" });\n   225\t\n   226\tserver.registerTool(\"greet\", {\n   227\t    description: \"Greet someone\"\n   228\t}, async (args) => ({\n   229\t    content: [{ type: \"text\", text: \"Hello, \" + (args.name || \"World\") + \"!\" }]\n   230\t}));\n   231\t\n   232\tconst transport = new WebStandardStreamableHTTPServerTransport();\n   233\tawait server.connect(transport);\n   234\t\n   235\texport default {\n   236\t    fetch: (request) => transport.handleRequest(request)\n   237\t};\n   238\t`;\n   239\t            fs.writeFileSync(path.join(tempDir, 'server.ts'), serverSource);\n   240\t\n   241\t            // Install dependencies\n   242\t            execSync('npm install', { cwd: tempDir, stdio: 'pipe', timeout: 60_000 });\n   243\t\n   244\t            // Invoke Wrangler's JS entry point directly instead of spawning it through a shell.\n   245\t            // On POSIX, detached makes it the leader of a process group that cleanup can terminate\n   246\t            // as a unit, including Miniflare and workerd.\n   247\t            const wranglerEntryPoint = path.join(tempDir, 'node_modules', 'wrangler', 'bin', 'wrangler.js');\n   248\t            proc = spawn(process.execPath, [wranglerEntryPoint, 'dev', '--local', '--port', String(PORT)], {\n   249\t                cwd: tempDir,\n   250\t                detached: process.platform !== 'win32',\n   251\t                stdio: 'pipe'\n   252\t            });\n   253\t\n   254\t            await waitForMcpReady(proc);\n   255\t        } catch (error) {\n   256\t            await cleanup();\n   257\t            throw error;\n   258\t        }\n   259\t    }, 120_000);\n   260\t\n   261\t    afterAll(async () => {\n   262\t        await cleanup();\n   263\t    });\n   264\t\n   265\t    it('should handle MCP requests', async () => {\n   266\t        const client = new Client({ name: 'test-client', version: '1.0.0' });\n   267\t        const transport = new StreamableHTTPClientTransport(new URL(`http://127.0.0.1:${PORT}/`));\n   268\t        await client.connect(transport);\n   269\t\n   270\t        const result = await client.callTool({ name: 'greet', arguments: { name: 'World' } });\n   271\t        expect(result.content).toEqual([{ type: 'text', text: 'Hello, World!' }]);\n   272\t\n   273\t        await client.close();\n   274\t    }, 30_000);\n   275\t});\n","exit_code":0,"status":"completed"}}
