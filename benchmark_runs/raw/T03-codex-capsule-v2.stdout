{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc 'git diff -- test/integration/test/server/cloudflareWorkers.test.ts && git diff --check && git status --short'","aggregated_output":"diff --git a/test/integration/test/server/cloudflareWorkers.test.ts b/test/integration/test/server/cloudflareWorkers.test.ts\nindex c32f1dc..5a24ffd 100644\n--- a/test/integration/test/server/cloudflareWorkers.test.ts\n+++ b/test/integration/test/server/cloudflareWorkers.test.ts\n@@ -8,15 +8,85 @@\n import type { ChildProcess } from 'node:child_process';\n import { execSync, spawn } from 'node:child_process';\n import * as fs from 'node:fs';\n+import { createServer } from 'node:net';\n import * as os from 'node:os';\n import path from 'node:path';\n \n import { Client, StreamableHTTPClientTransport } from '@modelcontextprotocol/client';\n import { afterAll, beforeAll, describe, expect, it } from 'vitest';\n \n-const PORT = 8787;\n const READINESS_TIMEOUT_MS = 60_000;\n const READINESS_POLL_INTERVAL_MS = 100;\n+const PROCESS_TERMINATION_TIMEOUT_MS = 5000;\n+\n+async function getAvailablePort(): Promise<number> {\n+    const server = createServer();\n+    await new Promise<void>((resolve, reject) => {\n+        server.once('error', reject);\n+        server.listen(0, '127.0.0.1', resolve);\n+    });\n+\n+    const address = server.address();\n+    if (address === null || typeof address === 'string') {\n+        server.close();\n+        throw new Error('Could not allocate a port for the Cloudflare Workers test');\n+    }\n+\n+    await new Promise<void>((resolve, reject) => server.close(error => (error ? reject(error) : resolve())));\n+    return address.port;\n+}\n+\n+function isProcessGroupRunning(pid: number): boolean {\n+    try {\n+        process.kill(-pid, 0);\n+        return true;\n+    } catch (error) {\n+        if ((error as NodeJS.ErrnoException).code === 'ESRCH') {\n+            return false;\n+        }\n+        throw error;\n+    }\n+}\n+\n+async function waitForProcessGroupExit(pid: number, timeoutMs: number): Promise<boolean> {\n+    const deadline = Date.now() + timeoutMs;\n+    while (Date.now() < deadline) {\n+        if (!isProcessGroupRunning(pid)) {\n+            return true;\n+        }\n+        await new Promise(resolve => setTimeout(resolve, 50));\n+    }\n+    return !isProcessGroupRunning(pid);\n+}\n+\n+/** Stop wrangler and every descendant it created, including workerd. */\n+async function terminateProcessTree(proc: ChildProcess): Promise<void> {\n+    const pid = proc.pid;\n+    if (pid === undefined) {\n+        return;\n+    }\n+\n+    if (process.platform === 'win32') {\n+        await new Promise<void>(resolve => {\n+            const taskkill = spawn('taskkill', ['/pid', String(pid), '/t', '/f'], { stdio: 'ignore' });\n+            taskkill.once('error', () => resolve());\n+            taskkill.once('close', () => resolve());\n+        });\n+        return;\n+    }\n+\n+    if (!isProcessGroupRunning(pid)) {\n+        return;\n+    }\n+\n+    process.kill(-pid, 'SIGTERM');\n+    if (await waitForProcessGroupExit(pid, PROCESS_TERMINATION_TIMEOUT_MS)) {\n+        return;\n+    }\n+\n+    process.kill(-pid, 'SIGKILL');\n+    await waitForProcessGroupExit(pid, PROCESS_TERMINATION_TIMEOUT_MS);\n+}\n \n /**\n  * Wait until the worker can serve a real MCP `initialize` request.\n@@ -30,27 +100,34 @@ const READINESS_POLL_INTERVAL_MS = 100;\n  * until either a JSON-RPC result body comes back, the wrangler process exits, or\n  * {@link READINESS_TIMEOUT_MS} elapses.\n  */\n-async function waitForMcpReady(proc: ChildProcess): Promise<void> {\n+async function waitForMcpReady(proc: ChildProcess, port: number): Promise<void> {\n     let stderrTail = '';\n     proc.stderr?.on('data', d => {\n         stderrTail = (stderrTail + d.toString()).slice(-2048);\n     });\n \n     let processExitedWithCode: number | null = null;\n+    let processError: Error | null = null;\n     proc.on('exit', code => {\n         processExitedWithCode = code ?? -1;\n     });\n+    proc.on('error', error => {\n+        processError = error;\n+    });\n \n     const deadline = Date.now() + READINESS_TIMEOUT_MS;\n     let lastFailure = 'no attempts made';\n \n     while (Date.now() < deadline) {\n+        if (processError !== null) {\n+            throw new Error(`wrangler dev failed to start: ${processError.message}`, { cause: processError });\n+        }\n         if (processExitedWithCode !== null) {\n             throw new Error(`wrangler dev exited with code ${processExitedWithCode} before becoming ready.\\nstderr tail:\\n${stderrTail}`);\n         }\n \n         try {\n-            const response = await fetch(`http://127.0.0.1:${PORT}/`, {\n+            const response = await fetch(`http://127.0.0.1:${port}/`, {\n                 method: 'POST',\n                 headers: {\n                     'Content-Type': 'application/json',\n@@ -85,44 +162,66 @@ async function waitForMcpReady(proc: ChildProcess): Promise<void> {\n }\n \n describe('Cloudflare Workers compatibility (no nodejs_compat)', () => {\n-    let cleanup: (() => Promise<void>) | null = null;\n+    let port: number;\n+    let proc: ChildProcess | null = null;\n+    let tempDir: string | null = null;\n \n-    beforeAll(async () => {\n-        const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cf-worker-test-'));\n+    const cleanup = async (): Promise<void> => {\n+        const processToClose = proc;\n+        proc = null;\n+        if (processToClose !== null) {\n+            await terminateProcessTree(processToClose);\n+        }\n \n-        // Pack server package\n-        const serverPkgPath = path.resolve(__dirname, '../../../../packages/server');\n-        const packOutput = execSync(`pnpm pack --pack-destination ${tempDir}`, {\n-            cwd: serverPkgPath,\n-            encoding: 'utf8'\n-        });\n-        const tarballName = path.basename(packOutput.trim().split('\\n').pop()!);\n-\n-        // Write package.json\n-        const pkgJson = {\n-            name: 'cf-worker-test',\n-            private: true,\n-            type: 'module',\n-            dependencies: {\n-                '@modelcontextprotocol/server': `file:./${tarballName}`\n-            },\n-            devDependencies: {\n-                wrangler: '^4.14.4'\n+        const directoryToRemove = tempDir;\n+        tempDir = null;\n+        if (directoryToRemove !== null) {\n+            try {\n+                fs.rmSync(directoryToRemove, { recursive: true, force: true });\n+            } catch {\n+                // Ignore cleanup errors\n             }\n-        };\n-        fs.writeFileSync(path.join(tempDir, 'package.json'), JSON.stringify(pkgJson, null, 2));\n-\n-        // Write wrangler config\n-        const wranglerConfig = {\n-            $schema: 'node_modules/wrangler/config-schema.json',\n-            name: 'cf-worker-test',\n-            main: 'server.ts',\n-            compatibility_date: '2025-01-01'\n-        };\n-        fs.writeFileSync(path.join(tempDir, 'wrangler.jsonc'), JSON.stringify(wranglerConfig, null, 2));\n-\n-        // Write server source\n-        const serverSource = `\n+        }\n+    };\n+\n+    beforeAll(async () => {\n+        port = await getAvailablePort();\n+        tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cf-worker-test-'));\n+\n+        try {\n+            // Pack server package\n+            const serverPkgPath = path.resolve(__dirname, '../../../../packages/server');\n+            const packOutput = execSync(`pnpm pack --pack-destination ${tempDir}`, {\n+                cwd: serverPkgPath,\n+                encoding: 'utf8'\n+            });\n+            const tarballName = path.basename(packOutput.trim().split('\\n').pop()!);\n+\n+            // Write package.json\n+            const pkgJson = {\n+                name: 'cf-worker-test',\n+                private: true,\n+                type: 'module',\n+                dependencies: {\n+                    '@modelcontextprotocol/server': `file:./${tarballName}`\n+                },\n+                devDependencies: {\n+                    wrangler: '^4.14.4'\n+                }\n+            };\n+            fs.writeFileSync(path.join(tempDir, 'package.json'), JSON.stringify(pkgJson, null, 2));\n+\n+            // Write wrangler config\n+            const wranglerConfig = {\n+                $schema: 'node_modules/wrangler/config-schema.json',\n+                name: 'cf-worker-test',\n+                main: 'server.ts',\n+                compatibility_date: '2025-01-01'\n+            };\n+            fs.writeFileSync(path.join(tempDir, 'wrangler.jsonc'), JSON.stringify(wranglerConfig, null, 2));\n+\n+            // Write server source\n+            const serverSource = `\n import { McpServer, WebStandardStreamableHTTPServerTransport } from '@modelcontextprotocol/server';\n \n const server = new McpServer({ name: \"test-server\", version: \"1.0.0\" });\n@@ -140,47 +239,34 @@ export default {\n     fetch: (request) => transport.handleRequest(request)\n };\n `;\n-        fs.writeFileSync(path.join(tempDir, 'server.ts'), serverSource);\n+            fs.writeFileSync(path.join(tempDir, 'server.ts'), serverSource);\n \n-        // Install dependencies\n-        execSync('npm install', { cwd: tempDir, stdio: 'pipe', timeout: 60_000 });\n+            // Install dependencies\n+            execSync('npm install', { cwd: tempDir, stdio: 'pipe', timeout: 60_000 });\n \n-        // Start wrangler dev server. Readiness is determined by probing the MCP endpoint, not by\n-        // parsing wrangler's stdout — see waitForMcpReady for the reasoning.\n-        const proc = spawn('npx', ['wrangler', 'dev', '--local', '--port', String(PORT)], {\n-            cwd: tempDir,\n-            shell: true,\n-            stdio: 'pipe'\n-        });\n+            // Start wrangler dev server. Readiness is determined by probing the MCP endpoint, not by\n+            // parsing wrangler's stdout — see waitForMcpReady for the reasoning.\n+            const npxCommand = process.platform === 'win32' ? 'npx.cmd' : 'npx';\n+            proc = spawn(npxCommand, ['wrangler', 'dev', '--local', '--port', String(port)], {\n+                cwd: tempDir,\n+                detached: process.platform !== 'win32',\n+                stdio: 'pipe'\n+            });\n \n-        try {\n-            await waitForMcpReady(proc);\n+            await waitForMcpReady(proc, port);\n         } catch (error) {\n-            proc.kill('SIGTERM');\n+            await cleanup();\n             throw error;\n         }\n-\n-        cleanup = async () => {\n-            proc.kill('SIGTERM');\n-            await new Promise<void>(resolve => {\n-                proc.on('close', () => resolve());\n-                setTimeout(resolve, 5000);\n-            });\n-            try {\n-                fs.rmSync(tempDir, { recursive: true, force: true });\n-            } catch {\n-                // Ignore cleanup errors\n-            }\n-        };\n     }, 120_000);\n \n     afterAll(async () => {\n-        await cleanup?.();\n+        await cleanup();\n     });\n \n     it('should handle MCP requests', async () => {\n         const client = new Client({ name: 'test-client', version: '1.0.0' });\n-        const transport = new StreamableHTTPClientTransport(new URL(`http://127.0.0.1:${PORT}/`));\n+        const transport = new StreamableHTTPClientTransport(new URL(`http://127.0.0.1:${port}/`));\n         await client.connect(transport);\n \n         const result = await client.callTool({ name: 'greet', arguments: { name: 'World' } });\n M test/integration/test/server/cloudflareWorkers.test.ts\n","exit_code":0,"status":"completed"}}
