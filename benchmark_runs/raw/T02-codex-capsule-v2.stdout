{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"git diff -- test/integration/test/server/cloudflareWorkers.test.ts; sed -n '20,70p' test/integration/test/server/cloudflareWorkers.test.ts; sed -n '200,270p' test/integration/test/server/cloudflareWorkers.test.ts\"","aggregated_output":"diff --git a/test/integration/test/server/cloudflareWorkers.test.ts b/test/integration/test/server/cloudflareWorkers.test.ts\nindex 863b534..7d8865d 100644\n--- a/test/integration/test/server/cloudflareWorkers.test.ts\n+++ b/test/integration/test/server/cloudflareWorkers.test.ts\n@@ -27,6 +27,15 @@ const SHUTDOWN_GRACE_MS = 5000;\n  */\n const SERVER_VERSION_NONCE = randomUUID();\n \n+const PACKAGE_REQUIRE = createRequire(import.meta.url);\n+\n+/** Resolve a workspace-pinned package binary without relying on shell PATH lookup. */\n+function resolvePackageBin(packageName: string, binName: string): string {\n+    const pkgPath = PACKAGE_REQUIRE.resolve(`${packageName}/package.json`);\n+    const bin = (JSON.parse(fs.readFileSync(pkgPath, 'utf8')) as { bin: Record<string, string> }).bin[binName];\n+    return path.resolve(path.dirname(pkgPath), bin);\n+}\n+\n /**\n  * The workspace's own wrangler installation (pinned by pnpm-lock). Running it directly —\n  * instead of `npm install`-ing wrangler into the temp project and going through `npx` —\n@@ -35,11 +44,11 @@ const SERVER_VERSION_NONCE = randomUUID();\n  * `bin` field rather than a hardcoded internal file path.\n  */\n const WRANGLER_BIN = (() => {\n-    const pkgPath = createRequire(import.meta.url).resolve('wrangler/package.json');\n-    const bin = (JSON.parse(fs.readFileSync(pkgPath, 'utf8')) as { bin: Record<string, string> }).bin.wrangler;\n-    return path.resolve(path.dirname(pkgPath), bin);\n+    return resolvePackageBin('wrangler', 'wrangler');\n })();\n \n+const TSDOWN_BIN = resolvePackageBin('tsdown', 'tsdown');\n+\n /** Ask the kernel for a currently-free port instead of hardcoding one. */\n async function getFreePort(): Promise<number> {\n     return new Promise((resolve, reject) => {\n@@ -212,10 +221,31 @@ describe('Cloudflare Workers compatibility (no nodejs_compat)', () => {\n         };\n \n         try {\n-            // Pack server package\n+            // Build and pack the server from an isolated temporary workspace. Running\n+            // `pnpm pack` in the real package invokes its prepack script, whose clean build\n+            // rewrites packages/server/dist and can race with other tests. The staged package\n+            // keeps the real manifest and installed dependency links so pnpm can resolve\n+            // workspace/catalog versions, while both build output and packing stay temporary.\n             const serverPkgPath = path.resolve(__dirname, '../../../../packages/server');\n-            const packOutput = execSync(`pnpm pack --pack-destination \"${tempDir}\"`, {\n+            const packageWorkspacePath = path.join(tempDir, 'package-workspace');\n+            const stagedServerPkgPath = path.join(packageWorkspacePath, 'packages/server');\n+            const stagedDistPath = path.join(stagedServerPkgPath, 'dist');\n+            fs.mkdirSync(stagedServerPkgPath, { recursive: true });\n+            fs.copyFileSync(path.resolve(serverPkgPath, '../../pnpm-workspace.yaml'), path.join(packageWorkspacePath, 'pnpm-workspace.yaml'));\n+            fs.copyFileSync(path.join(serverPkgPath, 'package.json'), path.join(stagedServerPkgPath, 'package.json'));\n+            fs.symlinkSync(\n+                path.join(serverPkgPath, 'node_modules'),\n+                path.join(stagedServerPkgPath, 'node_modules'),\n+                process.platform === 'win32' ? 'junction' : 'dir'\n+            );\n+\n+            execSync(`\"${process.execPath}\" \"${TSDOWN_BIN}\" --out-dir \"${stagedDistPath}\"`, {\n                 cwd: serverPkgPath,\n+                stdio: 'pipe',\n+                timeout: 60_000\n+            });\n+            const packOutput = execSync(`pnpm --config.ignore-scripts=true pack --pack-destination \"${tempDir}\"`, {\n+                cwd: stagedServerPkgPath,\n                 encoding: 'utf8',\n                 timeout: 60_000\n             });\nconst READINESS_TIMEOUT_MS = 60_000;\nconst READINESS_POLL_INTERVAL_MS = 100;\nconst SHUTDOWN_GRACE_MS = 5000;\n\n/**\n * Embedded in the worker's `serverInfo.version` and asserted by the readiness probe, so a\n * leftover server from an earlier run can never satisfy the probe for this run.\n */\nconst SERVER_VERSION_NONCE = randomUUID();\n\nconst PACKAGE_REQUIRE = createRequire(import.meta.url);\n\n/** Resolve a workspace-pinned package binary without relying on shell PATH lookup. */\nfunction resolvePackageBin(packageName: string, binName: string): string {\n    const pkgPath = PACKAGE_REQUIRE.resolve(`${packageName}/package.json`);\n    const bin = (JSON.parse(fs.readFileSync(pkgPath, 'utf8')) as { bin: Record<string, string> }).bin[binName];\n    return path.resolve(path.dirname(pkgPath), bin);\n}\n\n/**\n * The workspace's own wrangler installation (pinned by pnpm-lock). Running it directly —\n * instead of `npm install`-ing wrangler into the temp project and going through `npx` —\n * keeps the wrangler version deterministic, avoids a ~90MB download per test run, and\n * removes two shell layers from the spawned process tree. Resolved through the package's\n * `bin` field rather than a hardcoded internal file path.\n */\nconst WRANGLER_BIN = (() => {\n    return resolvePackageBin('wrangler', 'wrangler');\n})();\n\nconst TSDOWN_BIN = resolvePackageBin('tsdown', 'tsdown');\n\n/** Ask the kernel for a currently-free port instead of hardcoding one. */\nasync function getFreePort(): Promise<number> {\n    return new Promise((resolve, reject) => {\n        const probe = net.createServer();\n        probe.unref();\n        probe.on('error', reject);\n        probe.listen(0, '127.0.0.1', () => {\n            const { port } = probe.address() as net.AddressInfo;\n            probe.close(() => resolve(port));\n        });\n    });\n}\n\n/**\n * Kill the whole `wrangler dev` process tree.\n *\n * `wrangler dev` fans out into several processes (wrangler bin shim → wrangler CLI →\n * esbuild service + two workerd instances), and non-interactive wrangler installs no\n * SIGTERM handler that would dispose them. Signalling just `proc.pid` kills the top of\n\n    beforeAll(async () => {\n        const tempDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cf-worker-test-'));\n        let proc: ChildProcess | null = null;\n        let orphanGuard: (() => void) | null = null;\n\n        // Registered before anything can fail (including a vitest hook timeout, which skips\n        // the catch below but still runs afterAll): kill the process tree, then the temp dir.\n        cleanup = async () => {\n            if (orphanGuard) {\n                process.removeListener('exit', orphanGuard);\n                orphanGuard = null;\n            }\n            if (proc) {\n                await killWranglerTree(proc);\n            }\n            try {\n                fs.rmSync(tempDir, { recursive: true, force: true, maxRetries: 5, retryDelay: 100 });\n            } catch {\n                // Ignore cleanup errors\n            }\n        };\n\n        try {\n            // Build and pack the server from an isolated temporary workspace. Running\n            // `pnpm pack` in the real package invokes its prepack script, whose clean build\n            // rewrites packages/server/dist and can race with other tests. The staged package\n            // keeps the real manifest and installed dependency links so pnpm can resolve\n            // workspace/catalog versions, while both build output and packing stay temporary.\n            const serverPkgPath = path.resolve(__dirname, '../../../../packages/server');\n            const packageWorkspacePath = path.join(tempDir, 'package-workspace');\n            const stagedServerPkgPath = path.join(packageWorkspacePath, 'packages/server');\n            const stagedDistPath = path.join(stagedServerPkgPath, 'dist');\n            fs.mkdirSync(stagedServerPkgPath, { recursive: true });\n            fs.copyFileSync(path.resolve(serverPkgPath, '../../pnpm-workspace.yaml'), path.join(packageWorkspacePath, 'pnpm-workspace.yaml'));\n            fs.copyFileSync(path.join(serverPkgPath, 'package.json'), path.join(stagedServerPkgPath, 'package.json'));\n            fs.symlinkSync(\n                path.join(serverPkgPath, 'node_modules'),\n                path.join(stagedServerPkgPath, 'node_modules'),\n                process.platform === 'win32' ? 'junction' : 'dir'\n            );\n\n            execSync(`\"${process.execPath}\" \"${TSDOWN_BIN}\" --out-dir \"${stagedDistPath}\"`, {\n                cwd: serverPkgPath,\n                stdio: 'pipe',\n                timeout: 60_000\n            });\n            const packOutput = execSync(`pnpm --config.ignore-scripts=true pack --pack-destination \"${tempDir}\"`, {\n                cwd: stagedServerPkgPath,\n                encoding: 'utf8',\n                timeout: 60_000\n            });\n            const tarballName = path.basename(packOutput.trim().split('\\n').pop()!);\n\n            // Write package.json\n            const pkgJson = {\n                name: 'cf-worker-test',\n                private: true,\n                type: 'module',\n                dependencies: {\n                    '@modelcontextprotocol/server': `file:./${tarballName}`\n                }\n            };\n            fs.writeFileSync(path.join(tempDir, 'package.json'), JSON.stringify(pkgJson, null, 2));\n\n            // Write wrangler config\n            const wranglerConfig = {\n                name: 'cf-worker-test',\n                main: 'server.ts',\n                compatibility_date: '2025-01-01'\n            };\n","exit_code":0,"status":"completed"}}
