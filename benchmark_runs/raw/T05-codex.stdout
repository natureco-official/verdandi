es/read': { ttlMs: 1.5 } } })).toThrowError(\n./packages/server/test/server/cacheHints.test.ts:139:        const mcpServer = buildMcpServer({ cacheHints: { 'resources/read': { ttlMs: 1_000 } } });\n./packages/server/test/server/cacheHints.test.ts:143:        const result = await modernResult(mcpServer, modernRequest('resources/read', { uri: 'test://hinted' }));\n./packages/server/test/server/cacheHints.test.ts:148:        const mcpServer = buildMcpServer({ cacheHints: { 'resources/read': { ttlMs: 1_000 } } });\n./packages/server/test/server/cacheHints.test.ts:152:        const result = await modernResult(mcpServer, modernRequest('resources/read', { uri: 'test://plain' }));\n./packages/server/test/server/cacheHints.test.ts:157:        const mcpServer = buildMcpServer({ cacheHints: { 'resources/read': { ttlMs: 1_000 } } });\n./packages/server/test/server/cacheHints.test.ts:161:        const result = await modernResult(mcpServer, modernRequest('resources/read', { uri: 'test://scoped' }));\n./packages/server/test/server/cacheHints.test.ts:166:        const mcpServer = buildMcpServer({ cacheHints: { 'resources/read': { cacheScope: 'public' } } });\n./packages/server/test/server/cacheHints.test.ts:170:        const result = await modernResult(mcpServer, modernRequest('resources/read', { uri: 'test://timed' }));\n./packages/server/test/server/cacheHints.test.ts:175:        const mcpServer = buildMcpServer({ cacheHints: { 'resources/read': { ttlMs: 1_000, cacheScope: 'private' } } });\n./packages/server/test/server/cacheHints.test.ts:179:        const result = await modernResult(mcpServer, modernRequest('resources/read', { uri: 'test://full' }));\n./packages/server/test/server/cacheHints.test.ts:184:        const mcpServer = buildMcpServer({ cacheHints: { 'resources/read': { ttlMs: 1_000 } } });\n./packages/server/test/server/cacheHints.test.ts:188:        const result = await modernResult(mcpServer, modernRequest('resources/read', { uri: 'test://partial' }));\n./packages/server/test/server/cacheHints.test.ts:192:    it('fills the defaults for resources/read when neither configured author provides a hint', async () => {\n./packages/server/test/server/cacheHints.test.ts:197:        const result = await modernResult(mcpServer, modernRequest('resources/read', { uri: 'test://bare' }));\n./packages/server/test/server/cacheHints.test.ts:202:        const mcpServer = buildMcpServer({ cacheHints: { 'resources/read': { ttlMs: 1_000 } } });\n./packages/server/test/server/cacheHints.test.ts:208:        const result = await modernResult(mcpServer, modernRequest('resources/read', { uri: 'test://authored' }));\n./packages/server/test/server/cacheHints.test.ts:218:        const result = await modernResult(mcpServer, modernRequest('resources/read', { uri: 'test://invalid' }));\n./packages/server/test/server/cacheHints.test.ts:251:            cacheHints: { 'tools/list': { ttlMs: 60_000, cacheScope: 'public' }, 'resources/read': { ttlMs: 1_000 } }\n./packages/server/test/server/cacheHints.test.ts:259:            { jsonrpc: '2.0', id: 2, method: 'resources/read', params: { uri: 'test://hinted' } } as JSONRPCMessage,\n./packages/server/test/server/inputRequired.test.ts:4: * - a handler for tools/call, prompts/get, or resources/read returns an\n./packages/server/test/server/inputRequired.test.ts:179:    it('prompts/get and resources/read handlers can return input_required (no catch-all rewraps it)', async () => {\n./packages/server/test/server/inputRequired.test.ts:200:                method: 'resources/read',\n./packages/core-internal/src/shared/resultCacheHints.ts:50:    'resources/read',\n./packages/server/test/server/createMcpHandler.test.ts:54:    const name = b.method === 'resources/read' ? b.params.uri : b.params.name;\n./packages/server/test/server/createMcpHandler.test.ts:240:        // carries no per-request envelope: invalid params naming what is missing,\n./packages/server/test/server/createMcpHandler.test.ts:302:    it('rejects a malformed envelope behind a present claim with invalid params naming the offending key', async () => {\n./packages/server/test/server/legacyInputRequiredShim.test.ts:22: *   prompts/get and resources/read → JSON-RPC errors;\n./packages/server/test/server/legacyInputRequiredShim.test.ts:326:        server.setRequestHandler('resources/read', async () =>\n./packages/server/test/server/legacyInputRequiredShim.test.ts:340:        const answer = await wire.request({ jsonrpc: '2.0', id: 2, method: 'resources/read', params: { uri: 'res://x' } });\n./packages/server/test/server/eraParityErrorShapes.test.ts:244:        // Handler-level invalid params stays in-band on both legs.\n./packages/core-internal/test/corpus/fixtures/2025-11-25/ReadResourceRequest/read-resource.json:2:    \"method\": \"resources/read\",\n./packages/client/src/client/streamableHttp.ts:465:        // `params.uri` (resources/read). The value is run through the same\n./packages/client/src/client/streamableHttp.ts:475:            message.method === 'resources/read'\n./packages/client/CHANGELOG.md:29:    **Behavior change (every era):** output-schema validator compilation is now lazy — validators are compiled on the first `callTool()` against the cached `tools/list` entry, not eagerly inside `listTools()`. `listTools()` no longer throws on an uncompilable `outputSchema` (every tool stays listed; the compile failure is captured per-tool); calling `callTool()` on the affected tool throws `ProtocolError(InvalidParams, \"Tool 'X' has an invalid outputSchema: …\")` before the request is sent — output-schema validation is never silently skipped. A pluggable `jsonSchemaValidator` provider therefore observes compilation at `callTool` time, not `listTools` time. The legacy-era `listTools()` path is unchanged at the wire level but is observably different at the validator-lifecycle level.\n./packages/client/CHANGELOG.md:67:    Entries are automatically scoped by connected-server identity (derived from `serverInfo` after connect, encoded collision-free via `JSON.stringify`); `ClientOptions.cachePartition` is the opaque per-principal slot for `'private'`-scoped entries — set it to your principal identifier (e.g. the auth subject) when one `responseCacheStore` backs several principals. With the default `''` every entry lives at the connected server's shared partition (the safe single-tenant posture). `ClientOptions.defaultCacheTtlMs` (default `0`) supplies the TTL when a result lacks one (e.g. a legacy-era response); the server-supplied `ttlMs` is clamped at 24 h (`MAX_CACHE_TTL_MS`). The list verbs always store the aggregate (so `callTool`'s mirroring/output-validation index keeps working at any TTL); `readResource` stores only when the resolved TTL is positive. `notifications/resources/updated` evicts the cached `resources/read` body for that URI. `ResponseCacheStore` gained `delete(key)`; `InMemoryResponseCacheStore` is now bounded (`{ maxEntries }`, default 512, oldest-first eviction). New exports: `CacheMode`, `CacheableRequestOptions`, `InMemoryResponseCacheStoreOptions`, `MAX_CACHE_TTL_MS`.\n./packages/client/CHANGELOG.md:84:  client, an `input_required` answer to `tools/call`, `prompts/get`, or `resources/read` on a 2026-07-28 connection is now fulfilled automatically by default: the embedded requests are dispatched to the client's already-registered elicitation/sampling/roots handlers, and the\n./packages/client/CHANGELOG.md:90:- [#2286](https://github.com/modelcontextprotocol/typescript-sdk/pull/2286) [`1823aae`](https://github.com/modelcontextprotocol/typescript-sdk/commit/1823aae891837ebb5e3db885ec635f9efefd5771) Thanks [@felixweinberger](https://github.com/felixweinberger)! - `resources/read` for an unknown URI now answers with JSON-RPC error code `-32602`\n./packages/client/CHANGELOG.md:91:  (Invalid Params) on every protocol revision, with `error.data.uri` echoing the\n./packages/client/CHANGELOG.md:111:    The Streamable HTTP transport now emits the `Mcp-Name` standard header on