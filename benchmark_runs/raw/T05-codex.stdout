ourceResultSchema,\n./packages/core-internal/src/types/types.ts:364:export type ReadResourceRequestParams = Infer<typeof ReadResourceRequestParamsSchema>;\n./packages/core-internal/src/types/types.ts:365:export type ReadResourceRequest = Infer<typeof ReadResourceRequestSchema>;\n./packages/core-internal/src/types/types.ts:366:export type ReadResourceResult = StripWireOnly<Infer<typeof ReadResourceResultSchema>>;\n./packages/core-internal/src/types/types.ts:553: * tool parameters, resource URIs, or configuration.\n./packages/core-internal/src/types/types.ts:559: * tool parameters, resource URIs, or configuration.\n./packages/core-internal/src/types/types.ts:565: * tool parameters, resource URIs, or configuration.\n./packages/core-internal/src/types/types.ts:571: * tool parameters, resource URIs, or configuration.\n./packages/core-internal/src/types/types.ts:580: * `prompts/get`, `resources/read`) returns an input-required result carrying\n./packages/core-internal/src/types/types.ts:620: * (`tools/call`, `prompts/get`, `resources/read`) returns to request more\n./packages/core-internal/src/types/types.ts:689:    'resources/read': ReadResourceResult;\n./packages/core-internal/src/types/types.ts:708: * `prompts/get`, `resources/read`) additionally accept an\n./packages/core-internal/src/types/types.ts:716:    [M in keyof ResultTypeMap]: M extends 'tools/call' | 'prompts/get' | 'resources/read'\n./packages/core-internal/src/types/types.ts:769:export interface InvalidParamsError extends JSONRPCErrorObject {\n./packages/core-internal/test/types/registryPins.test.ts:66:    ReadResourceRequestSchema,\n./packages/core-internal/test/types/registryPins.test.ts:67:    ReadResourceResultSchema,\n./packages/core-internal/test/types/registryPins.test.ts:88:    'resources/read': ReadResourceRequestSchema,\n./packages/core-internal/test/types/registryPins.test.ts:130:    'resources/read': ReadResourceResultSchema,\n./packages/core-internal/test/types/wireOnlyHiding.test.ts:41:    Rea