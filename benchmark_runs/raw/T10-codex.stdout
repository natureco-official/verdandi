ckages/server/test/server/streamableHttp.test.ts:937:                { description: 'closeSSE, gate, then return', inputSchema: z.object({}) },\npackages/server/test/server/streamableHttp.test.ts:939:                    ctx.http?.closeSSE?.();\npackages/server/test/server/streamableHttp.test.ts:1008:            await reconnect2.body?.cancel();\npackages/server/test/server/streamableHttp.test.ts:1060:            await reader.cancel();\npackages/server/test/server/streamableHttp.test.ts:1197:            // ReadableStream cancel callback drops the _streamMapping entry).\npackages/server/test/server/streamableHttp.test.ts:1198:            await response.body?.cancel();\npackages/server/test/server/perRequestStreaming.test.ts:227:    it('cancelling the SSE stream aborts the in-flight handler', async () => {\npackages/server/test/server/perRequestStreaming.test.ts:229:        let abortObserved!: () => void;\npackages/server/test/server/perRequestStreaming.test.ts:230:        const aborted = new Promise<void>(resolve => {\npackages/server/test/server/perRequestStreaming.test.ts:231:            abortObserved = resolve;\npackages/server/test/server/perRequestStreaming.test.ts:235:            ctx.mcpReq.signal.addEventListener('abort', () => abortObserved(), { once: true });\npackages/server/test/server/perRequestStreaming.test.ts:237:            await aborted;\npackages/server/test/server/perRequestStreaming.test.ts:246:        // exchange down and aborts the handler's signal.\npackages/server/test/server/perRequestStreaming.test.ts:247:        await reader.cancel();\npackages/server/test/server/perRequestStreaming.test.ts:248:        await aborted;\npackages/server/test/server/perRequestStreaming.test.ts:249:        expect(observedSignal?.aborted).toBe(true);\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"agent_message","text":"İki akışın da SSE yazma altyapısı mevcut; per-request tarafında manuel comment-frame metodu da var, fakat periyodik zamanlayıcı ve ortak transport yaşam döngüsü entegrasyonu eksik. Şimdi API seçeneğinin adını/varsayılanını repo sözleşmeleriyle eşleştirip kapanış noktalarını tek tek bağlıyorum."}}
