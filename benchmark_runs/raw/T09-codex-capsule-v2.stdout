region', 'x-mcp-header'], 'Region');\n     });\n \ndiff --git a/packages/client/test/client/responseCache.test.ts b/packages/client/test/client/responseCache.test.ts\nindex 5006f38..69007e0 100644\n--- a/packages/client/test/client/responseCache.test.ts\n+++ b/packages/client/test/client/responseCache.test.ts\n@@ -13,7 +13,12 @@ import { describe, expect, it } from 'vitest';\n \n import { Client } from '../../src/client/client';\n import type { CacheEntry, ResponseCacheStore } from '../../src/client/responseCache';\n-import { ClientResponseCache, InMemoryResponseCacheStore } from '../../src/client/responseCache';\n+import {\n+    ClientResponseCache,\n+    deserializeCacheDocument,\n+    InMemoryResponseCacheStore,\n+    serializeCacheDocument\n+} from '../../src/client/responseCache';\n \n const MODERN = '2026-07-28';\n \n@@ -149,6 +154,17 @@ describe('InMemoryResponseCacheStore', () => {\n });\n \n describe('ClientResponseCache', () => {\n+    it('cache document codec round-trips JSON values into detached protocol documents', () => {\n+        const runtime = { tools: [{ ...TOOL_A }], omitted: undefined };\n+        const document = serializeCacheDocument(runtime);\n+\n+        expect(typeof document).toBe('string');\n+        const decoded = deserializeCacheDocument(document) as { tools: Tool[] };\n+        expect(decoded).toEqual({ tools: [TOOL_A] });\n+        expect(decoded).not.toBe(runtime);\n+        expect(decoded.tools).not.toBe(runtime.tools);\n+    });\n+\n     it('write skips when the captured generation moved (list_changed-during-walk guard)', async () => {\n         const store = new InMemoryResponseCacheStore();\n         const cache = new ClientResponseCache(store, false);\n@@ -194,12 +210,11 @@ describe('ClientResponseCache', () => {\n         await cache.write('tools/list', value, cache.captureGeneration('tools/list'));\n         // Mutate the caller's reference (the same object _listAllPages returns).\n         value.tools.length = 0;\n-        // The cached entry is a structuredClone, so the store and the\n-        // stamp-memoized index are unaffected.\n-        expect((store.get({ method: 'tools/list', partition: PRE })?.value as { tools: Tool[] }).tools.map(t => t.name)).toEqual([\n-            'a',\n-            'b'\n-        ]);\n+        // The cached entry is a serialized protocol document, so the store\n+        // and the stamp-memoized index are unaffected.\n+        const stored = store.get({ method: 'tools/list', partition: PRE })?.value;\n+        expect(typeof stored).toBe('string');\n+        expect((deserializeCacheDocument(stored) as { tools: Tool[] }).tools.map(t => t.name)).toEqual(['a', 'b']);\n         expect((await cache.toolDefinition('a'))?.name).toBe('a');\n         expect((await cache.toolDefinition('b'))?.name).toBe('b');\n     });\n@@ -426,7 +441,7 @@ describe('Client response-cache substrate', () => {\n         expect(listCount()).toBe(3);\n \n         const entry = store.get({ method: 'tools/list', partition: part() });\n-        expect((entry?.value as { tools: Tool[] }).tools.map(t => t.name)).toEqual(['a', 'b']);\n+        expect((deserializeCacheDocument(entry?.value) as { tools: Tool[] }).tools.map(t => t.name)).toEqual(['a', 'b']);\n     });\n \n     it('the auto-aggregate path threads caller params (e.g. _meta trace context) into every page request', async () => {\n@@ -459,7 +474,7 @@ describe('Client response-cache substrate', () => {\n         // Common previously-harmless caller patterns.\n         result.tools.sort((x, y) => y.name.localeCompare(x.name));\n         result.tools.length = 0;\n-        // ClientResponseCache.write stored a structuredClone, so neither the\n+        // ClientResponseCache.write stored a serialized document, so neither the\n         // backing entry nor the stamp-memoized name → Tool index moved.\n         expect((await toolDef(client, 'a'))?.name).toBe('a');\n         expect((await toolDef(client, 'b'))?.name).toBe('b');\n","exit_code"