ring {\nsrc/client/responseCache.ts:266:export function deserializeCacheDocument(value: unknown): unknown {\nsrc/client/responseCache.ts:549:        value: unknown,\n packages/client/src/client/client.ts               | 13 ++++---\n packages/client/src/client/responseCache.ts        | 45 ++++++++++++++++++----\n .../client/test/client/mcpParamMirroring.test.ts   | 20 +++++++---\n packages/client/test/client/responseCache.test.ts  | 33 +++++++++++-----\n 4 files changed, 82 insertions(+), 29 deletions(-)\ndiff --git a/packages/client/src/client/client.ts b/packages/client/src/client/client.ts\nindex 5028e93..437090c 100644\n--- a/packages/client/src/client/client.ts\n+++ b/packages/client/src/client/client.ts\n@@ -1682,7 +1682,8 @@ export class Client extends Protocol<ClientContext> {\n     /**\n      * The cache-serving front of every cacheable verb (mcp.d's `cachedFetch`\n      * read half): under `cacheMode: 'use'` (the default), a held entry whose\n-     * `expiresAt` is in the future is returned as a `structuredClone` and the\n+     * `expiresAt` is in the future is returned from a freshly decoded cache\n+     * document and the\n      * round trip is skipped. `'refresh'` and `'bypass'` always fetch (the\n      * caller decides whether to write). A custom store whose `get()` rejects\n      * is routed to `onerror` and treated as a miss — cache bookkeeping never\n@@ -1705,11 +1706,11 @@ export class Client extends Protocol<ClientContext> {\n                 const reason = options.signal.reason;\n                 throw reason instanceof SdkError ? reason : new SdkError(SdkErrorCode.RequestTimeout, String(reason));\n             }\n-            // Clone on the way out so a caller mutating the returned aggregate\n-            // (e.g. `result.tools.sort(...)`) cannot reach the cache or the\n-            // stamp-memoized indices derived from it — the same invariant\n-            // `_cache.write` upholds on the way in.\n-            return structuredClone(entry.value) as R;\n+            // ClientResponseCache decodes the stored JSON document on every\n+            // read, so this value is already a fresh object. A caller can\n+            // mutate it without reaching the stored document or the\n+            // stamp-memoized indices derived from another decode.\n+            return entry.value as R;\n         }\n         return undefined;\n     }\ndiff --git a/packages/client/src/client/responseCache.ts b/packages/client/src/client/responseCache.ts\nindex 171d4cf..1b5f2ab 100644\n--- a/packages/client/src/client/responseCache.ts\n+++ b/packages/client/src/client/responseCache.ts\n@@ -52,10 +52,13 @@ export interface CacheKey {\n }\n \n /**\n- * One cached response body. `value` is the verbatim decoded result; `stamp` is\n- * the store-generated monotonically increasing write counter — opaque to\n- * callers. Derived views (e.g. a `name → Tool` index) memoize against it and\n- * re-derive only when it changes. `expiresAt` (absolute ms epoch, `now +\n+ * One cached response body. Values written by the client are serialized JSON\n+ * protocol documents rather than live result objects. The `unknown` type is\n+ * retained for source compatibility with existing custom stores; the client\n+ * can also read their legacy decoded-object entries during migration.\n+ * `stamp` is the store-generated monotonically increasing write counter —\n+ * opaque to callers. Derived views (e.g. a `name → Tool` index) memoize\n+ * against it and re-derive only when it changes. `expiresAt` (absolute ms epoch, `now +\n  * ttlMs`) and `scope` are the client-computed freshness metadata; the store\n  * MUST persist them and hand them back on `get` so the read path can decide\n  * freshness and gate the shared-partition fallback on `scope === 'public'`.\n@@ -243,6 +246,32 @@ function genKey(method: string, params?: string): string {\n     return params === undefined ? method : `${method}\\0${params}`;\n }\n \n+/**\n+ * Encode a decoded protocol result for storage. JSON is the cache boundary:\n+ * stores receive a portable document rather than references to SDK runtime\n+ * objects, and parsing it later supplies the defensive copy needed on hits.\n+ */\n+export function serializeCacheDocument(value: unknown): string {\n+    const document = JSON.stringify(value);\n+    if (document === undefined) throw new TypeError('Cache values must be JSON-serializable protocol documents');\n+    return document;\n+}\n+\n+/**\n+ * Decode a stored protocol document. Non-string values are accepted as a\n+ * compatibility bridge for custom stores populated by older SDK releases;\n+ * routing those values through JSON still gives them the same protocol-\n+ * document semantics and mutation isolation as newly written entries.\n+ */\n+export function deserializeCacheDocument(value: unknown): unknown {\n+    return JSON.parse(typeof value === 'string' ? value : JSON.stringify(value));\n+}\n+\n+/** Decode an entry without exposing the store-owned metadata object. */\n+function deserializeCacheEntry(entry: CacheEntry): CacheEntry {\n+    return { ...entry, value: deserializeCacheDocument(entry.value) };\n+}\n+\n /**\n  * Upper bound on the server-supplied `ttlMs` honoured by\n  * {@linkcode ClientResponseCache} (24h). A server cannot pin an entry\n@@ -384,11 +413,11 @@ export class ClientResponseCache {\n         const key = { method, params: params ?? '' };\n         const ownPartition = this._partitionFor('private');\n         const own = await this._store.get({ ...key, partition: ownPartition });\n-        if (own !== undefined) return own;\n+        if (own !== undefined) return deserializeCacheEntry(own);\n         const sharedPartition = this._partitionFor('public');\n         if (sharedPartition === ownPartition) return undefined;\n         const shared = await this._store.get({ ...key, partition: sharedPartition });\n-        return shared?.scope === 'public' ? shared : undefined;\n+        return shared?.scope === 'public' ? deserializeCacheEntry(shared) : undefined;\n     }\n \n     /**\n@@ -487,7 +516,7 @@ export class ClientResponseCache {\n      * overwriting the eviction with the stale aggregate would lose the\n      * invalidation.\n      *\n-     * The stored value is a `structuredClone` of `value`, so a caller\n+     * The stored value is a serialized JSON protocol document, so a caller\n      * mutating the aggregate it was returned (e.g. `result.tools.sort(...)`)\n      * cannot reach the cache or the stamp-memoized indices derived from it. A\n      * custom store whose `set()` throws or rejects is routed to the\n@@ -529,7 +558,7 @@ export class ClientResponseCache {\n         try {\n             await this._store.set(\n                 { method, params, partition },\n-                { value: structuredClone(value), expiresAt: freshness?.expiresAt, scope: freshness?.scope }\n+                { value: serializeCacheDocument(value), expiresAt: freshness?.expiresAt, scope: freshness?.scope }\n             );\n         } catch (error) {\n             this._reportError(error);\ndiff --git a/packages/client/test/client/mcpParamMirroring.test.ts b/packages/client/test/client/mcpParamMirroring.test.ts\nindex 8402aad..10ee336 100644\n--- a/packages/client/test/client/mcpParamMirroring.test.ts\n+++ b/packages/client/test/client/mcpParamMirroring.test.ts\n@@ -17,7 +17,11 @@ import {\n import { describe, expect, it, vi } from 'vitest';\n \n import { Client } from '../../src/client/client';\n-import { InMemoryResponseCacheStore, type ResponseCacheStore } from '../../src/client/responseCache';\n+import {\n+    deserializeCacheDocument,\n+    InMemoryResponseCacheStore,\n+    type ResponseCacheStore\n+} from '../../src/client/responseCache';\n import { StreamableHTTPClientTransport } from '../../src/client/streamableHttp';\n \n const MODERN = '2026-07-28';\n@@ -132,9 +136,11 @@ describe('SEP-2243 Mcp-Param-* mirroring (modern era)', () => {\n         const { tools } = await client.listTools();\