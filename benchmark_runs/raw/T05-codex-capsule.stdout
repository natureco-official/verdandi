ps it', () => {\n@@ -121,6 +122,52 @@ describe('registerTool/registerPrompt accept raw Zod shape (auto-wrapped)', () =\n     });\n });\n \n+describe('resources/read URI validation', () => {\n+    it('returns Invalid Params for a malformed URI without affecting valid resource reads', async () => {\n+        const server = new McpServer({ name: 't', version: '1.0.0' });\n+        server.registerResource('valid', 'test://valid', {}, async uri => ({\n+            contents: [{ uri: uri.toString(), text: 'valid resource' }]\n+        }));\n+\n+        const [client, srv] = InMemoryTransport.createLinkedPair();\n+        await server.connect(srv);\n+        await client.start();\n+\n+        const responses: JSONRPCMessage[] = [];\n+        client.onmessage = message => responses.push(message);\n+\n+        await client.send({\n+            jsonrpc: '2.0',\n+            id: 1,\n+            method: 'initialize',\n+            params: {\n+                protocolVersion: LATEST_PROTOCOL_VERSION,\n+                capabilities: {},\n+                clientInfo: { name: 'c', version: '1.0.0' }\n+            }\n+        } as JSONRPCMessage);\n+        await client.send({ jsonrpc: '2.0', method: 'notifications/initialized' } as JSONRPCMessage);\n+        await client.send({ jsonrpc: '2.0', id: 2, method: 'resources/read', params: { uri: 'not a valid URI' } } as JSONRPCMessage);\n+        await client.send({ jsonrpc: '2.0', id: 3, method: 'resources/read', params: { uri: 'test://valid' } } as JSONRPCMessage);\n+\n+        await vi.waitFor(() =>\n+            expect(responses.filter(response => 'id' in response && (response.id === 2 || response.id === 3))).toHaveLength(2)\n+        );\n+\n+        const malformedResponse = responses.find(response => 'id' in response && response.id === 2) as {\n+            error?: { code: number };\n+        };\n+        expect(malformedResponse.error?.code).toBe(-32_602);\n+\n+        const validResponse = responses.find(response => 'id' in response && response.id === 3) as {\n+            result?: { contents: Array<{ text?: string }> };\n+        };\n+        expect(validResponse.result?.contents[0]?.text).toBe('valid resource');\n+\n+        await server.close();\n+    });\n+});\n+\n describe('InferRawShape', () => {\n     it('preserves optionality from .optional() as ?: keys', () => {\n         type S = InferRawShape<{ a: z.ZodString; b: z.ZodOptional<z.ZodString> }>;\n M packages/server/src/server/mcp.ts\n M packages/server/test/server/mcp.compat.test.ts\n","exit_code":0,"status":"completed"}}
