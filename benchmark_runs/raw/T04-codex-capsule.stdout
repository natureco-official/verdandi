d();\npackages/client/test/client/sse.test.ts:544:                authProvider: mockAuthProvider\npackages/client/test/client/sse.test.ts:548:            expect(mockAuthProvider.redirectToAuthorization.mock.calls).toHaveLength(1);\npackages/client/test/client/sse.test.ts:613:                authProvider: mockAuthProvider\npackages/client/test/client/sse.test.ts:626:            expect(mockAuthProvider.redirectToAuthorization.mock.calls).toHaveLength(1);\npackages/client/test/client/sse.test.ts:630:            mockAuthProvider.tokens.mockResolvedValue({\npackages/client/test/client/sse.test.ts:640:                authProvider: mockAuthProvider,\npackages/client/test/client/sse.test.ts:668:            mockAuthProvider.tokens.mockImplementation(() => currentTokens);\npackages/client/test/client/sse.test.ts:669:            mockAuthProvider.saveTokens.mockImplementation(tokens => {\npackages/client/test/client/sse.test.ts:776:                authProvider: mockAuthProvider\npackages/client/test/client/sse.test.ts:781:            expect(mockAuthProvider.saveTokens).toHaveBeenCalledWith({\npackages/client/test/client/sse.test.ts:797:            mockAuthProvider.tokens.mockImplementation(() => currentTokens);\npackages/client/test/client/sse.test.ts:798:            mockAuthProvider.saveTokens.mockImplementation(tokens => {\npackages/client/test/client/sse.test.ts:920:                authProvider: mockAuthProvider\npackages/client/test/client/sse.test.ts:934:            expect(mockAuthProvider.saveTokens).toHaveBeenCalledWith({\npackages/client/test/client/sse.test.ts:950:            mockAuthProvider.tokens.mockImplementation(() => currentTokens);\npackages/client/test/client/sse.test.ts:951:            mockAuthProvider.saveTokens.mockImplementation(tokens => {\npackages/client/test/client/sse.test.ts:1014:                authProvider: mockAuthProvider\npackages/client/test/client/sse.test.ts:1018:            expect(mockAuthProvider.redirectToAuthorization).toHaveBeenCalled();\npackages/client/test/client/sse.test.ts:1023:            mockAuthProvider.tokens.mockResolvedValue({\npackages/client/test/client/sse.test.ts:1066:                authProvider: mockAuthProvider\npackages/client/test/client/sse.test.ts:1070:            expect(mockAuthProvider.invalidateCredentials).toHaveBeenCalledWith('all');\npackages/client/test/client/sse.test.ts:1075:            mockAuthProvider.tokens.mockResolvedValue({\npackages/client/test/client/sse.test.ts:1117:                authProvider: mockAuthProvider\npackages/client/test/client/sse.test.ts:1121:            expect(mockAuthProvider.invalidateCredentials).toHaveBeenCalledWith('all');\npackages/client/test/client/sse.test.ts:1126:            mockAuthProvider.tokens.mockResolvedValue({\npackages/client/test/client/sse.test.ts:1168:                authProvider: mockAuthProvider\npackages/client/test/client/sse.test.ts:1172:            expect(mockAuthProvider.invalidateCredentials).toHaveBeenCalledWith('tokens');\npackages/client/test/client/sse.test.ts:1179:        let mockAuthProvider: Mocked<OAuthClientProvider>;\npackages/client/test/client/sse.test.ts:1185:        const createMockAuthProvider = (\npackages/client/test/client/sse.test.ts:1335:            mockAuthProvider = createMockAuthProvider({\npackages/client/test/client/sse.test.ts:1378:                authProvider: mockAuthProvider,\npackages/client/test/client/sse.test.ts:1399:            expect(mockAuthProvider.redirectToAuthorization).toHaveBeenCalled();\npackages/client/test/client/sse.test.ts:1442:                authProvider: mockAuthProvider,\npackages/client/test/client/sse.test.ts:1480:            expect(mockAuthProvider.redirectToAuthorization).toHaveBeenCalled();\npackages/client/test/client/sse.test.ts:1488:            const authProviderWithCode = createMockAuthProvider({\npackages/client/test/client/sse.test.ts:1532:    describe('minimal AuthProvider (non-OAuth)', () => {\npackages/client/test/client/sse.test.ts:1571:            