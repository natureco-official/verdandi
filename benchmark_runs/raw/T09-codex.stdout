ed to `onerror` and treated as a miss — cache bookkeeping never\n./packages/client/src/client/client.ts:1696:        if (options?.cacheMode === 'bypass' || options?.cacheMode === 'refresh') return undefined;\n./packages/client/src/client/client.ts:1697:        const entry = await this._cache.read(method, params).catch(error => void this._reportStoreError(error));\n./packages/client/src/client/client.ts:1698:        if (entry?.expiresAt !== undefined && entry.expiresAt > this._cache.now()) {\n./packages/client/src/client/client.ts:1702:            // a cache hit would resolve successfully and silently swallow the\n./packages/client/src/client/client.ts:1709:            // (e.g. `result.tools.sort(...)`) cannot reach the cache or the\n./packages/client/src/client/client.ts:1711:            // `_cache.write` upholds on the way in.\n./packages/client/src/client/client.ts:1712:            return structuredClone(entry.value) as R;\n./packages/client/src/client/client.ts:1724:     * {@linkcode ClientResponseCache.outputValidator} so the cache class stays\n./packages/client/src/client/client.ts:1728:     * cache, so it cannot poison the listed tool of the same name).\n./packages/client/src/client/client.ts:1753:     * cached `tools/list` entry (via the cache's `toolDefinition`) is the\n./packages/client/src/client/client.ts:1754:     * source. Freshness is the response cache's lifecycle: `list_changed`\n./packages/client/src/client/client.ts:1763:        const tool = override ?? (await this._cache.toolDefinition(name));\n./packages/client/src/client/client.ts:1770:     * Honours the result's `ttlMs`/`cacheScope` (SEP-2549): a still-fresh\n./packages/client/src/client/client.ts:1771:     * cached body for the same `uri` is returned without a round trip\n./packages/client/src/client/client.ts:1772:     * (`cacheMode: 'use'`, the default). The cache key is `{method, uri}`\n./packages/client/src/client/client.ts:1775:     * {@linkcode ClientOptions | ClientOptions.cachePartition}, so a shared\n./packages/client/src/client/client.ts:1787:        // `write` skips so the now-stale body is not re-cached. Same guard as\n./packages/client/src/client/client.ts:1789:        const generation = this._cache.captureGeneration('resources/read', params.uri);\n./packages/client/src/client/client.ts:1791:        if (options?.cacheMode !== 'bypass') {\n./packages/client/src/client/client.ts:1793:            if (freshness.expiresAt > this._cache.now()) {\n./packages/client/src/client/client.ts:1794:                await this._cache.write('resources/read', result, generation, freshness);\n./packages/client/src/client/client.ts:1795:            } else if (options?.cacheMode === 'refresh') {\n./packages/client/src/client/client.ts:1799:                // serving stale until its old expiry (mcp.d's `cachedFetch`\n./packages/client/src/client/client.ts:1805:                await this._cache.evictKey('resources/read', params.uri);\n./packages/client/src/client/client.ts:2046:        // Response-cache invalidation: a `list_changed` notification means the\n./packages/client/src/client/client.ts:2047:        // matching cached list result is stale. Evict (do NOT refetch) before\n./packages/client/src/client/client.ts:2048:        // dispatch so a handler that reaches the cache observes the cleared\n./packages/client/src/client/client.ts:2057:            // Per-URI eviction (mcp.d's `invalidateLogical`): the now-cached\n./packages/client/src/client/client.ts:2064:            if (typeof uri === 'string') void this._cache.evictKey('resources/read', uri);\n./packages/client/src/client/client.ts:2076:                void this._cache.evict(method);\n./packages/client/src/client/client.ts:2230:        // Mirroring (and output-schema validation below) read the cached\n./packages/client/src/client/client.ts:2231:        // `tools/list` entry directly via `_cache.toolDefinition` /\n./packages/client/src/client/client.ts:2232:        // `_cache.outputValidator`. `callTool` never issues a `tools/list`\n./packages/client/src/client/client.ts:2233:        // itself — the cache is populated by the caller's own\n./packages/client/src/client/client.ts:2235:        // by the `HEADER_MISMATCH` recovery path below. A cold cache means\n./packages/client/src/client/client.ts:2244:            // without `Mcp-Param-*` headers — same posture as a cold cache —\n./packages/client/src/client/client.ts:2262:        // derived views must agree — and is compiled in isolation (never written to the cache). The\n./packages/client/src/client/client.ts:2263:        // cache read is guarded: a custom store whose `get()` rejects routes to `onerror` and\n./packages/client/src/client/client.ts:2264:        // degrades to skipping validation (same outcome as a cold cache).\n./packages/client/src/client/client.ts:2267:                ? await this._cache\n./packages/client/src/client/client.ts:2288:            // header we did not (or could not) send — the cached `tools/list`\n./packages/client/src/client/client.ts:2291:            // writes the cache), and retry once with the now-known schema.\n./packages/client/src/client/client.ts:2298:            // `cacheMode: 'refresh'` so the recovery refetch always reaches\n./packages/client/src/client/client.ts:2302:            // the `listTools()` below would cache-serve the very entry whose\n./packages/client/src/client/client.ts:2305:            const refreshOptions = { signal: options?.signal, timeout: options?.timeout, cacheMode: 'refresh' as const };\n./packages/client/src/client/client.ts:2306:            await this._cache.evict('tools/list');\n./packages/client/src/client/client.ts:2310:            // to the retry. NOTE: when the refetch fails the cache stays\n./packages/client/src/client/client.ts:2317:            // `compiled` was resolved from the now-evicted cache and may be stale (different\n./packages/client/src/client/client.ts:2318:            // outputSchema) or absent (cold cache on the first attempt). The recovery path is only\n./packages/client/src/client/client.ts:2319:            // entered when `options.toolDefinition` is undefined, so the cache is the sole source.\n./packages/client/src/client/client.ts:2321:            compiled = await this._cache\n./packages/client/src/client/client.ts:2378:     * next call) and does not write the response cache. The auto-aggregate\n./packages/client/src/client/client.ts:2402:            // Per-page: single request, never written to the response cache.\n./packages/client/src/client/client.ts:2414:        // the complete aggregate via the `finalize` hook before the cache\n./packages/client/src/client/client.ts:2415:        // write, so the cached entry never holds an unmirrorable tool.\n./packages/core-internal/CHANGELOG.md:57:- [#2286](https://github.com/modelcontextprotocol/typescript-sdk/pull/2286) [`1823aae`](https://github.com/modelcontextprotocol/typescript-sdk/commit/1823aae891837ebb5e3db885ec635f9efefd5771) Thanks [@felixweinberger](https://github.com/felixweinberger)! - Results of the cacheable 2026-07-28 operations (`tools/list`, `prompts/list`, `resources/list`, `resources/templates/list`, `resources/read`, `server/discover`) now always carry the revision's required `ttlMs`/`cacheScope` fields when served on that revision, defaulting to `ttlMs: 0` / `cacheScope: 'private'`. Servers can configure the emitted values with the new `ServerOptions.cacheHints` option (per operation) and the new `cacheHint` member of the `registerResource` config (per resource); resolution is per field, most specific author first: cache fields returned by a handler win over the per-resource hint, which wins over the per-operation hint, and configured hints are validated at construction/registration time (`RangeError` on invalid values). Responses on 2025-era connections are unchanged and never carry these fields. Note for untyped callers: `registerResource` now interprets a `cacheHint` key in its config object — it is validated and kept out of the resource's list metadata, where it was previously passed through as ordinary metadata.\n./packages/core-internal/CHANGELOG.md:115:- [#2286](https://github.com/modelcontextprotocol/typescript-sdk/pull/2286) [`1823aae`](https://github.com/modelcontextprotocol/typescript-sdk/commit/1823aae891837ebb5e3db885ec635f9efefd5771) Thanks [@felixweinberger](https://github.com/felixweinberger)! - SEP-2243 `Mcp-Param-*` client-side mirroring (protocol revision 2026-07-28). On a 2026-07-28 connection over Streamable HTTP, `Client.callTool()` now mirrors tool arguments designated with `x-mcp-header` in the tool's `inputSchema` into `Mcp-Param-{Name}` HTTP headers (with the spec's `=?base64?…?=` sentinel encoding for values that are not safe plain-ASCII field values), and on a non-stdio modern connection `Client.listTools()` (and the client's internal `tools/list` cache) exclude tool definitions whose `x-mcp-header` declarations violate the spec's constraints, logging a warning naming the tool and the reason. The legacy-era `callTool` and `listTools` paths are unchanged at the wire level. Browser environments skip mirroring (dynamically named headers cannot be statically allow-listed for credentialed CORS); a conforming SEP-2243 server will reject a `tools/call` whose body carries a non-null value for an `x-mcp-header` parameter when the matching header is absent, so calling such a tool with that argument from a browser is a known limitation. New `CallToolRequestOptions.toolDefinition` lets callers supply the tool definition directly so mirroring and output-schema validation can run without a prior `tools/list`. `TransportSendOptions.headers` is added (additive, optional) for per-request HTTP headers; the Streamable HTTP transport skips reserved standard/auth header names (`authorization`, `mcp-protocol-version`, `mcp-method`, `mcp-name`, `mcp-session-id`, `content-type`); transports that share a single channel (stdio, in-memory) ignore it.\n./packages/core-internal/CHANGELOG.md:170:    - The 2026 wire-true `resultType` member now defaults to `'complete'` when absent (the spec's receiver-side back-compat rule); the inbound `decodeResult` step continues to require it. The `server/discover` result accepts absent or malformed `ttlMs`/`cacheScope` (falling back to `0`/`'private'` per the spec's receiver leniency in caching.mdx) so the version-negotiation probe classifier stays behavior-neutral. Other cacheable result schemas are unchanged here; general receiver leniency for those belongs to the response-cache surface.\n./packages/core-internal/src/validators/types.ts:42: *         // Compile/cache validator from schema\n./test/e2e/scenarios/client-auth.test.ts:2752:    // PRM now lists AS-two. Drop cached discovery (as a host would on a fresh 401) so\n./packages/client/src/client/probeClassifier.ts:150:    // `resultType` ('complete'), `ttlMs` (0) and `cacheScope` ('private'), so\n./packages/client/src/client/probeClassifier.ts:152:    // parse for absent and malformed cache hints (`.catch()` per spec receiver\n./test/e2e/requirements.ts:555:            'A falsy structuredContent value (0, false, \"\", null) is treated as present by the client and validated against the cached outputSchema — the presence check is `=== undefined`, not falsy, so a tool returning structuredContent: 0 against outputSchema {type:\"integer\"} resolves with the value rather than throwing \"did not return structured content\".',\n./test/e2e/requirements.ts:2655:    'typescript:hosting:entry:modern-cacheable-stamping': {\n./test/e2e/requirements.ts:2658:            'Typed tools/list, resources/read and resources/list round trips negotiated on 2026-07-28 over a createMcpHandler endpoint succeed, and the wire results carry resultType \"complete\" plus the required ttlMs/cacheScope fields, with the configured-hint precedence observable on the wire: the per-resource cacheHint wins over the per-operation cacheHints entry (resources/read), a per-operation hint wins over the defaults (tools/list), and a result with no configured author is filled with the ttlMs 0 / cacheScope private defaults (resources/list).',\n./test/e2e/requirements.ts:2661:        note: 'Runs on the entryModern arm; the typed round trips go through the wired negotiating client and the wire-level stamping is asserted on the arm-recorded response bytes. The top precedence rung — a handler-returned ttlMs/cacheScope value winning over every configured hint — is pinned at unit level and not exercised here.'\n./test/e2e/requirements.ts:2663:    'typescript:hosting:entry:legacy-cacheable-suppression': {\n./test/e2e/requirements.ts:2666:            'A factory with every cache-hint author configured (per-operation cacheHints and a per-resource cacheHint), served to a plain 2025 client through the legacy stateless slot of a createMcpHandler endpoint, answers tools/list and resources/read with no resultType, ttlMs, cacheScope or cacheHint vocabulary anywhere in the response bytes.',\n./packages/core-internal/src/validators/cfWorkerProvider.ts:72:     * Unlike AJV, this validator is not cached internally\n./packages/client/src/client/responseCache.ts:4: * Client-side response cache for SEP-2549 (`CacheableResult`) freshness hints.\n./packages/client/src/client/responseCache.ts:8: * `Client`'s single cache-coordination collaborator). The `stamp` field is\n./packages/client/src/client/responseCache.ts:12: * Reference design: mcp.d `client/cache.d` / `client/client.d` (`CacheStore`,\n./packages/client/src/client/responseCache.ts:13: * `cachedTool`, `cachedFetch`, `invalidateLogical`).\n./packages/client/src/client/responseCache.ts:19:/** The freshness scope of a cached entry (SEP-2549 `cacheHints.scope`). */\n./packages/client/src/client/responseCache.ts:23: * Per-call cache disposition for the cacheable verbs (`listTools()` /\n./packages/client/src/client/responseCache.ts:27: * - `'use'` (the default) — serve a still-fresh cached entry without a round\n./packages/client/src/client/responseCache.ts:31: * - `'bypass'` — fetch without consulting OR writing the cache (the result is\n./packages/client/src/client/responseCache.ts:38: * A logical cache address. `params` is the canonical result-affecting params\n./packages/client/src/client/responseCache.ts:45: * `'private'`-scoped entry at `[serverIdentity, cachePartition]`. Omitted is\n./packages/client/src/client/responseCache.ts:55: * One cached response body. `value` is the verbatim decoded result; `stamp` is\n./packages/client/src/client/responseCache.ts:71: * The pluggable response-cache store. The interface is intentionally narrow;\n./packages/client/src/client/responseCache.ts:254: * The `Client`'s cache-coordination collaborator.\n./packages/client/src/client/responseCache.ts:256: * Owns the per-connection cache state that used to live as five private\n./packages/client/src/client/responseCache.ts:286:     * `name → Tool` index derived from the cached `tools/list` entry, memoized\n./packages/client/src/client/responseCache.ts:288:     * changes (mcp.d's `cachedTool` pattern).\n./packages/client/src/client/responseCache.ts:292:     * `name → compiled output-schema validator` derived from the cached\n./packages/client/src/client/responseCache.ts:332:        private readonly _cachePartition: string = '',\n./packages/client/src/client/responseCache.ts:365:     * `[serverIdentity, cachePartition]`. When `cachePartition` is `''` the\n./packages/client/src/client/responseCache.ts:369:        return JSON.stringify([this._serverIdentity, scope === 'public' ? '' : this._cachePartition]);\n./packages/client/src/client/responseCache.ts:376:     * `cachePartition` writes its `'private'`-scoped entries at the public\n./packages/client/src/client/responseCache.ts:378:     * leak private bodies (mcp.d's `cachedEntry` two-probe order; the scope\n./packages/client/src/client/responseCache.ts:380:     * `cachePartition` is `''` the two partitions are identical and only one\n./packages/client/src/client/responseCache.ts:434:     * no-op and cannot re-cache the now-stale body) but only when the key was\n./packages/client/src/client/responseCache.ts:474:     * and the stale body would be cached.\n./packages/client/src/client/responseCache.ts:490:     * The stored value is a `structuredClone` of `value`, so a caller\n./packages/client/src/client/responseCache.ts:492:     * cannot reach the cache or the stamp-memoized indices derived from it. A\n./packages/client/src/client/responseCache.ts:494:     * `reportError` sink and the write resolves — cache bookkeeping never\n./packages/client/src/client/responseCache.ts:499:     * `now + ttlMs`) and the server-reported `cacheScope`. The storage\n./packages/client/src/client/responseCache.ts:502:     * `'private'` → `[serverIdentity, cachePartition]` (so a shared store\n./packages/client/src/client/responseCache.ts:511:     * two-partition posture). A server that flips a result's `cacheScope` for\n./packages/client/src/client/responseCache.ts:532:                { value: structuredClone(value), expiresAt: freshness?.expiresAt, scope: freshness?.scope }\n./packages/client/src/client/responseCache.ts:551:     * Read the cached entry for `{method, params}` via the two-probe lookup\n./packages/client/src/client/responseCache.ts:579:     * The descriptor for tool `name` taken from the cached `tools/list` entry.\n./packages/client/src/client/responseCache.ts:581:     * re-derived only when the backing entry changes (mcp.d's `cachedTool`).\n./packages/client/src/client/responseCache.ts:604:     * cached `tools/list` entry — same source and same stamp-keyed\n./examples/guides/clients/caching.examples.ts:12: * whatever this file prints. It throws (non-zero exit) if a cache-served call\n./examples/guides/clients/caching.examples.ts:28:// (the harness) serves it; the tool and resource give the cache something to\n./examples/guides/clients/caching.examples.ts:33:    //#region cacheHints_server\n./examples/guides/clients/caching.examples.ts:37:            cacheHints: {\n./examples/guides/clients/caching.examples.ts:38:                'tools/list': { ttlMs: 60_000, cacheScope: 'public' },\n./examples/guides/clients/caching.examples.ts:39:                'resources/read': { ttlMs: 5_000, cacheScope: 'private' }\n./examples/guides/clients/caching.examples.ts:43:    //#endregion cacheHints_server\n./examples/guides/clients/caching.examples.ts:82:// ## Let the cache work — the calls whose request counts the page quotes.\n./examples/guides/clients/caching.examples.ts:84://#region responseCache_use\n./examples/guides/clients/caching.examples.ts:85:const tools = await client.listTools(); // network, then cached for the server's ttlMs\n./examples/guides/clients/caching.examples.ts:86:const again = await client.listTools(); // served from cache while still fresh\n./examples/guides/clients/caching.examples.ts:88:await client.listTools(undefined, { cacheMode: 'refresh' }); // always refetch and re-store\n./examples/guides/clients/caching.examples.ts:89:await client.readResource({ uri: 'config://app' }, { cacheMode: 'bypass' }); // no cache read or write\n./examples/guides/clients/caching.examples.ts:90://#endregion responseCache_use\n./examples/guides/clients/caching.examples.ts:97:// the cached result carries the same tools.\n./examples/guides/clients/caching.examples.ts:102:    throw new Error('caching.md claim failed: cached listTools() differs from the first result');\n./examples/guides/clients/caching.examples.ts:116:function responseCacheStore_shared() {\n./examples/guides/clients/caching.examples.ts:117:    //#region responseCacheStore_shared\n./examples/guides/clients/caching.examples.ts:120:    const client = new Client({ name: 'my-client', version: '1.0.0' }, { responseCacheStore: store });\n./examples/guides/clients/caching.examples.ts:121:    //#endregion responseCacheStore_shared\n./examples/guides/clients/caching.examples.ts:127:function cachePartition_perUser(sharedStore: ResponseCacheStore, userId: string) {\n./examples/guides/clients/caching.examples.ts:128:    //#region cachePartition_perUser\n./examples/guides/clients/caching.examples.ts:129:    const client = new Client({ name: 'gateway', version: '1.0.0' }, { responseCacheStore: sharedStore, cachePartition: userId });\n./examples/guides/clients/caching.examples.ts:130:    //#endregion cachePartition_perUser\n./examples/guides/clients/caching.examples.ts:143:void responseCacheStore_shared;\n./examples/guides/clients/caching.examples.ts:144:void cachePartition_perUser;\n./packages/core-internal/src/validators/types.examples.ts:22:            // Compile/cache validator from schema\n./packages/client/src/client/middleware.ts:295: * const cacheMiddleware = createMiddleware(async (next, input, init) => {\n./packages/client/src/client/middleware.ts:296: *     const cacheKey = typeof input === 'string' ? input : input.toString();\n./packages/client/src/client/middleware.ts:298: *     // Check cache first\n./packages/client/src/client/middleware.ts:299: *     const cached = await getFromCache(cacheKey);\n./packages/client/src/client/middleware.ts:300: *     if (cached) {\n./packages/client/src/client/middleware.ts:301: *         return new Response(cached, { status: 200 });\n./packages/client/src/client/middleware.ts:304: *     // Make request and cache result\n./packages/client/src/client/middleware.ts:307: *         await saveToCache(cacheKey, await response.clone().text());\n./packages/client/CHANGELOG.md:66:- [#2286](https://github.com/modelcontextprotocol/typescript-sdk/pull/2286) [`1823aae`](https://github.com/modelcontextprotocol/typescript-sdk/commit/1823aae891837ebb5e3db885ec635f9efefd5771) Thanks [@felixweinberger](https://github.com/felixweinberger)! - `Client.listTools()` / `listPrompts()` / `listResources()` / `listResourceTemplates()` now **auto-aggregate every page** when called without a `cursor` and return the complete result with `nextCursor: undefined` (matching the C#, Java, and mcp.d SDKs). Pass an explicit `{ cursor }` string to fetch a single page; the per-page path is unchanged. Existing manual pagination loops keep working — the first iteration returns everything and the loop exits — but can be deleted. The aggregated result is written to the new pluggable `ResponseCacheStore` (default: a fresh per-instance `InMemoryResponseCacheStore`); a `ClientResponseCache` collaborator owns the eviction-generation guard and the derived `tools/list` index that `callTool`'s output validation and SEP-2243 `Mcp-Param-*` mirroring read. New exports: `ResponseCacheStore`, `CacheKey`, `CacheEntry`, `CacheScope`, `MaybePromise`, `InMemoryResponseCacheStore`; new `ClientOptions.responseCacheStore` / `ClientOptions.listMaxPages` (caps the auto-aggregate walk at 64 pages by default; throws `SdkError` with `SdkErrorCode.ListPaginationExceeded` on overrun so a partial aggregate is never cached). The store interface is async-ready (`MaybePromise<…>`); the in-memory default stays synchronous. Entries are automatically scoped by the connected server's identity and (when set) the consumer-supplied `cachePartition`, so a shared store does not collide across servers or principals; evictions are likewise scoped to the connected server's partitions.\n./packages/client/CHANGELOG.md:68:    **Behavior change (every era):** output-schema validator compilation is now lazy — validators are compiled on the first `callTool()` against the cached `tools/list` entry, not eagerly inside `listTools()`. `listTools()` no longer throws on an uncompilable `outputSchema` (every tool stays listed; the compile failure is captured per-tool); calling `callTool()` on the affected tool throws `ProtocolError(InvalidParams, \"Tool 'X' has an invalid outputSchema: …\")` before the request is sent — output-schema validation is never silently skipped. A pluggable `jsonSchemaValidator` provider therefore observes compilation at `callTool` time, not `listTools` time. The legacy-era `listTools()` path is unchanged at the wire level but is observably different at the validator-lifecycle level.\n./packages/client/CHANGELOG.md:104:- [#2286](https://github.com/modelcontextprotocol/typescript-sdk/pull/2286) [`1823aae`](https://github.com/modelcontextprotocol/typescript-sdk/commit/1823aae891837ebb5e3db885ec635f9efefd5771) Thanks [@felixweinberger](https://github.com/felixweinberger)! - `Client` now **honours** the server-stamped SEP-2549 `ttlMs`/`cacheScope` cache hints on the cacheable verbs (`listTools()`, `listPrompts()`, `listResources()`, `listResourceTemplates()`, `readResource()`): a still-fresh held entry is served without a round trip. New `CacheableRequestOptions.cacheMode` (`'use'` — the default; `'refresh'` — always fetch and re-store; `'bypass'` — fetch without consulting or writing the cache) gives per-call control. The behaviour is opt-in by hint: a server that sends `ttlMs: 0` (the conservative default this SDK's server stamps) sees byte-identical behaviour — every call fetches.\n./packages/client/CHANGELOG.md:106:    Entries are automatically scoped by connected-server identity (derived from `serverInfo` after connect, encoded collision-free via `JSON.stringify`); `ClientOptions.cachePartition` is the opaque per-principal slot for `'private'`-scoped entries — set it to your principal identifier (e.g. the auth subject) when one `responseCacheStore` backs several principals. With the default `''` every entry lives at the connected server's shared partition (the safe single-tenant posture). `ClientOptions.defaultCacheTtlMs` (default `0`) supplies the TTL when a result lacks one (e.g. a legacy-era response); the server-supplied `ttlMs` is clamped at 24 h (`MAX_CACHE_TTL_MS`). The list verbs always store the aggregate (so `callTool`'s mirroring/output-validation index keeps working at any TTL); `readResource` stores only when the resolved TTL is positive. `notifications/resources/updated` evicts the cached `resources/read` body for that URI. `ResponseCacheStore` gained `delete(key)`; `InMemoryResponseCacheStore` is now bounded (`{ maxEntries }`, default 512, oldest-first eviction). New exports: `CacheMode`, `CacheableRequestOptions`, `InMemoryResponseCacheStoreOptions`, `MAX_CACHE_TTL_MS`.\n./packages/client/CHANGELOG.md:148:- [#2286](https://github.com/modelcontextprotocol/typescript-sdk/pull/2286) [`1823aae`](https://github.com/modelcontextprotocol/typescript-sdk/commit/1823aae891837ebb5e3db885ec635f9efefd5771) Thanks [@felixweinberger](https://github.com/felixweinberger)! - SEP-2243 `Mcp-Param-*` client-side mirroring (protocol revision 2026-07-28). On a 2026-07-28 connection over Streamable HTTP, `Client.callTool()` now mirrors tool arguments designated with `x-mcp-header` in the tool's `inputSchema` into `Mcp-Param-{Name}` HTTP headers (with the spec's `=?base64?…?=` sentinel encoding for values that are not safe plain-ASCII field values), and on a non-stdio modern connection `Client.listTools()` (and the client's internal `tools/list` cache) exclude tool definitions whose `x-mcp-header` declarations violate the spec's constraints, logging a warning naming the tool and the reason. The legacy-era `callTool` and `listTools` paths are unchanged at the wire level. Browser environments skip mirroring (dynamically named headers cannot be statically allow-listed for credentialed CORS); a conforming SEP-2243 server will reject a `tools/call` whose body carries a non-null value for an `x-mcp-header` parameter when the matching header is absent, so calling such a tool with that argument from a browser is a known limitation. New `CallToolRequestOptions.toolDefinition` lets callers supply the tool definition directly so mirroring and output-schema validation can run without a prior `tools/list`. `TransportSendOptions.headers` is added (additive, optional) for per-request HTTP headers; the Streamable HTTP transport skips reserved standard/auth header names (`authorization`, `mcp-protocol-version`, `mcp-method`, `mcp-name`, `mcp-session-id`, `content-type`); transports that share a single channel (stdio, in-memory) ignore it.\n./packages/client/CHANGELOG.md:187:    - The 2026 wire-true `resultType` member now defaults to `'complete'` when absent (the spec's receiver-side back-compat rule); the inbound `decodeResult` step continues to require it. The `server/discover` result accepts absent or malformed `ttlMs`/`cacheScope` (falling back to `0`/`'private'` per the spec's receiver leniency in caching.mdx) so the version-negotiation probe classifier stays behavior-neutral. Other cacheable result schemas are unchanged here; general receiver leniency for those belongs to the response-cache surface.\n./packages/client/CHANGELOG.md:311:    - New `'discovery'` scope for `invalidateCredentials()` to clear cached discovery state.\n./packages/core-internal/test/wire/encodeContract.test.ts:10: *  step 2 — cache fill: `ttlMs`/`cacheScope` filled only on post-stamp\n./packages/core-internal/test/wire/encodeContract.test.ts:11: *           `'complete'` results of the cacheable operations, resolved most\n./packages/core-internal/test/wire/encodeContract.test.ts:24:    cacheHintFallbackOf,\n./packages/core-internal/test/wire/encodeContract.test.ts:85:describe('step 2 — the cache fill', () => {\n./packages/core-internal/test/wire/encodeContract.test.ts:86:    test('the cacheable-operation list is closed at exactly six operations', () => {\n./packages/core-internal/test/wire/encodeContract.test.ts:95:        expect(filled['cacheScope']).toBe(DEFAULT_CACHE_SCOPE);\n./packages/core-internal/test/wire/encodeContract.test.ts:99:        'never fills cache fields for %s (not a cacheable operation)',\n./packages/core-internal/test/wire/encodeContract.test.ts:103:            expect('cacheScope' in filled).toBe(false);\n./packages/core-internal/test/wire/encodeContract.test.ts:107:    test('input_required results are never given cache fields (stamp-before-fill ordering)', () => {\n./packages/core-internal/test/wire/encodeContract.test.ts:110:        expect('cacheScope' in filled).toBe(false);\n./packages/core-internal/test/wire/encodeContract.test.ts:114:        const result = attachCacheHintFallback(asResult({ resultType: 'complete', ttlMs: 30_000, cacheScope: 'public' }), {\n./packages/core-internal/test/wire/encodeContract.test.ts:116:            cacheScope: 'private'\n./packages/core-internal/test/wire/encodeContract.test.ts:120:        expect(filled['cacheScope']).toBe('public');\n./packages/core-internal/test/wire/encodeContract.test.ts:124:        const result = attachCacheHintFallback(asResult({ resultType: 'complete' }), { ttlMs: 5_000, cacheScope: 'public' });\n./packages/core-internal/test/wire/encodeContract.test.ts:127:        expect(filled['cacheScope']).toBe('public');\n./packages/core-internal/test/wire/encodeContract.test.ts:134:        expect(filled['cacheScope']).toBe(DEFAULT_CACHE_SCOPE);\n./packages/core-internal/test/wire/encodeContract.test.ts:144:        ['an unknown cacheScope', { cacheScope: 'shared' }]\n./packages/core-internal/test/wire/encodeContract.test.ts:146:        const result = attachCacheHintFallback(asResult({ resultType: 'complete', ...invalid }), { ttlMs: 1_000, cacheScope: 'public' });\n./packages/core-internal/test/wire/encodeContract.test.ts:149:        expect(filled['cacheScope']).toBe('public');\n./packages/core-internal/test/wire/encodeContract.test.ts:154:        expect(cacheHintFallbackOf(filledTarget)).toBeUndefined();\n./packages/core-internal/test/wire/encodeContract.test.ts:157:        expect(cacheHintFallbackOf(nonTarget)).toBeUndefined();\n./packages/core-internal/test/wire/encodeContract.test.ts:164:        expect(cacheHintFallbackOf(withBoth)).toEqual({ ttlMs: 2_000 });\n./packages/core-internal/test/wire/encodeContract.test.ts:168:        const withSpecific = attachCacheHintFallback(asResult({}), { cacheScope: 'public' });\n./packages/core-internal/test/wire/encodeContract.test.ts:169:        const withBoth = attachCacheHintFallbac