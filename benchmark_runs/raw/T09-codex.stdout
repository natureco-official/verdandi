{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"1e9|value: \\\\{|value as \\\\{ tools|structuredClone|Clone-on-serve\\\" packages/client/test/client/responseCache.test.ts packages/client/test/client/mcpParamMirroring.test.ts packages/client/src\"","aggregated_output":"packages/client/test/client/responseCache.test.ts:214:        await cache.write('resources/read', { contents: [] }, gen, { expiresAt: 1e9, scope: 'private', params: 'res://a' });\npackages/client/test/client/responseCache.test.ts:220:        await cache.write('resources/read', { contents: [] }, genB, { expiresAt: 1e9, scope: 'private', params: 'res://b' });\npackages/client/test/client/responseCache.test.ts:224:        await cache.write('resources/read', { contents: [] }, gen2, { expiresAt: 1e9, scope: 'private', params: 'res://a' });\npackages/client/test/client/responseCache.test.ts:266:            expiresAt: 1e9,\npackages/client/test/client/responseCache.test.ts:644:        // Clone-on-serve: hit is a fresh copy, not the stored object.\npackages/client/test/client/mcpParamMirroring.test.ts:135:        expect((store.get({ method: 'tools/list', partition: PART })?.value as { tools: Tool[] }).tools.map(t => t.name)).toEqual([\npackages/client/test/client/mcpParamMirroring.test.ts:181:                value: {\npackages/client/test/client/mcpParamMirroring.test.ts:200:            (store.get({ method: 'tools/list', partition: PART })?.value as { tools: Tool[] }).tools[0]?.inputSchema.properties\npackages/client/test/client/mcpParamMirroring.test.ts:220:                value: {\npackages/client/test/client/mcpParamMirroring.test.ts:243:            (store.get({ method: 'tools/list', partition: PART })?.value as { tools: Tool[] }).tools[0]?.inputSchema.properties\npackages/client/test/client/mcpParamMirroring.test.ts:312:                value: {\npackages/client/test/client/mcpParamMirroring.test.ts:347:            { value: { tools: [{ name: 'ro