{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' test/integration/test/server/mcp.test.ts && find test/integration -maxdepth 2 -name package.json -print && sed -n '1,220p' test/integration/package.json && rg -n \\\"resource URI|Invalid Params|InvalidParams|readResource|resources/read|ProtocolError|McpError\\\" . --glob '\"'!node_modules'\"' --glob '\"'!dist'\"'\"","aggregated_output":"import { Client } from '@modelcontextprotocol/client';\nimport type { Notification, TextContent } from '@modelcontextprotocol/core-internal';\nimport {\n    getDisplayName,\n    InMemoryTransport,\n    ProtocolErrorCode,\n    UriTemplate,\n    UrlElicitationRequiredError\n} from '@modelcontextprotocol/core-internal';\nimport { completable, McpServer, ResourceTemplate } from '@modelcontextprotocol/server';\nimport { afterEach, beforeEach, describe, expect, test } from 'vitest';\nimport * as z from 'zod/v4';\n\ndescribe('Zod v4', () => {\n    describe('McpServer', () => {\n        /***\n         * Test: Basic Server Instance\n         */\n        test('should expose underlying Server instance', () => {\n            const mcpServer = new McpServer({\n                name: 'test server',\n                version: '1.0'\n            });\n\n            expect(mcpServer.server).toBeDefined();\n        });\n\n        /***\n         * Test: Notification Sending via Server\n         */\n        test('should allow sending notifications via Server', async () => {\n            const mcpServer = new McpServer(\n                {\n                    name: 'test server',\n                    version: '1.0'\n                },\n                { capabilities: { logging: {} } }\n            );\n\n            const notifications: Notification[] = [];\n            const client = new Client({\n                name: 'test client',\n                version: '1.0'\n            });\n            client.fallbackNotificationHandler = async notification => {\n                notifications.push(notification);\n            };\n\n            const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n\n            await Promise.all([client.connect(clientTransport), mcpServer.server.connect(serverTransport)]);\n\n            // This should work because we're using the underlying server\n            await expect(\n                mcpServer.server.sendLoggingMessage({\n                    level: 'info',\n                    data: 'Test log message'\n                })\n            ).resolves.not.toThrow();\n\n            expect(notifications).toMatchObject([\n                {\n                    method: 'notifications/message',\n                    params: {\n                        level: 'info',\n                        data: 'Test log message'\n                    }\n                }\n            ]);\n        });\n\n        /***\n         * Test: ctx.mcpReq.log convenience method\n         */\n        test('should send logging messages via ctx.mcpReq.log() convenience method', async () => {\n            const mcpServer = new McpServer(\n                {\n                    name: 'test server',\n                    version: '1.0'\n                },\n                { capabilities: { logging: {} } }\n            );\n\n            const notifications: Notification[] = [];\n            const client = new Client({\n                name: 'test client',\n                version: '1.0'\n            });\n            client.fallbackNotificationHandler = async notification => {\n                notifications.push(notification);\n            };\n\n            mcpServer.registerTool(\n                'log-test',\n                {\n                    description: 'A tool that logs via ctx.mcpReq.log()'\n                },\n                async ctx => {\n                    await ctx.mcpReq.log('info', 'Log from convenience method', 'test-logger');\n                    return {\n                        content: [{ type: 'text' as const, text: 'done' }]\n                    };\n                }\n            );\n\n            const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n            await Promise.all([client.connect(clientTransport), mcpServer.server.connect(serverTransport)]);\n\n            await client.callTool({ name: 'log-test' });\n\n            expect(notifications).toMatchObject([\n                {\n                    method: 'notifications/message',\n                    params: {\n                        level: 'info',\n                        data: 'Log from convenience method',\n                        logger: 'test-logger'\n                    }\n                }\n            ]);\n        });\n\n        /***\n         * Test: ctx.mcpReq.elicitInput convenience method\n         */\n        test('should elicit input via ctx.mcpReq.elicitInput() convenience method', async () => {\n            const mcpServer = new McpServer({\n                name: 'test server',\n                version: '1.0'\n            });\n\n            let elicitResult: unknown = null;\n\n            mcpServer.registerTool(\n                'elicit-test',\n                {\n                    description: 'A tool that elicits input via ctx.mcpReq.elicitInput()'\n                },\n                async ctx => {\n                    elicitResult = await ctx.mcpReq.elicitInput({\n                        message: 'Please confirm',\n                        requestedSchema: {\n                            type: 'object',\n                            properties: {\n                                confirmed: { type: 'boolean' }\n                            }\n                        }\n                    });\n                    return {\n                        content: [{ type: 'text' as const, text: 'done' }]\n                    };\n                }\n            );\n\n            const client = new Client({ name: 'test client', version: '1.0' }, { capabilities: { elicitation: {} } });\n\n            client.setRequestHandler('elicitation/create', async () => ({\n                action: 'accept',\n                content: { confirmed: true }\n            }));\n\n            const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n            await Promise.all([client.connect(clientTransport), mcpServer.server.connect(serverTransport)]);\n\n            await client.callTool({ name: 'elicit-test' });\n\n            expect(elicitResult).toMatchObject({\n                action: 'accept',\n                content: { confirmed: true }\n            });\n        });\n\n        /***\n         * Test: ctx.mcpReq.requestSampling convenience method\n         */\n        test('should request sampling via ctx.mcpReq.requestSampling() convenience method', async () => {\n            const mcpServer = new McpServer({\n                name: 'test server',\n                version: '1.0'\n            });\n\n            let samplingResult: unknown = null;\n\n            mcpServer.registerTool(\n                'sampling-test',\n                {\n                    description: 'A tool that requests sampling via ctx.mcpReq.requestSampling()'\n                },\n                async ctx => {\n                    samplingResult = await ctx.mcpReq.requestSampling({\n                        messages: [\n                            {\n                                role: 'user',\n                                content: { type: 'text', text: 'Hello' }\n                            }\n                        ],\n                        maxTokens: 100\n                    });\n                    return {\n                        content: [{ type: 'text' as const, text: 'done' }]\n                    };\n                }\n            );\n\n            const client = new Client({ name: 'test client', version: '1.0' }, { capabilities: { sampling: {} } });\n\n            client.setRequestHandler('sampling/createMessage', async () => ({\n                model: 'test-model',\n                role: 'assistant' as const,\n                content: { type: 'text' as const, text: 'Hello back' }\n            }));\n\n            const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();\n            await Promise.all([client.connect(clientTransport), mcpServer.server.connect(serverTransport)]);\n\n            await client.callTool({ name: 'sampling-test' });\n\n            expect(samplingResult).toMatchObject({\n                model: 'test-model',\n                role: 'assistant',\n                content: { type: 'text', text: 'Hello back' }\n            });\n        });\n\n        /***\n         * Test: Progress Notification with Message Field\n         */\n        test('should send progress notifications with message field', async () => {\n            const mcpServer = new McpServer({\n                name: 'test server',\n                version: '1.0'\n            });\n\n            // Create a tool that sends progress updates\n            mcpServer.registerTool(\n                'long-operation',\n                {\n                    description: 'A long running operation with progress updates',\n                    inputSchema: z.object({\n                        steps: z.number().min(1).describe('Number of steps to perform')\n                    })\n                },\n                async ({ steps }, ctx) => {\n                    const progressToken = ctx.mcpReq._meta?.progressToken;\n\n                    if (progressToken) {\n                        // Send progress notification for each step\n                        for (let i = 1; i <= steps; i++) {\n                            await ctx.mcpReq.notify({\n                                method: 'notifications/progress',\n                                params: {\n                                    progressToken,\n                                    progress: i,\n                                    total: steps,\n                                    message: `Completed step ${i} of ${steps}`\n                                }\n                            });\n                        }\n                    }\n\ntest/integration/package.json\n{\n    \"name\": \"@modelcontextprotocol/test-integration\",\n    \"private\": true,\n    \"version\": \"2.0.0-beta.0\",\n    \"description\": \"Model Context Protocol implementation for TypeScript\",\n    \"license\": \"MIT\",\n    \"author\": \"Anthropic, PBC (https://anthropic.com)\",\n    \"homepage\": \"https://modelcontextprotocol.io\",\n    \"bugs\": \"https://github.com/modelcontextprotocol/typescript-sdk/issues\",\n    \"type\": \"module\",\n    \"repository\": {\n        \"type\": \"git\",\n        \"url\": \"git+https://github.com/modelcontextprotocol/typescript-sdk.git\"\n    },\n    \"engines\": {\n        \"node\": \">=20\",\n        \"pnpm\": \">=10.24.0\"\n    },\n    \"packageManager\": \"pnpm@10.24.0\",\n    \"keywords\": [\n        \"modelcontextprotocol\",\n        \"mcp\"\n    ],\n    \"scripts\": {\n        \"lint\": \"eslint test/ && prettier --ignore-path ../../.prettierignore --check .\",\n        \"lint:fix\": \"eslint test/ --fix && prettier --ignore-path ../../.prettierignore --write .\",\n        \"check\": \"npm run typecheck && npm run lint\",\n        \"test\": \"vitest run\",\n        \"test:watch\": \"vitest\",\n        \"test:integration:bun\": \"bun test test/server/bun.test.ts\",\n        \"test:integration:deno\": \"deno test --no-check --allow-net --allow-read --allow-env test/server/deno.test.ts\"\n    },\n    \"devDependencies\": {\n        \"@cfworker/json-schema\": \"catalog:runtimeShared\",\n        \"@modelcontextprotocol/client\": \"workspace:^\",\n        \"@modelcontextprotocol/core-internal\": \"workspace:^\",\n        \"@modelcontextprotocol/eslint-config\": \"workspace:^\",\n        \"@modelcontextprotocol/express\": \"workspace:^\",\n        \"@modelcontextprotocol/node\": \"workspace:^\",\n        \"@modelcontextprotocol/server\": \"workspace:^\",\n        \"@modelcontextprotocol/test-helpers\": \"workspace:^\",\n        \"@modelcontextprotocol/tsconfig\": \"workspace:^\",\n        \"@modelcontextprotocol/vitest-config\": \"workspace:^\",\n        \"@valibot/to-json-schema\": \"catalog:devTools\",\n        \"arktype\": \"catalog:devTools\",\n        \"supertest\": \"catalog:devTools\",\n        \"valibot\": \"catalog:devTools\",\n        \"vitest\": \"catalog:devTools\",\n        \"wrangler\": \"catalog:devTools\",\n        \"zod\": \"catalog:runtimeShared\"\n    }\n}\n./test/conformance/src/everythingServer.ts:35:    ProtocolError,\n./test/conformance/src/everythingServer.ts:36:    ProtocolErrorCode,\n./test/conformance/src/everythingServer.ts:887:                throw new ProtocolError(ProtocolErrorCode.InvalidParams, 'Invalid requestState: missing or failed integrity verification');\n./test/conformance/src/everythingClient.ts:232:// tools/call, resources/list, resources/read, prompts/list, prompts/get and\n./test/conformance/src/everythingClient.ts:257:        await client.readResource({ uri: resource.uri });\n./docs/get-started/first-client.md:101:```ts source=\"../../examples/guides/get-started/firstClient.examples.ts#firstClient_readResource\"\n./docs/get-started/first-client.md:105:const { contents } = await client.readResource({ uri: 'weather://about' });\n./docs/get-started/first-client.md:128:`listResources` advertises the metadata you registered; `readResource` returns the handler's `contents` unchanged.\n./docs/get-started/first-client.md:154:- `listTools`, `callTool`, `listResources`, and `readResource` are the client verbs; each returns a typed result.\n./packages/codemod/src/migrations/v1-to-v2/mappings/symbolMap.ts:2:    McpError: 'ProtocolError',\n./packages/codemod/src/migrations/v1-to-v2/mappings/schemaToMethodMap.ts:8:    ReadResourceRequestSchema: 'resources/read',\n./REVIEW.md:36:- Correct `ProtocolError` codes (enum `ProtocolErrorCode`); HTTP status codes match spec (e.g., 404 vs 410)\n./REVIEW.md:74:- Broad `catch` blocks must not emit client-fault JSON-RPC codes (`-32700` ParseError, `-32602` InvalidParams) for server-internal failures like stream setup, task-store misses, or polling errors — map those to `-32603` InternalError so clients don't retry/reformat pointlessly. Flag any catch-all that hard-codes ParseError/InvalidParams without discriminating the thrown cause. (#1752, #1769)\n./docs/servers/prompts.md:71:import type { ProtocolError } from '@modelcontextprotocol/client';\n./docs/servers/prompts.md:76:    const { code, message } = error as ProtocolError;\n./docs/servers/prompts.md:87:A failed prompt validation is a protocol error — `getPrompt` rejects with a `ProtocolError` carrying code `-32602` (Invalid params). A [tool](./tools.md) argument rejection comes back as an `isError: true` result instead.\n./docs/servers/prompts.md:154:`prompts/get` returns the style guide inline as the first message, so the client never makes a second `resources/read` round trip:\n./packages/codemod/CHANGELOG.md:31:- [#2393](https://github.com/modelcontextprotocol/typescript-sdk/pull/2393) [`e4e8b22`](https://github.com/modelcontextprotocol/typescript-sdk/commit/e4e8b22dff6c48b9a46fd960c9171aed44a996a8) Thanks [@felixweinberger](https://github.com/felixweinberger)! - Migration-sweep batch. The ErrorCode split now coordinates with the surrounding check: an all-SDK condition's `instanceof ProtocolError`/`McpError` guard is rewritten to `SdkError`, a guard covering both enums gets a marker asking for a split, and an `ErrorCode` import with no rewritable member access on a v2 specifier is dropped with a marker instead of failing at module link time. Wrapping a raw shape with `z.object()` adds `import { z } from 'zod'` when the file has no `z` value binding (a non-import `z` binding gets a marker instead). The context-parameter rewrite finds the trailing `extra` parameter, covering the three-argument `registerResource` template callback without flagging its `variables` argument. Resource-server auth helpers routed to the frozen server-legacy copy get a marker on value imports and barrel re-exports (an info note for type-only imports), every rewritten `SdkHttpError` constructor site gets a marker, and single-argument `finishAuth(...)` calls in files the run changes get a run-log note (the one-argument `URLSearchParams` form is valid v2, so the note never re-fires on already-migrated trees). The codemod accepts a single source file as target — source rewrites scope to that file and manifest changes are reported, not applied — and the no-changes summary distinguishes \"already on the v2 packages\", \"still on the v1 SDK under a transform subset\", and \"no MCP SDK imports found\".\n./packages/codemod/CHANGELOG.md:37:- [#2393](https://github.com/modelcontextprotocol/typescript-sdk/pull/2393) [`e4e8b22`](https://github.com/modelcontextprotocol/typescript-sdk/commit/e4e8b22dff6c48b9a46fd960c9171aed44a996a8) Thanks [@felixweinberger](https://github.com/felixweinberger)! - Backlog fixes. When the zod import injection fires in a package that declares no zod, the manifest pass adds it (devDependencies when only tests import it) so strict node_modules layouts install cleanly. The ErrorCode-split pairing re-points stale `as ProtocolError`/`as McpError` casts bound to subjects whose assertions it moves to `SdkError`. Handler registration resolves one same-file variable hop (`const S = ListToolsRequestSchema`) before declaring a schema custom. Shorthand and aliased destructures of SDK dynamic imports rename with the static-import pass. Call-shape assertions pinning a registration schema (`expect.objectContaining({ inputSchema: … })`) get an advisory. The guide covers dist-text pins (no CJS-resolvable subpaths, content-hashed chunks, changed quote style, ESM-only output).\n./packages/codemod/test/cli.test.ts:86:            [`import { McpError } from '@modelcontextprotocol/sdk/types.js';`, `throw new McpError(1, 'e');`, ''].join('\\n')\n./packages/codemod/test/cli.test.ts:99:            [`import type { McpError } from '@modelcontextprotocol/sdk/types.js';`, `export type E = McpError;`, ''].join('\\n')\n./packages/codemod/test/cli.test.ts:110:            [`import type { McpError } from '@modelcontextprotocol/sdk/types.js';`, `export type E = McpError;`, ''].join('\\n')\n./docs/servers/input-required.md:6:An **`input_required`** result is how a `tools/call`, `prompts/get`, or `resources/read` handler asks the connected client for input mid-call: the handler returns the embedded requests, the client answers them and retries the call, and the handler runs again with the responses.\n./packages/codemod/test/integration.test.ts:51:            `const code = ErrorCode.InvalidParams;`,\n./packages/codemod/test/integration.test.ts:74:        expect(output).toContain('ProtocolErrorCode.InvalidParams');\n./packages/codemod/test/integration.test.ts:332:            `import { McpError } from '@modelcontextprotocol/sdk/types.js';`,\n./packages/codemod/test/integration.test.ts:346:        // McpError should NOT be renamed (symbols transform was not selected)\n./packages/codemod/test/integration.test.ts:347:        expect(output).toContain('McpError');\n./packages/codemod/test/integration.test.ts:666:            [`import { McpError } from '@modelcontextprotocol/sdk/types.js';`, `throw new McpError(1, 'e');`, ``].join('\\n')\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:69:    let needsProtocolErrorCode = false;\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:91:        node.getExpression().replaceWithText(isSdkMember ? 'SdkErrorCode' : 'ProtocolErrorCode');\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:93:        else needsProtocolErrorCode = true;\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:104:        // Constructor pairing: `new ProtocolError(ErrorCode.RequestTimeout, …)` — the\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:118:                (classExpr.getText() === 'ProtocolError' || classExpr.getText() === 'McpError') &&\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:153:                    `This constructor's code argument mixes SdkErrorCode and ProtocolErrorCode members, but v2 raises ` +\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:154:                        `them on different error classes (SdkError and ProtocolError). Split the construction per class.`\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:163:    // `toBeInstanceOf(ProtocolError)` assertions whose subject is also asserted to\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:174:            if (className !== 'ProtocolError' && className !== 'McpError') continue;\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:187:                        `This subject is asserted with both SdkErrorCode and ProtocolErrorCode members, but v2 raises them ` +\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:223:                        `toBeInstanceOf — review those assertions: SDK-routed codes are raised on SdkError, not ProtocolError.`\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:229:    // Second pass: v2 raises the SDK codes on SdkError, not ProtocolError, so a\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:230:    // guard of `instanceof ProtocolError` paired with an SDK-code comparison never\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:243:                        `This check compares both SdkErrorCode and ProtocolErrorCode members, but v2 raises them on ` +\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:244:                            `different error classes (SdkError and ProtocolError) — one instanceof guard cannot cover both. ` +\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:260:                            `ProtocolError and SdkError. The codes compared here route to SdkErrorCode, but this check's shape ` +\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:261:                            `does not pin the guarded value to one class — match SdkError for SDK-raised codes, ProtocolError ` +\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:283:                `${errorCodeLocalName} is not exported by the v2 packages — it split into ProtocolErrorCode (protocol codes) ` +\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:321:        if (needsProtocolErrorCode) newImports.push('ProtocolErrorCode');\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:347:                'ErrorCode split into ProtocolErrorCode and SdkErrorCode. Verify the migration is correct.'\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:354:        removeUnusedImport(sourceFile, 'ProtocolError', true);\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:355:        removeUnusedImport(sourceFile, 'McpError', true);\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:525:/** `instanceof ProtocolError`/`instanceof McpError` checks within the expression. */\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:531:            if (Node.isIdentifier(right) && (right.getText() === 'ProtocolError' || right.getText() === 'McpError')) {\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:755: * `const err = (await p) as ProtocolError` binding for the same subject becomes a\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:766:            if (typeNode !== undefined && (typeText === 'ProtocolError' || typeText === 'McpError')) {\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:776:    // `err = e as McpError` inside a catch block is the dominant test shape — the\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:787: * `const { McpError } = await import('@modelcontextprotocol/…')` — the static-import\n./packages/codemod/src/migrations/v1-to-v2/transforms/symbolRenames.ts:789: * references; aliased elements (`{ McpError: ME }`) re-point only the property name.\n./docs/protocol-versions.md:162:| HTTP `400` with a JSON-RPC error body | `SdkHttpError`                                                           | `ProtocolError`, delivered in-band                                 |\n./packages/codemod/src/migrations/v1-to-v2/transforms/importPaths.ts:16:    ErrorCode: 'Re-exported ErrorCode was split into ProtocolErrorCode and SdkErrorCode in v2. Update this re-export manually.',\n./packages/codemod/test/commentInsertion.test.ts:75:            `const code = ErrorCode.InvalidParams;`,\n./examples/mrtr/server.ts:19: * expired state with a wire-level `-32602` Invalid Params error before the\n./docs/servers/errors.md:13:import { McpServer, ProtocolError, ProtocolErrorCode, ResourceNotFoundError, ResourceTemplate } from '@modelcontextprotocol/server';\n./docs/servers/errors.md:102:Resource, prompt, and completion callbacks have no `isError` channel. Throw `ProtocolError(code, message, data?)` when the request itself is wrong.\n./docs/servers/errors.md:112:            throw new ProtocolError(ProtocolErrorCode.InvalidParams, `Note ids are lowercase letters, got \"${noteId}\"`);\n./docs/servers/errors.md:122:`ProtocolError` and `ProtocolErrorCode` replace v1's `McpError` and `ErrorCode` — run the codemod, then see the [upgrade guide](../migration/upgrade-to-v2.md).\n./docs/servers/errors.md:127:```ts source=\"../../examples/guides/servers/errors.examples.ts#readResource_protocolError\"\n./docs/servers/errors.md:129:    await client.readResource({ uri: 'note://42' });\n./docs/servers/errors.md:131:    const { code, message } = error as ProtocolError;\n./docs/servers/errors.md:136:`readResource` rejects with a `ProtocolError` carrying the wire fields:\n./docs/servers/errors.md:142:On the wire this is a JSON-RPC error response — `{ code, message, data? }` instead of a `result` — and the host's MCP client handles it; the model never sees it. A non-`ProtocolError` exception thrown from one of these callbacks surfaces as `-32603` Internal Error with the exception's message.\n./docs/servers/errors.md:146:Pick by audience. The model drives `tools/call`, so a failure it can recover from — a missing record, a bad argument, a transient upstream fault — belongs in `isError: true` with a message that names the fix. The host application drives `resources/read`, `prompts/get`, and `completion/complete`, so failures there are protocol errors addressed to the caller's code.\n./docs/servers/errors.md:150:- A tool handler produces only tool errors. The SDK converts every exception it throws — including a thrown `ProtocolError` — into an `isError: true` result. `UrlElicitationRequiredError` is the one exception; it propagates as a JSON-RPC error so the host can open the URL — see [Elicitation](./elicitation.md).\n./docs/servers/errors.md:151:- A resource, prompt, or completion callback produces only protocol errors. Throw a `ProtocolError`.\n./docs/servers/errors.md:155:Each subclass picks the right `ProtocolErrorCode` and packs structured `data` for you. `ResourceNotFoundError` takes the missing URI — the read callback above already throws it for a well-formed id with no note.\n./docs/servers/errors.md:157:```ts source=\"../../examples/guides/servers/errors.examples.ts#readResource_notFound\"\n./docs/servers/errors.md:159:    await client.readResource({ uri: 'note://archived' });\n./docs/servers/errors.md:166:The error carries the requested URI in `data` and the code the spec mandates for a `resources/read` miss:\n./docs/servers/errors.md:182:Match these by `code` and `data` shape when peers may run pre-brand SDK copies or hand you plain wire shapes; on brand-aware releases `instanceof` also matches across separately bundled copies of the SDK. The same check is available as an explicit static guard — `ProtocolError.isInstance(err)`, `ResourceNotFoundError.isInstance(err)` — which narrows in TypeScript and reads the same brand.\n./docs/servers/errors.md:186:`ProtocolErrorCode` is the complete vocabulary of wire codes the SDK sends and recognizes.\n./docs/servers/errors.md:193:| `InvalidParams` | `-32602` | The params are wrong — also the code for a `resources/read` miss. |\n./docs/servers/errors.md:194:| `InternalError` | `-32603` | The handler threw something other than a `ProtocolError`. |\n./docs/servers/errors.md:195:| `ResourceNotFound` | `-32002` | Receive-tolerated only: the SDK answers a `resources/read` miss with `-32602` and never emits `-32002`. Throw `ResourceNotFoundError` instead. |\n./docs/servers/errors.md:207:- `ProtocolError` and its subclasses, thrown from resource, prompt, and completion callbacks, become JSON-RPC error responses the model never sees.\n./docs/servers/errors.md:209:- The table above lists every `ProtocolErrorCode` member.\n./packages/codemod/test/v1-to-v2/transforms/symbolRenames.test.ts:17:    it('renames McpError to ProtocolError', () => {\n./packages/codemod/test/v1-to-v2/transforms/symbolRenames.test.ts:18:        const input = [`import { McpError } from '@modelcontextprotocol/sdk/types.js';`, `throw new McpError(1, 'error');`, ''].join('\\n');\n./packages/codemod/test/v1-to-v2/transforms/symbolRenames.test.ts:20:        expect(result).toContain('ProtocolError');\n./packages/codemod/test/v1-to-v2/transforms/symbolRenames.test.ts:21:        expect(result).not.toContain('McpError');\n./packages/codemod/test/v1-to-v2/transforms/symbolRenames.test.ts:86:    it('splits ErrorCode into ProtocolErrorCode and SdkErrorCode', () => {\n./packages/codemod/test/v1-to-v2/transfor