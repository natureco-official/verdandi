ust NOT set `_initialized = true` before\npackages/server/src/server/mcp.ts:213:                throw new ProtocolError(ProtocolErrorCode.InvalidParams, `Tool ${request.params.name} not found`);\npackages/server/src/server/mcp.ts:216:                throw new ProtocolError(ProtocolErrorCode.InvalidParams, `Tool ${request.params.name} disabled`);\npackages/server/src/server/mcp.ts:277:                ProtocolErrorCode.InvalidParams,\npackages/server/src/server/mcp.ts:309:                ProtocolErrorCode.InvalidParams,\npackages/server/src/server/mcp.ts:318:                ProtocolErrorCode.InvalidParams,\npackages/server/src/server/mcp.ts:362:                    throw new ProtocolError(ProtocolErrorCode.InvalidParams, `Invalid completion reference: ${request.params.ref}`);\npackages/server/src/server/mcp.ts:373:            throw new ProtocolError(ProtocolErrorCode.InvalidParams, `Prompt ${ref.name} not found`);\npackages/server/src/server/mcp.ts:377:            throw new ProtocolError(ProtocolErrorCode.InvalidParams, `Prompt ${ref.name} disabled`);\npackages/server/src/server/mcp.ts:411:            throw new ProtocolError(ProtocolErrorCode.InvalidParams, `Resource template ${request.params.ref.uri} not found`);\npackages/server/src/server/mcp.ts:485:                    throw new ProtocolError(ProtocolErrorCode.InvalidParams, `Resource ${uri} disabled`);\npackages/server/src/server/mcp.ts:547:                throw new ProtocolError(ProtocolErrorCode.InvalidParams, `Prompt ${request.params.name} not found`);\npackages/server/src/server/mcp.ts:551:                throw new ProtocolError(ProtocolErrorCode.InvalidParams, `Prompt ${request.params.name} disabled`);\npackages/server/src/server/mcp.ts:814:        // validation; a malformed declaration here should not block local\npackages/server/src/server/mcp.ts:1465:                throw new ProtocolError(ProtocolErrorCode.InvalidParams, `Invalid arguments for prompt ${name}: ${parseResult.error}`);\npackages/server/src/server/requestStateCodec.ts:68:     * on any failure (bad MAC, expired, bind mismatch, malformed). The thrown\npackages/server/src/server/requestStateCodec.ts:69:     * message is a fixed opaque reason code (`'malformed'` / `'mac'` /\npackages/server/src/server/requestStateCodec.ts:218:                throw new Error('malformed');\npackages/server/src/server/requestStateCodec.ts:225:                throw new Error('malformed');\npackages/server/src/server/requestStateCodec.ts:245:                throw new Error('malformed');\npackages/server/test/server/legacyInputRequiredShim.test.ts:415:        // The malformed content reached the handler (bare, unvalidated), the\npackages/server/test/server/requestStateCodec.test.ts:52:    it('rejects malformed envelopes (missing prefix / missing segments)', async () => {\npackages/server/test/server/requestStateCodec.test.ts:54:        await expect(codec.verify('not-v1.body.mac', fakeCtx('tools/call'))).rejects.toThrow('malformed');\npackages/server/test/server/requestStateCodec.test.ts:55:        await expect(codec.verify('v1.bodyonly', fakeCtx('tools/call'))).rejects.toThrow('malformed');\npackages/server/test/server/requestStateCodec.test.ts:56:        await expect(codec.verify('v1..mac', fakeCtx('tools/call'))).rejects.toThrow('malformed');\npackages/server/test/server/requestStateCodec.test.ts:57:        await expect(codec.verify('', fakeCtx('tools/call'))).rejects.toThrow('malformed');\npackages/server/src/server/middleware/bearerAuth.ts:187:    // malformed options crashes at startup, not on the first request.\npackages/server/test/server/contentTypeValidation.test.ts:113:    it('accepts an unambiguous media type with a malformed parameter section (trailing semicolon)', async () => {\npackages/server/test/server/originValidation.test.ts:3: * absent-header pass, and the deny-on-failure behavior for malformed values.\npackages/server/test/server/originValidation.test.ts:37:        for (const malformed of ['null', 'not a url', 'evil.example.com', 'about:blank']) {\npackages/server/test/server/originValidation.test.ts:38:            const result = validateOriginHeader(malformed, localhostAllowedOrigins());\npackages/server/test/server/eraParityErrorShapes.test.ts:2: * Era-parity error shapes: the same malformed input produces the same\npackages/server/test/server/eraParityErrorShapes.test.ts:44: * - The malformed-body divergences enumerated in {@link KNOWN_EDGE_DIVERGENCES},\npackages/server/test/server/eraParityErrorShapes.test.ts:50: * HTTP transport answers for a malformed POST body and what the modern edge\npackages/server/test/server/eraParityErrorShapes.test.ts:103: * Posts an arbitrary (possibly malformed) body to the deployed 2025-era\npackages/server/test/server/createMcpHandler.test.ts:302:    it('rejects a malformed envelope behind a present claim with invalid params naming the offending key', async () => {\npackages/server/test/server/createMcpHandler.test.ts:398:        // The id could not be read from the malformed body, so it stays null.\npackages/server/test/server/createMcpHandler.test.ts:635:        // A malformed modern claim is NOT legacy: it goes to the modern entry,\npackages/server/test/server/createMcpHandler.test.ts:637:        const malformed = await route(\npackages/server/test/server/createMcpHandler.test.ts:640:        expect(malformed.status).toBe(400);\npackages/server/test/server/createMcpHandler.test.ts:641:        expect(((await malformed.json()) as JSONRPCErrorBody).error.code).toBe(-32_602);\npackages/server/test/server/createMcpHandler.test.ts:687:                name: 'malformed envelope behind a present claim (modern path answers -32602)',\npackages/server/test/server/serveStdio.test.ts:20: * - malformed and unsupported envelope claims are answered by the entry,\npackages/server/test/server/serveStdio.test.ts:531:describe('malformed and unsupported envelope claims (entry-answered, never pinned)', () => {\npackages/server/test/server/serveStdio.test.ts:532:    it('a present claim with a malformed envelope answers -32602 naming the envelope problem', async () => {\n","exit_code":0,"status":"completed"}}
