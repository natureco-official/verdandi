{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"mcpParamHeaders|x-mcp|MCP.*header|header.*MCP\" src test package.json'","aggregated_output":"src/index.ts:12:export * from './shared/mcpParamHeaders';\ntest/shared/inboundClassification.test.ts:121:        // Robustness to proxies/CDNs stripping the MCP-Protocol-Version header:\ntest/shared/standardHeaderValidation.test.ts:24:import { encodeMcpParamValue } from '../../src/shared/mcpParamHeaders';\ntest/shared/mcpParamHeaders.test.ts:24:} from '../../src/shared/mcpParamHeaders';\ntest/shared/mcpParamHeaders.test.ts:129:    test('empty x-mcp-header value is rejected', () => {\ntest/shared/mcpParamHeaders.test.ts:133:    test('non-token x-mcp-header value (space) is rejected', () => {\ntest/shared/mcpParamHeaders.test.ts:151:    // Static-reachability MUST: an x-mcp-header anywhere outside the\ntest/shared/mcpParamHeaders.test.ts:204:        test(`x-mcp-header on a non-statically-reachable position is rejected: ${label}`, () => {\ntest/shared/mcpParamHeaders.test.ts:253:        const headers = new Headers({ [`${MCP_PARAM_HEADER_PREFIX}Region`]: 'us-west1' });\ntest/shared/mcpParamHeaders.test.ts:258:        const headers = new Headers({ [`${MCP_PARAM_HEADER_PREFIX}Region`]: encodeMcpParamValue('Hello, 世界') });\ntest/shared/mcpParamHeaders.test.ts:264:        const headers = new Headers({ [`${MCP_PARAM_HEADER_PREFIX}Region`]: 'whatever' });\nsrc/shared/inboundClassification.ts:20: * - The `MCP-Protocol-Version` header is a cross-check only: it never\nsrc/shared/inboundClassification.ts:53: * - A header/body cross-check mismatch (the `MCP-Protocol-Version` header\nsrc/shared/inboundClassification.ts:77:import { decodeMcpParamValue } from './mcpParamHeaders';\nsrc/shared/inboundClassification.ts:93:    /** The value of the `MCP-Protocol-Version` header, when present. */\nsrc/shared/inboundClassification.ts:207: * `MCP-Protocol-Version` header disagreeing with the body's envelope claim (or\nsrc/shared/inboundClassification.ts:353:            'SEP-2243 `Mcp-Param-*` headers are validated against the named tool’s `x-mcp-header` declarations and the body ' +\nsrc/shared/inboundClassification.ts:662:                'an initialize request (legacy handshake) was sent with a modern MCP-Protocol-Version header'\nsrc/shared/inboundClassification.ts:696:                `the body envelope names protocol version ${claimedVersion} but the MCP-Protocol-Version header names ${headerVersion}`\nsrc/shared/inboundClassification.ts:727:                `Invalid params: the MCP-Protocol-Version header names protocol revision ${headerVersion}, but the request is missing ` +\nsrc/shared/inboundClassification.ts:775:                `the notification envelope names protocol version ${claimedVersion} but the MCP-Protocol-Version header names ${headerVersion}`\ntest/corpus/schema-twins/2026-07-28.schema.json:2710:                    \"description\": \"The MCP Protocol Version being used for this request. Required.\\n\\nFor the HTTP transport, this value MUST match the `MCP-Protocol-Version`\\nheader; otherwise the server MUST return a `400 Bad Request`. If the\\nserver does not support the requested version, it MUST return an\\n{@link UnsupportedProtocolVersionError}.\",\ntest/corpus/schema-twins/2026-07-28.schema.json:3612:                    \"description\": \"A JSON Schema object defining the expected parameters for the tool.\\n\\nTool arguments are always JSON objects, so `type: \\\"object\\\"` is required at the root.\\nBeyond that, any JSON Schema 2020-12 keyword may appear alongside `type` — including\\ncomposition keywords (`oneOf`, `anyOf`, `allOf`, `not`), conditional keywords\\n(`if`/`then`/`else`), reference keywords (`$ref`, `$defs`, `$anchor`), and any other\\nstandard validation or annotation keywords.\\n\\nProperty schemas may carry an `x-mcp-header` annotation to mirror the\\nargument value into an HTTP header on the Streamable HTTP transport. See\\nthe Streamable HTTP transport specification for the validity and\\nextraction rules.\\n\\nDefaults to JSON Schema 2020-12 when no explicit `$schema` is provided.\",\nsrc/shared/mcpParamHeaders.ts:5: * `inputSchema` for `x-mcp-header` declarations, encoding argument values into\nsrc/shared/mcpParamHeaders.ts:11: * The standard-header half (`MCP-Protocol-Version`, `Mcp-Method`, `Mcp-Name`)\nsrc/shared/mcpParamHeaders.ts:20: * - draft/server/tools.mdx § \"x-mcp-header\" (the schema-extension property and\nsrc/shared/mcpParamHeaders.ts:34:export const X_MCP_HEADER_KEY = 'x-mcp-header';\nsrc/shared/mcpParamHeaders.ts:37: * One `x-mcp-header` declaration found inside a tool's `inputSchema`.\nsrc/shared/mcpParamHeaders.ts:51:/** The result of scanning a tool's `inputSchema` for `x-mcp-header` declarations. */\nsrc/shared/mcpParamHeaders.ts:61: * JSON Schema `type` values the spec admits on an `x-mcp-header` property.\nsrc/shared/mcpParamHeaders.ts:65: * `http-custom-headers` scenario with two `type: \"number\"` `x-mcp-header`\nsrc/shared/mcpParamHeaders.ts:73: * Scan a tool's JSON-serialized `inputSchema` for `x-mcp-header` declarations\nsrc/shared/mcpParamHeaders.ts:82: * `x-mcp-header` found anywhere on that path invalidates the schema — \"an\nsrc/shared/mcpParamHeaders.ts:95:                return `${pathName(path)}: x-mcp-header is only permitted on properties statically reachable via a chain of 'properties' keys (not under items, additionalProperties, oneOf/anyOf/allOf/not, if/then/else, or $ref)`;\nsrc/shared/mcpParamHeaders.ts:99:                return `${pathName(path)}: x-mcp-header MUST be a non-empty string`;\nsrc/shared/mcpParamHeaders.ts:102:                return `${pathName(path)}: x-mcp-header '${raw}' is not a valid RFC 9110 token (no spaces, control characters or HTTP delimiters)`;\nsrc/shared/mcpParamHeaders.ts:106:                return `${pathName(path)}: x-mcp-header is only permitted on primitive-typed properties (string, integer, boolean); got ${type ?? '<none>'}`;\nsrc/shared/mcpParamHeaders.ts:111:                return `x-mcp-header '${raw}' is not case-insensitively unique (also declared as '${prior}')`;\nsrc/shared/mcpParamHeaders.ts:150: * constraint excludes from the `properties`-only chain. An `x-mcp-header`\nsrc/shared/mcpParamHeaders.ts:312:        out[`${MCP_PARAM_HEADER_PREFIX}${decl.headerName}`] = encodeMcpParamValue(stringValue);\nsrc/shared/mcpParamHeaders.ts:324: * For each `x-mcp-header` declaration on the named tool: when the body\nsrc/shared/mcpParamHeaders.ts:346:        const headerKey = `${MCP_PARAM_HEADER_PREFIX}${decl.headerName}`;\nsrc/wire/rev2026-07-28/schemas.ts:633:     * the value must match the `MCP-Protocol-Version` header.\nsrc/types/constants.ts:17: * For the HTTP transport, the value must match the `MCP-Protocol-Version` header.\nsrc/types/spec.types.2026-07-28.ts:1938:     * Property schemas may carry an `x-mcp-header` annotation to mirror the\n","exit_code":0,"status":"completed"}}
