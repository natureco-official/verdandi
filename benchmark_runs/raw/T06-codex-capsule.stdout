fication = classificationForClaim(claimedVersion);\n-        if (classification.era === 'modern' && request.mcpMethodHeader !== undefined && request.mcpMethodHeader !== method) {\n+        const methodHeader = request.mcpMethodHeader === undefined ? undefined : trimHeaderOws(request.mcpMethodHeader);\n+        if (classification.era === 'modern' && methodHeader !== undefined && methodHeader !== method) {\n             return crossCheckMismatch(\n                 'notification-method-header-mismatch',\n-                request.mcpMethodHeader,\n-                `the notification body names method ${method} but the Mcp-Method header names ${request.mcpMethodHeader}`\n+                methodHeader,\n+                `the notification body names method ${method} but the Mcp-Method header names ${methodHeader}`\n             );\n         }\n         return { kind: 'modern', messageKind: 'notification', message: body, classification };\n@@ -793,11 +801,12 @@ function classifyNotificationBody(request: InboundHttpRequest, body: JSONRPCNoti\n     // the notification classifies modern — it is never enforced on legacy\n     // notifications.\n     if (headerNamesModern) {\n-        if (request.mcpMethodHeader !== undefined && request.mcpMethodHeader !== method) {\n+        const methodHeader = request.mcpMethodHeader === undefined ? undefined : trimHeaderOws(request.mcpMethodHeader);\n+        if (methodHeader !== undefined && methodHeader !== method) {\n             return crossCheckMismatch(\n                 'notification-method-header-mismatch',\n-                request.mcpMethodHeader,\n-                `the notification body names method ${method} but the Mcp-Method header names ${request.mcpMethodHeader}`\n+                methodHeader,\n+                `the notification body names method ${method} but the Mcp-Method header names ${methodHeader}`\n             );\n         }\n         return {\ndiff --git a/packages/core-internal/test/shared/standardHeaderValidation.t