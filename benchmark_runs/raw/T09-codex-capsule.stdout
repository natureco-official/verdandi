e<Tool | undefined> {\nsrc/client/responseCache.ts:605:     * memoization as {@linkcode toolDefinition}. The `name → validator` index\ntest/client/responseCache.test.ts:2: * Response-cache substrate: store primitives, the {@linkcode ClientResponseCache}\ntest/client/responseCache.test.ts:7: * `toolDefinition` hit/miss and re-derivation only on a stamp change; the\ntest/client/responseCache.test.ts:15:import type { CacheEntry, ResponseCacheStore } from '../../src/client/responseCache';\ntest/client/responseCache.test.ts:16:import { ClientResponseCache, InMemoryResponseCacheStore } from '../../src/client/responseCache';\ntest/client/responseCache.test.ts:27: * `ClientResponseCache._partitionFor` produces.\ntest/client/responseCache.test.ts:30:/** The pre-connect / direct-`ClientResponseCache` sentinel partition (`['', '']`). */\ntest/client/responseCache.test.ts:33:describe('InMemoryResponseCacheStore', () => {\ntest/client/responseCache.test.ts:35:        const store = new InMemoryResponseCacheStore();\ntest/client/responseCache.test.ts:60:        const store = new InMemoryResponseCacheStore();\ntest/client/responseCache.test.ts:74:        const store = new InMemoryResponseCacheStore();\ntest/client/responseCache.test.ts:90:        const small = new InMemoryResponseCacheStore({ maxEntries: 2 });\ntest/client/responseCache.test.ts:106:        const unbounded = new InMemoryResponseCacheStore({ maxEntries: 0 });\ntest/client/responseCache.test.ts:112:        const store = new InMemoryResponseCacheStore({ maxEntries: 3 });\ntest/client/responseCache.test.ts:140:        const store = new InMemoryResponseCacheStore();\ntest/client/responseCache.test.ts:151:describe('ClientResponseCache', () => {\ntest/client/responseCache.test.ts:153:        const store = new InMemoryResponseCacheStore();\ntest/client/responseCache.test.ts:154:        const cache = new ClientResponseCache(store, false);\ntest/client/responseCache.test.ts:168:        const userStore = new InMemoryResponseCa