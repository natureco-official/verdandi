{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/zsh -lc 'git diff -- test/integration/test/server/cloudflareWorkers.test.ts'","aggregated_output":"diff --git a/test/integration/test/server/cloudflareWorkers.test.ts b/test/integration/test/server/cloudflareWorkers.test.ts\nindex 863b534..e750393 100644\n--- a/test/integration/test/server/cloudflareWorkers.test.ts\n+++ b/test/integration/test/server/cloudflareWorkers.test.ts\n@@ -212,13 +212,50 @@ describe('Cloudflare Workers compatibility (no nodejs_compat)', () => {\n         };\n \n         try {\n-            // Pack server package\n+            // Build and pack the server package without touching the workspace dist.\n+            // `pnpm pack` runs the package's prepack script, whose build cleans and rewrites\n+            // packages/server/dist. That races with other tests which consume the workspace\n+            // build. Instead, direct tsdown's output into a staged package under the temp dir,\n+            // then pack that stage without its workspace-building prepack lifecycle.\n             const serverPkgPath = path.resolve(__dirname, '../../../../packages/server');\n-            const packOutput = execSync(`pnpm pack --pack-destination \"${tempDir}\"`, {\n+            const packageWorkspaceDir = path.join(tempDir, 'package-workspace');\n+            const stagedServerPkgPath = path.join(packageWorkspaceDir, 'packages', 'server');\n+            const stagedDistPath = path.join(stagedServerPkgPath, 'dist');\n+            fs.mkdirSync(stagedServerPkgPath, { recursive: true });\n+            const stagedPackageJson = JSON.parse(fs.readFileSync(path.join(serverPkgPath, 'package.json'), 'utf8')) as {\n+                scripts?: Record<string, string>;\n+                devDependencies?: Record<string, string>;\n+            };\n+            // The staged dist is built explicitly for this fixture, so the package lifecycle must not\n+            // build again. Development-only workspace dependencies are also unnecessary in the\n+            // install fixture and cannot be resolved from the deliberately minimal staging workspace.\n+            delete stagedPackageJson.scripts?.prepack;\n+            delete stagedPackageJson.devDependencies;\n+            fs.writeFileSync(path.join(stagedServerPkgPath, 'package.json'), JSON.stringify(stagedPackageJson, null, 2));\n+            // Keep the stage in a tiny pnpm workspace so catalog: dependency ranges are\n+            // converted to publishable semver ranges when pnpm creates the tarball.\n+            fs.copyFileSync(\n+                path.resolve(serverPkgPath, '../../pnpm-workspace.yaml'),\n+                path.join(packageWorkspaceDir, 'pnpm-workspace.yaml')\n+            );\n+            execSync(`pnpm exec tsdown --out-dir ${JSON.stringify(stagedDistPath)}`, {\n                 cwd: serverPkgPath,\n-                encoding: 'utf8',\n+                stdio: 'pipe',\n                 timeout: 60_000\n             });\n+            let packOutput: string;\n+            try {\n+                packOutput = execSync(`pnpm pack --pack-destination ${JSON.stringify(tempDir)}`, {\n+                    cwd: stagedServerPkgPath,\n+                    encoding: 'utf8',\n+                    timeout: 60_000\n+                });\n+            } catch (error) {\n+                const failure = error as { stdout?: string; stderr?: string; message: string };\n+                throw new Error(\n+                    `Failed to pack staged server package: ${failure.message}\\nstdout:\\n${failure.stdout ?? ''}\\nstderr:\\n${failure.stderr ?? ''}`\n+                );\n+            }\n             const tarballName = path.basename(packOutput.trim().split('\\n').pop()!);\n \n             // Write package.json\n","exit_code":0,"status":"completed"}}
