"escalation_attempt":0,"max_escalation_attempts":3,"handoff_required":false,"retrieval_snapshot":"fbbca4097f074870b2991a500474e7b11a501e1fc96d8cebf61d12b219ca29e4"}},"structured_content":{"goal":"Cloudflare Workers entegrasyon testinden sonra workerd süreçlerinin sızmasını ve sonraki koşumların eski portlarda asılı kalmasını önle. Başarılı ve hatalı test yollarında child process kapanmalı; tekrar koşum stale port nedeniyle asılı kal","relevant_symbols":[{"symbol":"PORT","file":"test/integration/test/server/cloudflareWorkers.test.ts","kind":"variable","hop_distance":0,"relation":"direct_match","score":0.9256776018983403}],"probable_files":["test/integration/test/server/cloudflareWorkers.test.ts"],"decisions":[{"summary":"BM25 + path-aware ranking ile AST sembolleri ve 1-hop import/call komşuları seçildi."},{"summary":"Bağlam ekonomisi: önce en olası dosyaya odaklan; kaynak kanıtı gerekirse en fazla 3 üst sembolü oku ve doğrulama çıktısını hedef dosyayla sınırla."},{"summary":"Birincil paket çalışma dizini: test/integration. Aynı komutu tekrarlama; makine-okunur tam lint/typecheck çıktısını model bağlamına alma."}],"success_criteria":["Cloudflare Workers entegrasyon testinden sonra workerd süreçlerinin sızmasını ve sonraki koşumların eski portlarda asılı kalmasını önle. Başarılı ve hatalı test yollarında child pr"]}},"error":null,"status":"completed"}}
