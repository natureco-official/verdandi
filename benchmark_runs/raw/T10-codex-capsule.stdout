n   259\t            // The HTTP status is keyed on the error's origin, not on its bare\n   260\t            // code: only errors produced inside the dispatch window — the\n   261\t            // validation ladder, the era registry gate and handoff check, a\n   262\t            // missing handler — are answered with the mapped HTTP status from\n   263\t            // the ladder table. Handler-produced errors, whatever their code,\n   264\t            // stay in-band on HTTP 200 — except\n   265\t            // MissingRequiredClientCapability (-32021), whose 400 the spec\n   266\t            // mandates per-error with no origin condition and whose only\n   267\t            // SDK-produced post-window source (the input_required capability\n   268\t            // gate) cannot fire any earlier — a handler-minted -32021 gets\n   269\t            // the same 400; a handler RELAYING a downstream peer's\n   270\t            // -32020/-32022 is not that peer's spec error and stays in-band.\n   271\t            // Must agree with httpStatusForErrorCode (core-internal), which\n   272\t            // is deliberately NOT called here: its `?? 400` ladder fallback\n   273\t            // would wrongly map window codes outside the table.\n   274\t            // The mapping applies only while no response has been committed:\n   275\t            // once the stream is open — the handler streamed first, or the\n   276\t            // exchange is forced-`sse` (which settles its 200 at dispatch\n   277\t            // end) — the status is on the wire and the error rides the\n   278\t            // stream. Pre-dispatch ladder rejections always precede the\n   279\t            // forced-`sse` upgrade, so they keep their mapped status in every\n   280\t            // response mode.\n   281\t            const errorCode = isJSONRPCErrorResponse(message) ? message.error.code : undefined;\n   282\t            const ladderStatus =\n   283\t                errorCode !== undefined && (this._dispatchWindowOpen || errorCode === ProtocolErrorCode.MissingRequiredClientCapability)\n   284\t                    ? LADDER_ERROR_HTTP_STATUS[errorCode]\n   285\t                    : undefined;\n   286\t            if (ladderStatus !== undefined && this._sse === undefined) {\n   287\t                this.settleResponse(Response.json(message, { status: ladderStatus, headers: { 'Content-Type': 'application/json' } }));\n   288\t                queueMicrotask(() => void this.close());\n   289\t                return;\n   290\t            }\n   291\t\n   292\t            if (this._sse !== undefined || this._responseMode === 'sse') {\n   293\t                // Finalize the stream: serialize the terminal result onto it\n   294\t                // after everything already enqueued, then close.\n   295\t                if (this._sse === undefined) {\n   296\t                    this.upgradeToSse();\n   297\t                }\n   298\t                this.writeMessageFrame(message);\n   299\t                this.finalizeStream();\n   300\t                return;\n   301\t            }\n   302\t\n   303\t            // Single JSON body.\n   304\t            this.settleResponse(Response.json(message, { status: 200, headers: { 'Content-Type': 'application/json' } }));\n   305\t            queueMicrotask(() => void this.close());\n   306\t            return;\n   307\t        }\n   308\t\n   309\t        // A message related to the in-flight request that is not its terminal\n   310\t        // response: a mid-call notification or a server-to-client request\n   311\t        // emitted by the handler.\n   312\t        if (this._responseMode === 'json') {\n   313\t            // JSON responses cannot carry mid-call messages; they are dropped.\n   314\t            return;\n   315\t        }\n   316\t        if (this._sse === undefined) {\n   317\t            this.upgradeToSse();\n   318\t        }\n   319\t        this.writeMessageFrame(message);\n   320\t    }\n   321\t\n   322\t    /**\n   323\t     * Writes an SSE comment frame (a keep-alive heartbeat). Dropped when the\n   324\t     * exchange is not currently streaming.\n   325\t     */\n   326\t    writeCommentFrame(comment: string): void {\n   327\t        if (this._closed || this._sse === undefined || this._sse.closed) {\n   328\t            return;\n   329\t        }\n   330\t        const frame = comment\n   331\t            .split('\\n')\n   332\t            .map(line => `: ${line}`)\n   333\t            .join('\\n');\n   334\t        this.writeFrame(`${frame}\\n\\n`);\n   335\t    }\n   336\t\n   337\t    async close(): Promise<void> {\n   338\t        if (this._closed) {\n   339\t            return;\n   340\t        }\n   341\t        this._closed = true;\n   342\t\n   343\t        this._abortCleanup?.();\n   344\t        this._abortCleanup = undefined;\n   345\t\n   346\t        if (this._sse !== undefined && !this._sse.closed) {\n   347\t            this._sse.closed = true;\n   348\t            try {\n   349\t                this._sse.controller.close();\n   350\t            } catch {\n   351\t                // The stream was already closed or cancelled by the consumer.\n   352\t            }\n   353\t        }\n   354\t\n   355\t        if (this._deferredResponse !== undefined && !this._deferredResponse.settled) {\n   356\t            this._deferredResponse.settled = true;\n   357\t            this._deferredResponse.reject(new SdkError(SdkErrorCode.ConnectionClosed, 'Connection closed before a response was produced'));\n   358\t        }\n   359\t\n   360\t        this.onclose?.();\n   361\t    }\n   362\t\n   363\t    private settleResponse(response: Response): void {\n   364\t        if (this._deferredResponse === undefined || this._deferredResponse.settled) {\n   365\t            return;\n   366\t        }\n   367\t        this._deferredResponse.settled = true;\n   368\t        this._deferredResponse.resolve(response);\n   369\t    }\n   370\t\n   371\t    private upgradeToSse(