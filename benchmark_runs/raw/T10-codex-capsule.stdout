);\n   415\t    }\n   416\t\n   417\t    private writeFrame(frame: string): void {\n   418\t        if (this._sse === undefined || this._sse.closed) {\n   419\t            return;\n   420\t        }\n   421\t        try {\n   422\t            this._sse.controller.enqueue(this._sse.encoder.encode(frame));\n   423\t        } catch (error) {\n   424\t            this.onerror?.(new Error(`Failed to write to the response stream: ${error}`));\n   425\t        }\n   426\t    }\n   427\t}\n   430\t        const acceptHeader = req.headers.get('accept');\n   431\t        if (!acceptHeader?.includes('text/event-stream')) {\n   432\t            this.onerror?.(new Error('Not Acceptable: Client must accept text/event-stream'));\n   433\t            return this.createJsonErrorResponse(406, -32_000, 'Not Acceptable: Client must accept text/event-stream');\n   434\t        }\n   435\t\n   436\t        // If an Mcp-Session-Id is returned by the server during initialization,\n   437\t        // clients using the Streamable HTTP transport MUST include it\n   438\t        // in the Mcp-Session-Id header on all of their subsequent HTTP requests.\n   439\t        const sessionError = this.validateSession(req);\n   440\t        if (sessionError) {\n   441\t            return sessionError;\n   442\t        }\n   443\t        const protocolError = this.validateProtocolVersion(req);\n   444\t        if (protocolError) {\n   445\t            return protocolError;\n   446\t        }\n   447\t\n   448\t        // Handle resumability: check for Last-Event-ID header\n   449\t        if (this._eventStore) {\n   450\t            const lastEventId = req.headers.get('last-event-id');\n   451\t            if (lastEventId) {\n   452\t                return this.replayEvents(lastEventId);\n   453\t            }\n   454\t        }\n   455\t\n   456\t        // Check if there's already an active standalone SSE stream for this session\n   457\t        if (this._streamMapping.get(this._standaloneSseStreamId)