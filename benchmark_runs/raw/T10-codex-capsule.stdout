\n   722\t            try {\n   723\t                messages = Array.isArray(rawMessage)\n   724\t                    ? rawMessage.map(msg => JSONRPCMessageSchema.parse(msg))\n   725\t                    : [JSONRPCMessageSchema.parse(rawMessage)];\n   726\t            } catch (error) {\n   727\t                this.onerror?.(error as Error);\n   728\t                return this.createJsonErrorResponse(400, -32_700, 'Parse error: Invalid JSON-RPC message');\n   729\t            }\n   730\t\n   731\t            // Check if this is an initialization request\n   732\t            // https://spec.modelcontextprotocol.io/specification/2025-03-26/basic/lifecycle/\n   733\t            // The schema-validated guard (types/guards.ts → types/schemas.ts —\n   734\t            // NOT a wire/rev* import) gates a transport state mutation: a\n   735\t            // malformed `initialize` must NOT set `_initialized = true` before\n   736\t            // the protocol layer rejects it.\n   737\t            const isInitializationRequest = messages.some(element => isInitializeRequest(element));\n   738\t            if (isInitializationRequest) {\n   739\t                // If it's a server with session management and the session ID is already set we should reject the request\n   740\t                // to avoid re-initialization.\n   741\t                if (this._initialized && this.sessionId !== undefined) {\n   742\t                    this.onerror?.(new Error('Invalid Request: Server already initialized'));\n   743\t                    return this.createJsonErrorResponse(400, -32_600, 'Invalid Request: Server already initialized');\n   744\t                }\n   745\t                if (messages.length > 1) {\n   746\t                    this.onerror?.(new Error('Invalid Request: Only one initialization request is allowed'));\n   747\t                    return this.createJsonErrorResponse(400, -32_600, 'Invalid Request: Only one initialization request is allowed');\n   748\t                }\n   749\t                this.sessionId = this.sessionIdGenerator?.();\n   750\t                this._initialized = true;\n   751\t\n   752\t                // If we have a session ID and an onsessioninitialized handler, call it immediately\n   753\t                // This is needed in cases where the server needs to keep track of multiple sessions\n   754\t                if (this.sessionId && this._onsessioninitialized) {\n   755\t                    await Promise.resolve(this._onsessioninitialized(this.sessionId));\n   756\t                }\n   757\t            }\n   758\t            if (!isInitializationRequest) {\n   759\t                // If an Mcp-Session-Id is returned by the server during initialization,\n   760\t                // clients using the Streamable HTTP transport MUST include it\n   761\t                // in the Mcp-Session-Id header on all of their subsequent HTTP requests.\n   762\t                const sessionError = this.validateSession(req);\n   763\t                if (sessionError) {\n   764\t                    return sessionError;\n   765\t                }\n   766\t                // Mcp-Protocol-Version header is required for all requests after initialization.\n   767\t                const protocolError = this.validateProtocolVersion(req);\n   768\t                if (protocolError) {\n   769\t                    return protocolError;\n   770\t                }\n   771\t            }\n   772\t\n   773\t            // check if it contains requests\n   774\t            const hasRequests = messages.some(element => isJSONRPCRequest(element));\n   775\t\n   776\t            if (!hasRequests) {\n   777\t                // if it only contains notifications or responses, return 202\n   778\t                for (const message of messages) {\n   779\t                    this.onmessage?.(message, { authInfo: options?.authInfo, request });\n   780\t                }\n   781\t                return new Response(null, { status: 202 });\n   782\t            }\n   783\t\n   784\t            // The default behavior is to use SSE streaming\n   785\t            // but in some cases server will return JSON responses\n   786\t            const streamId = crypto.randomUUID();\n   787\t\n   788\t            // Extract protocol version for priming event decision.\n   789\t            // For initialize requests, get from request params.\n   790\t            // For other requests, get from header (already validated).\n   791\t            const initRequest = messages.find(m => isInitializeRequest(m));\n   792\t            const clientProtocolVersion = initRequest\n   793\t                ? initRequest.params.protocolVersion\n   794\t                : (req.headers.get('mcp-protocol-version') ?? DEFAULT_NEGOTIATED_PROTOCOL_VERSION);\n   795\t\n   796\t            if (this._enableJsonResponse) {\n   797\t                // For JSON response mode, return a Promise that resolves when all responses are ready\n   798\t                return new Promise<Response>(resolve => {\n   799\t                    this._streamMapping.set(streamId, {\n   800\t                        resolveJson: resolve,\n   801\t                        cleanup: () => {\n   802\t                            this._streamMapping.delete(streamId);\n   803\t                        }\n   804\t                    });\n   805\t\n   806\t                    for (const message of messages) {\n   807\t                        if (isJSONRPCRequest(message)) {\n   808\t                            this._requestToStreamMapping.set(message.id, streamId);\n   809\t                        }\n   810\t                    }\n   811\t\n   812\t                    for (const message of messages) {\n   813\t                        this.onmessage?.(message, { authInfo: options?.authInfo, request });\n   814\t                    }\n   815\t                });\n   816\t            }\n   817\t\n   818\t            // SSE streaming mode - use ReadableStream with controller for more reliable data pushing\n   819\t            const encoder = new TextEncoder();\n   820\t            let streamController: ReadableStreamDefaultController<Uint8Array>;\n   821\t\n   822\t            const readable = new ReadableStream<Uint8Array>({\n   823\t                start: controller => {\n   824\t                    streamController = controller;\n   825\t                },\n   826\t                cancel: () => {\n   827\t                    // Stream was cancelled by client. Only drop the mapping\n   828\t                    // when it still points at THIS controller — a stale cancel\n   829\t                    // (firing after a Last-Event-ID reconnect registered a\n   830\t                    // resumed stream under the same streamId) must not delete\n   831\t                    // the successor.\n   832\t                    if (this._streamMapping.get(streamId)?.controller === streamController) {\n   833\t                        this._streamMapping.delete(streamId);\n   834\t                    }\n   835\t                }\n   836\t            });\n   837\t\n   838\t            const headers: Record<string, string> = {\n   839\t                'Content-Type': 'text/event-stream',\n   840\t                'Cache-Control': 'no-cache',\n   841\t                Connection: 'keep-alive'\n   842\t            };\n   843\t\n   844\t            // After initialization, always include the session ID if we have one\n   845\t            if (this.sessionId !== undefined) {\n   846\t                headers['mcp-session-id'] = this.sessionId;\n   847\t            }\n   848\t\n   849\t            // Store the response for this request to send messages back through this connection\n   850\t            // We need to track by request ID to maintain the connection\n   851\t            for (const message of messages) {\n   852\t                if (isJSONRPCRequest(message)) {\n   853\t                    this._streamMapping.set(streamId, {\n   854\t                        controller: streamController!,\n   855\t                        encoder,\n   856\t                        cleanup: () => {\n   857\t                            this._streamMapping.delete(streamId);\n   858\t                            try {\n   859\t                                streamController!.close();\n   860\t                            } catch {\n   861\t                                // Controller might already be closed\n   862\t                            }\n   863\t                        }\n   864\t                    });\n   865\t                    this._requestToStreamMapping.set(message.id, streamId);\n   866\t                }\n   867\t            }\n   868\t\n   869\t            // Write priming event if event store is configured (after mapping is set up)\n   870\t            await this.writePrimingEvent(streamController!, encoder, streamId, clientProtocolVersion);\n   871\t\n   872\t            // handle each message\n   873\t            for (const message of messages) {\n   874\t                // Build closeSSEStream callback for requests when eventStore is configured\n   875\t                // AND client supports resumability (a supported protocol version >= 2025-11-25).\n   876\t                // Old clients can't resume if the stream is closed early because they\n   877\t                // didn't receive a priming event with an event ID.\n   878\t                let closeSSEStream: (() => void) | undefined;\n   879\t                let closeStandaloneSSEStream: (() => void) | undefined;\n   880\t                if (isJSONRPCRequest(message) && this._eventStore && this.supportsEmptySSEData(clientProtocolVersion)) {\n   881\t                    closeSSEStream = () => {\n   882\t                        this.closeSSEStream(message.id);\n   883\t                    };\n   884\t                    closeStandaloneSSEStream = () => {\n   885\t                        this.closeStandaloneSSEStream();\n   886\t                    };\n   887\t                }\n   888\t\n   889\t                this.onmessage?.(message, { authInfo: options?.authInfo, request, closeSSEStream, closeStandaloneSSEStream });\n   890\t            }\n   891\t            // The server SHOULD NOT close the SSE stream before sending all JSON-RPC responses\n   892\t            // This will be handled by the send() method when responses are ready\n   893\t\n   894\t            return new Response(readable, { status: 200, headers });\n   895\t        } catch (error) {\n   896\t            // return JSON-RPC formatted error\n   897\t            this.onerror?.(error as Error);\n   898\t            return this.createJsonErrorResponse(400, -32_700, 'Parse error', { data: String(error) });\n   899\t        }\n   900\t    }\n   901\t\n   902\t    /**\n   903\t     * Handles `DELETE` requests to terminate sessions\n   904\t     */\n   905\t    private async handleDeleteRequest(req: Request): Promise<Response> {\n   906\t        const sessionError = this.validateSession(req);\n   907\t        if (sessionError) {\n   908\t            return sessionError;\n   909\t        }\n   910\t        const protocolError = this.validateProtocolVersion(req);\n   911\t        if (protocolError) {\n   912\t            return protocolError;\n   913\t        }\n   914\t\n   915\t        await Promise.resolve(this._onsessionclosed?.(this.sessionId!));\n   916\t        await this.close();\n   917\t        return new Response(null, { status: 200 });\n   918\t    }\n   919\t\n   920\t    /**\n   921\t     * Validates session ID for non-initialization requests.\n   922\t     * Returns `Response` error if invalid, `undefined` otherwise\n   923\t     */\n   924\t    private validateSession(req: Request): Response | undefined {\n   925\t        if (this.sessionIdGenerator === undefined) {\n   926\t            // If the sessionIdGenerator ID is not set, the session management is disabled\n   927\t            // and we don't need to validate the session ID\n   928\t            return undefined;\n   929\t        }\n   930\t        if (!this._initialized) {\npackages/server/src/server/perRequestTransport.ts:337:    async close(): Promise<void> {\npackages/server/src/server/perRequestTransport.ts:373:        const readable = new ReadableStream<Uint8Array>({\npackages/server/src/server/streamableHttp.ts:467:        const readable = new ReadableStream<Uint8Array>({\npackages/server/src/server/streamableHttp.ts:493:        this._streamMapping.set(this._standaloneSseStreamId, {\npackages/server/src/server/streamableHttp.ts:555:            const readable = new ReadableStream<Uint8Array>({\npackages/server/src/server/streamableHttp.ts:588:            this._streamMapping.set(replayedStreamId, {\npackages/server/src/server/streamableHttp.ts:799:                    this._streamMapping.set(streamId, {\npackages/server/src/server/streamableHttp.ts:822:            const readable = new ReadableStream<Uint8Array>({\npackages/server/src/server/streamableHttp.ts:853:                    this._streamMapping.set(streamId, {\npackages/server/src/server/streamableHttp.ts:977:    async close(): Promise<void> {\npackages/server/src/server/streamableHttp.ts:985:            cleanup();\npackages/server/src/server/streamableHttp.ts:1005:            stream.cleanup();\npackages/server/src/server/streamableHttp.ts:1016:            stream.cleanup();\npackages/server/src/server/streamableHttp.ts:1155:                    stream.cleanup();\npackages/server/src/server/streamableHttp.ts:1158:                    stream.cleanup();\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"agent_message","text":"İki yolun yaşam döngüsü netleşti: per-request akışı `upgradeToSse` ile açılıp `finalizeStream/close/cancel` ile kapanıyor; shared transport ise her `StreamMapping` için zaten merkezi `cleanup` kullanıyor. Keep-alive timer’ını bu yaşam döngülerine bağlayacağım; JSON yanıtlarında timer oluşturulmayacak ve iptal/kapanışta idempotent biçimde temizlenecek. Önce seçeneklerin üst katmandan nasıl geçirildiğini ve shared `send/close` temizliğini son kez dar kapsamda kontrol ediyorum."}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/server/src/server/streamableHttp.ts | sed -n '960,1180p'\nnl -ba packages/server/src/server/createMcpHandler.ts | sed -n '170,220p;300,335p;680,730p'\nnl -ba packages/server/src/server/invoke.ts | sed -n '35,80p'\nrg -n \\\"responseMode|keepAlive|keepalive\\\" packages/server/src/server/createMcpHandler.ts packages/server/test/server/createMcpHandler.test.ts packages/server/test/server/streamableHttp.test.ts | head -n 120\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba packages/server/src/server/streamableHttp.ts | sed -n '960,1180p'\nnl -ba packages/server/src/server/createMcpHandler.ts | sed -n '170,220p;300,335p;680,730p'\nnl -ba packages/server/src/server/invoke.ts | sed -n '35,80p'\nrg -n \\\"responseMode|keepAlive|keepalive\\\" packages/server/src/server/createMcpHandler.ts packages/server/test/server/createMcpHandler.test.ts packages/server/test/server/streamableHttp.test.ts | head -n 120\"","aggregated_output":"   960\t     * - Accept if in supported list\n   961\t     * - 400 if unsupported\n   962\t     *\n   963\t     * For HTTP requests without the `MCP-Protocol-Version` header:\n   964\t     * - Accept and default to the version negotiated at initialization\n   965\t     */\n   966\t    private validateProtocolVersion(req: Request): Response | undefined {\n   967\t        const protocolVersion = req.headers.get('mcp-protocol-version');\n   968\t\n   969\t        if (protocolVersion !== null && !this._supportedProtocolVersions.includes(protocolVersion)) {\n   970\t            const error = `Bad Request: Unsupported protocol version: ${protocolVersion} (supported versions: ${this._supportedProtocolVersions.join(', ')})`;\n   971\t            this.onerror?.(new Error(error));\n   972\t            return this.createJsonErrorResponse(400, -32_000, error);\n   973\t        }\n   974\t        return undefined;\n   975\t    }\n   976\t\n   977\t    async close(): Promise<void> {\n   978\t        if (this._closed) {\n   979\t            return;\n   980\t        }\n   981\t        this._closed = true;\n   982\t\n   983\t        // Close all SSE connections\n   984\t        for (const { cleanup } of this._streamMapping.values()) {\n   985\t            cleanup();\n   986\t        }\n   987\t        this._streamMapping.clear();\n   988\t\n   989\t        // Clear any pending responses\n   990\t        this._requestResponseMap.clear();\n   991\t        this.onclose?.();\n   992\t    }\n   993\t\n   994\t    /**\n   995\t     * Close an SSE stream for a specific request, triggering client reconnection.\n   996\t     * Use this to implement polling behavior during long-running operations -\n   997\t     * client will reconnect after the retry interval specified in the priming event.\n   998\t     */\n   999\t    closeSSEStream(requestId: RequestId): void {\n  1000\t        const streamId = this._requestToStreamMapping.get(requestId);\n  1001\t        if (!streamId) return;\n  1002\t\n  1003\t        const stream = this._streamMapping.get(streamId);\n  1004\t        if (stream) {\n  1005\t            stream.cleanup();\n  1006\t        }\n  1007\t    }\n  1008\t\n  1009\t    /**\n  1010\t     * Close the standalone `GET` SSE stream, triggering client reconnection.\n  1011\t     * Use this to implement polling behavior for server-initiated notifications.\n  1012\t     */\n  1013\t    closeStandaloneSSEStream(): void {\n  1014\t        const stream = this._streamMapping.get(this._standaloneSseStreamId);\n  1015\t        if (stream) {\n  1016\t            stream.cleanup();\n  1017\t        }\n  1018\t    }\n  1019\t\n  1020\t    async send(message: JSONRPCMessage, options?: { relatedRequestId?: RequestId }): Promise<void> {\n  1021\t        let requestId = options?.relatedRequestId;\n  1022\t        if (isJSONRPCResultResponse(message) || isJSONRPCErrorResponse(message)) {\n  1023\t            // If the message is a response, use the request ID from the message\n  1024\t            requestId = message.id;\n  1025\t        }\n  1026\t\n  1027\t        // Check if this message should be sent on the standalone SSE stream (no request ID)\n  1028\t        // Ignore notifications from tools (which have relatedRequestId set)\n  1029\t        // Those will be sent via dedicated response SSE streams\n  1030\t        if (requestId === undefined) {\n  1031\t            // For standalone SSE streams, we can only send requests and notifications\n  1032\t            if (isJSONRPCResultResponse(message) || isJSONRPCErrorResponse(message)) {\n  1033\t                throw new Error('Cannot send a response on a standalone SSE stream unless resuming a previous client request');\n  1034\t            }\n  1035\t\n  1036\t            // Generate and store event ID if event store is provided\n  1037\t            // Store even if stream is disconnected so events can be replayed on reconnect\n  1038\t            let eventId: string | undefined;\n  1039\t            if (this._eventStore) {\n  1040\t                // Stores the event and gets the generated event ID\n  1041\t                eventId = await this._eventStore.storeEvent(this._standaloneSseStreamId, message);\n  1042\t            }\n  1043\t\n  1044\t            const standaloneSse = this._streamMapping.get(this._standaloneSseStreamId);\n  1045\t            if (standaloneSse === undefined) {\n  1046\t                // Stream is disconnected - event is stored for replay, nothing more to do\n  1047\t                return;\n  1048\t            }\n  1049\t\n  1050\t            // Send the message to the standalone SSE stream — unless the\n  1051\t            // resumed stream's replay already delivered this exact eventId\n  1052\t            // (identity dedup; mirrors the per-request path below).\n  1053\t            if (\n  1054\t                standaloneSse.controller &&\n  1055\t                standaloneSse.encoder &&\n  1056\t                (eventId === undefined || !standaloneSse.replayedEventIds?.has(eventId))\n  1057\t            ) {\n  1058\t                this.writeSSEEvent(standaloneSse.controller, standaloneSse.encoder, message, eventId);\n  1059\t            }\n  1060\t            return;\n  1061\t        }\n  1062\t\n  1063\t        // Get the response for this request\n  1064\t        const streamId = this._requestToStreamMapping.get(requestId);\n  1065\t        if (!streamId) {\n  1066\t            throw new Error(`No connection established for request ID: ${String(requestId)}`);\n  1067\t        }\n  1068\t\n  1069\t        let stream = this._streamMapping.get(streamId);\n  1070\t\n  1071\t        if (!this._enableJsonResponse) {\n  1072\t            // Store FIRST so request-related events emitted while the per-request\n  1073\t            // stream is disconnected (e.g. after `closeSSE()` or a transient\n  1074\t            // client drop) are replayed on Last-Event-ID reconnect — same\n  1075\t            // store-first semantics as the standalone path above. Storage is\n  1076\t            // keyed on request-in-flight (`_requestToStreamMapping` resolved\n  1077\t            // `streamId` above), not on whether a live SSE writer currently\n  1078\t            // exists: `_streamMapping` tracks the delivery target only. Per\n  1079\t            // 2025-11-25 transports.mdx, disconnection SHOULD NOT be\n  1080\t            // interpreted as the client cancelling its request.\n  1081\t            let eventId: string | undefined;\n  1082\t            if (this._eventStore) {\n  1083\t                eventId = await this._eventStore.storeEvent(streamId, message);\n  1084\t                // Re-read after the await: a Last-Event-ID reconnect during\n  1085\t                // storeEvent() may have registered a resumed stream under this\n  1086\t                // streamId (mirrors the standalone path's post-await read).\n  1087\t                stream = this._streamMapping.get(streamId);\n  1088\t            }\n  1089\t            // Write the event to the response stream — unless the resumed\n  1090\t            // stream's replay already delivered this exact eventId (the store\n  1091\t            // committed before replay scanned, so replay wrote it; identity\n  1092\t            // dedup only, no ordering assumption).\n  1093\t            if (stream?.controller && stream?.encoder && (eventId === undefined || !stream.replayedEventIds?.has(eventId))) {\n  1094\t                this.writeSSEEvent(stream.controller, stream.encoder, message, eventId);\n  1095\t            }\n  1096\t        }\n  1097\t\n  1098\t        if (isJSONRPCResultResponse(message) || isJSONRPCErrorResponse(message)) {\n  1099\t            this._requestResponseMap.set(requestId, message);\n  1100\t            const relatedIds = [...this._requestToStreamMapping.entries()].filter(([_, sid]) => sid === streamId).map(([id]) => id);\n  1101\t\n  1102\t            // Check if we have responses for all requests using this connection\n  1103\t            const allResponsesReady = relatedIds.every(id => this._requestResponseMap.has(id));\n  1104\t\n  1105\t            if (allResponsesReady) {\n  1106\t                if (!stream) {\n  1107\t                    if (this._enableJsonResponse) {\n  1108\t                        // JSON-mode requires a resolveJson sink; with no stream entry the\n  1109\t                        // response is undeliverable.\n  1110\t                        throw new Error(`No connection established for request ID: ${String(requestId)}`);\n  1111\t                    }\n  1112\t                    if (!this._eventStore) {\n  1113\t                        // SSE-mode with no live writer and no event store: the\n  1114\t                        // response is undeliverable AND not stored. Surface via\n  1115\t                        // onerror so the drop is observable (matching pre-PR\n  1116\t                        // behaviour), then run the bookkeeping cleanup so the\n  1117\t                        // request id is retired.\n  1118\t                        this.onerror?.(\n  1119\t                            new Error(\n  1120\t                                `Response for request ID ${String(requestId)} is undeliverable: per-request stream is disconnected and no eventStore is configured`\n  1121\t                            )\n  1122\t                        );\n  1123\t                        for (const id of relatedIds) {\n  1124\t                            this._requestResponseMap.delete(id);\n  1125\t                            this._requestToStreamMapping.delete(id);\n  1126\t                        }\n  1127\t                        return;\n  1128\t                    }\n  1129\t                    // SSE-mode with no live writer and an event store configured:\n  1130\t                    // the response was stored above for replay on Last-Event-ID\n  1131\t                    // reconnect. Return cleanly after running the bookkeeping\n  1132\t                    // cleanup so the request id is retired.\n  1133\t                    for (const id of relatedIds) {\n  1134\t                        this._requestResponseMap.delete(id);\n  1135\t                        this._requestToStreamMapping.delete(id);\n  1136\t                    }\n  1137\t                    return;\n  1138\t                }\n  1139\t                if (this._enableJsonResponse && stream.resolveJson) {\n  1140\t                    // All responses ready, send as JSON\n  1141\t                    const headers: Record<string, string> = {\n  1142\t                        'Content-Type': 'application/json'\n  1143\t                    };\n  1144\t                    if (this.sessionId !== undefined) {\n  1145\t                        headers['mcp-session-id'] = this.sessionId;\n  1146\t                    }\n  1147\t\n  1148\t                    const responses = relatedIds.map(id => this._requestResponseMap.get(id)!);\n  1149\t\n  1150\t                    if (responses.length === 1) {\n  1151\t                        stream.resolveJson(Response.json(responses[0], { status: 200, headers }));\n  1152\t                    } else {\n  1153\t                        stream.resolveJson(Response.json(responses, { status: 200, headers }));\n  1154\t                    }\n  1155\t                    stream.cleanup();\n  1156\t                } else {\n  1157\t                    // End the SSE stream\n  1158\t                    stream.cleanup();\n  1159\t                }\n  1160\t                // Clean up\n  1161\t                for (const id of relatedIds) {\n  1162\t                    this._requestResponseMap.delete(id);\n  1163\t                    this._requestToStreamMapping.delete(id);\n  1164\t                }\n  1165\t            }\n  1166\t        }\n  1167\t    }\n  1168\t}\n   170\t     * - `'auto'` (default) — a single JSON body unless the handler emits a\n   171\t     *   related message before its result, in which case the response upgrades\n   172\t     *   to an SSE stream.\n   173\t     * - `'sse'` — always stream.\n   174\t     * - `'json'` — never stream. **Mid-call notifications (progress, logging,\n   175\t     *   any related message emitted before the result) are dropped** — only the\n   176\t     *   terminal result is delivered. Listen-class subscription streams are\n   177\t     *   always served over SSE regardless of this setting.\n   178\t     */\n   179\t    responseMode?: PerRequestResponseMode;\n   180\t    /**\n   181\t     * The change-event bus `subscriptions/listen` streams subscribe to.\n   182\t     *\n   183\t     * When omitted, an in-process {@link InMemoryServerEventBus} is created\n   184\t     * and the returned handler's `notify` sugar publishes onto it.\n   185\t     * Multi-process deployments supply their own implementation over their\n   186\t     * pub/sub backend; the same instance can be shared across handlers.\n   187\t     */\n   188\t    bus?: ServerEventBus;\n   189\t    /**\n   190\t     * Reject a new `subscriptions/listen` with `-32603` 'Subscription limit\n   191\t     * reached' (in-band, HTTP 200, before the ack) when this many subscription\n   192\t     * streams are already open on this handler.\n   193\t     * @default 1024\n   194\t     */\n   195\t    maxSubscriptions?: number;\n   196\t    /**\n   197\t     * SSE comment-frame keepalive interval for `subscriptions/listen` streams,\n   198\t     * in milliseconds. Set to `0` to disable.\n   199\t     * @default 15000\n   200\t     */\n   201\t    keepAliveMs?: number;\n   202\t}\n   203\t\n   204\t/**\n   205\t * The handler returned by {@linkcode createMcpHandler}: a web-standard\n   206\t * `{ fetch, close, notify, bus }` object — the shape Workers/Bun/Deno expect\n   207\t * from `export default`. `fetch` is an arrow-assigned bound property: it can be\n   208\t * detached and passed around (`const { fetch } = handler`) without losing its\n   209\t * binding.\n   210\t *\n   211\t * Node frameworks (Express, Fastify, plain `node:http`) wrap the handler once\n   212\t * with `toNodeHandler(handler)` from `@modelcontextprotocol/node`.\n   213\t */\n   214\texport interface McpHttpHandler {\n   215\t    /** Web-standard face: serve one HTTP request and resolve with the response. */\n   216\t    fetch: (request: Request, options?: McpHandlerRequestOptions) => Promise<Response>;\n   217\t    /**\n   218\t     * Tears down the modern leg: aborts in-flight modern exchanges and closes\n   219\t     * their per-request instances. Legacy serving is unaffected — the\n   220\t     * stateless fallback is per-request by construction and holds nothing\n   300\t * Because serving is per-request and stateless, GET and DELETE (2025 session\n   301\t * operations) are answered with `405` / `Method not allowed.`, exactly like the\n   302\t * canonical stateless example.\n   303\t *\n   304\t * The optional `onerror` callback receives factory and serving failures on\n   305\t * this leg (reporting only — the response stays the 500 internal-error body).\n   306\t * The entry passes its own `onerror` here when expanding the default, so\n   307\t * legacy-leg failures are never silently swallowed.\n   308\t */\n   309\texport function legacyStatelessFallback(factory: McpServerFactory, onerror?: (error: Error) => void): LegacyHttpHandler {\n   310\t    return async (request, options) => {\n   311\t        if (request.method.toUpperCase() !== 'POST') {\n   312\t            return jsonRpcErrorResponse(405, -32_000, 'Method not allowed.');\n   313\t        }\n   314\t        try {\n   315\t            const product = await factory({\n   316\t                era: 'legacy',\n   317\t                ...(options?.authInfo !== undefined && { authInfo: options.authInfo }),\n   318\t                requestInfo: request\n   319\t            });\n   320\t            const transport = new WebStandardStreamableHTTPServerTransport({ sessionIdGenerator: undefined });\n   321\t            await product.connect(transport);\n   322\t\n   323\t            const teardown = () => {\n   324\t                void transport.close().catch(() => {});\n   325\t                void product.close().catch(() => {});\n   326\t            };\n   327\t            // Tear the per-request pair down when the client goes away before\n   328\t            // the exchange completes.\n   329\t            request.signal?.addEventListener('abort', teardown, { once: true });\n   330\t\n   331\t            const response = await transport.handleRequest(request, {\n   332\t                ...(options?.authInfo !== undefined && { authInfo: options.authInfo }),\n   333\t                ...(options?.parsedBody !== undefined && { parsedBody: options.parsedBody })\n   334\t            });\n   335\t            if (response.body === null || mediaTypeEssence(response.headers.get('content-type')) !== 'text/event-stream') {\n   680\t        // envelope did not declare is refused here, before any instance is\n   681\t        // constructed or dispatched. Answering at the entry short-circuits\n   682\t        // before factory construction and pins the spec-mandated HTTP 400 for\n   683\t        // this error unconditionally; a handler-time -32021 (the\n   684\t        // input_required gate) also maps to 400 at the per-request transport,\n   685\t        // but only while no response has been committed.\n   686\t        if (route.messageKind === 'request') {\n   687\t            const required = requiredClientCapabilitiesForRequest(route.message.method);\n   688\t            if (required !== undefined) {\n   689\t                const missing = missingClientCapabilities(required, declaredClientCapabilities);\n   690\t                if (missing !== undefined) {\n   691\t                    const error = new MissingRequiredClientCapabilityError({ requiredCapabilities: missing });\n   692\t                    reportError(error);\n   693\t                    return jsonRpcErrorResponse(\n   694\t                        httpStatusForErrorCode(error.code, 'ladder'),\n   695\t                        error.code,\n   696\t                        error.message,\n   697\t                        error.data,\n   698\t                        route.message.id\n   699\t                    );\n   700\t                }\n   701\t            }\n   702\t        }\n   703\t\n   704\t        const product = await factory({\n   705\t            era: 'modern',\n   706\t            ...(authInfo !== undefined && { authInfo }),\n   707\t            requestInfo: request\n   708\t        });\n   709\t        const server = product instanceof McpServer ? product.server : product;\n   710\t\n   711\t        // Entry-handled `subscriptions/listen`: the router owns ack-first /\n   712\t        // per-stream filtering / subscription-id stamping / keepalive /\n   713\t        // capacity / teardown. The factory IS constructed for listen — to read\n   714\t        // the instance's declared capabilities only, so the acknowledged\n   715\t        // filter reflects what the server can actually deliver. Unlike the\n   716\t        // discover path (which connects via the per-request transport and tears\n   717\t        // down with it), the probe instance is never connected: capabilities\n   718\t        // are read off the unconnected instance and it is closed immediately.\n   719\t        // Authorization the consumer performs inside the factory therefore DOES\n   720\t        // see listen requests, although token verification still belongs at the\n   721\t        // middleware layer mounted in front of this entry.\n   722\t        if (route.messageKind === 'request' && route.message.method === 'subscriptions/listen') {\n   723\t            const capabilities = server.getCapabilities();\n   724\t            const serverInfo = serverIdentityOf(server);\n   725\t            void product.close().catch(reportError);\n   726\t            return listenRouter.serve(route.message, request.signal, capabilities, serverInfo);\n   727\t        }\n   728\t\n   729\t        // SEP-2243 `Mcp-Param-*` server-side validation (pre-dispatch ladder\n   730\t        // rung): for a `tools/call`, look up the named tool's JSON inputSchema\n    35\t    authInfo?: AuthInfo;\n    36\t    /** Response shaping for the exchange; defaults to `auto` (lazy SSE upgrade). */\n    37\t    responseMode?: PerRequestResponseMode;\n    38\t}\n    39\t\n    40\t/**\n    41\t * Serves one classified inbound message on the given server instance and\n    42\t * returns the HTTP response for the exchange.\n    43\t *\n    44\t * The instance is connected to a fresh single-exchange transport, the message\n    45\t * is injected through the normal transport message path, and whatever the\n    46\t * dispatch layer produces (the handler result, a protocol-level rejection, or\n    47\t * streamed related messages followed by the result) is captured as the\n    48\t * returned `Response`. For request exchanges, teardown rides the transport's\n    49\t * close chain once the terminal response has been delivered; notification\n    50\t * exchanges resolve with the 202 response immediately and do NOT run the\n    51\t * close chain — the transport stays connected until the caller closes it or\n    52\t * drops the per-request instance, which is the caller's choice either way.\n    53\t */\n    54\texport async function invoke(\n    55\t    server: Server | McpServer,\n    56\t    message: JSONRPCRequest | JSONRPCNotification,\n    57\t    ctx: InvokeContext\n    58\t): Promise<Response> {\n    59\t    const transport = new PerRequestHTTPServerTransport({\n    60\t        classification: ctx.classification,\n    61\t        ...(ctx.responseMode !== undefined && { responseMode: ctx.responseMode })\n    62\t    });\n    63\t    await server.connect(transport);\n    64\t    return transport.handleMessage(message, {\n    65\t        ...(ctx.request !== undefined && { request: ctx.request }),\n    66\t        ...(ctx.authInfo !== undefined && { authInfo: ctx.authInfo })\n    67\t    });\n    68\t}\npackages/server/test/server/createMcpHandler.test.ts:745:describe('createMcpHandler — responseMode', () => {\npackages/server/test/server/createMcpHandler.test.ts:758:    it(\"responseMode: 'json' never streams and drops mid-call notifications\", async () => {\npackages/server/test/server/createMcpHandler.test.ts:760:        const handler = createMcpHandler(factory, { responseMode: 'json' });\npackages/server/test/server/createMcpHandler.test.ts:770:    it(\"responseMode: 'sse' streams even when the handler emits nothing before its result\", async () => {\npackages/server/test/server/createMcpHandler.test.ts:772:        const handler = createMcpHandler(factory, { responseMode: 'sse' });\npackages/server/src/server/createMcpHandler.ts:179:    responseMode?: PerRequestResponseMode;\npackages/server/src/server/createMcpHandler.ts:197:     * SSE comment-frame keepalive interval for `subscriptions/listen` streams,\npackages/server/src/server/createMcpHandler.ts:201:    keepAliveMs?: number;\npackages/server/src/server/createMcpHandler.ts:593:    const { legacy, onerror, responseMode } = options;\npackages/server/src/server/createMcpHandler.ts:622:        keepAliveMs: options.keepAliveMs ?? DEFAULT_LISTEN_KEEPALIVE_MS,\npackages/server/src/server/createMcpHandler.ts:625:    if (responseMode === 'json') {\npackages/server/src/server/createMcpHandler.ts:628:            \"responseMode: 'json' drops mid-call notifications. subscriptions/listen streams are always served over SSE regardless; \" +\npackages/server/src/server/createMcpHandler.ts:712:        // per-stream filtering / subscription-id stamping / keepalive /\npackages/server/src/server/createMcpHandler.ts:781:                ...(responseMode !== undefined && { responseMode })\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_10","type":"agent_message","text":"Uygulama tercihi: mevcut public `keepAliveMs` adını iki yolda da kullanıp varsayılanı 15 saniye yapıyorum; `0` devre dışı bırakacak. Böylece `createMcpHandler`’ın zaten sunduğu ayar yalnız listen akışlarına değil per-request SSE’ye de uygulanacak, shared transport doğrudan kullanımında da aynı seçenek bulunacak. Kapsülün önerdiği yapılandırılmış yama, değişiklik birkaç sınıf ve yaşam döngüsü noktasına yayıldığı için atomik sembol değişiminden daha az uygun; yerel `apply_patch` ile kontrollü düzenleme yapıyorum."}}
