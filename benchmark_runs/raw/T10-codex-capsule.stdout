reamId, {\n   494\t            controller: streamController!,\n   495\t            encoder,\n   496\t            cleanup: () => {\n   497\t                this._streamMapping.delete(this._standaloneSseStreamId);\n   498\t                try {\n   499\t                    streamController!.close();\n   500\t                } catch {\n   501\t                    // Controller might already be closed\n   502\t                }\n   503\t            }\n   504\t        });\n   505\t\n   506\t        return new Response(readable, { headers });\n   507\t    }\n   508\t\n   509\t    /**\n   510\t     * Replays events that would have been sent after the specified event ID\n   511\t     * Only used when resumability is enabled\n   512\t     */\n   513\t    private async replayEvents(lastEventId: string): Promise<Response> {\n   514\t        if (!this._eventStore) {\n   515\t            this.onerror?.(new Error('Event store not configured'));\n   516\t            return this.createJsonErrorResponse(400, -32_000, 'Event store not configured');\n   517\t        }\n   518\t\n   519\t        try {\n   520\t            // If getStreamIdForEventId is available, use it for conflict checking\n   521\t            let streamId: string | undefined;\n   522\t            if (this._eventStore.getStreamIdForEventId) {\n   523\t                streamId = await this._eventStore.getStreamIdForEventId(lastEventId);\n   524\t\n   525\t                if (!streamId) {\n   526\t                    this.onerror?.(new Error('Invalid event ID format'));\n   527\t                    return this.createJsonErrorResponse(400, -32_000, 'Invalid event ID format');\n   528\t                }\n   529\t\n   530\t                // Check conflict with the SAME streamId we'll use for mapping\n   531\t                if (this._streamMapping.get(streamId) !== undefined) {\n   532\t                    this.onerror?.(new Error('Conflict: Stream already has an active connection'));\n   533\t                    return this.createJsonErrorResponse(409, -32_000, 'Conflict: Stream already has an active connection');\n   534\t                }\n   535\t            }\n   536\t\n   537\t            const headers: Record<string, string> = {\n   538\t                'Content-Type': 'text/event-stream',\n   539\t                'Cache-Control': 'no-cache, no-transform',\n   540\t                Connection: 'keep-alive'\n   541\t            };\n   542\t\n   543\t            if (this.sessionId !== undefined) {\n   544\t                headers['mcp-session-id'] = this.sessionId;\n   545\t            }\n   546\t\n   547\t            // Create a ReadableStream with controller for SSE\n   548\t            const encoder = new TextEncoder();\n   549\t            let streamController: ReadableStreamDefaultController<Uint8Array>;\n   550\t            // Captured by the cancel closure below before it's assigned (after\n   551\t            // replayEventsAfter resolves) — must be `let`.\n   552\t            // eslint-disable-next-line prefer-const\n   553\t            let replayedStreamId: string | undefined;\n   554\t\n   555\t            const readable = new ReadableStream<Uint8Array>({\n   556\t                start: controller => {\n   557\t                    streamController = controller;\n   558\t                },\n   559\t                cancel: () => {\n   560\t                    // Stream was cancelled by client — drop the mapping so a\n   561\t                    // subsequent reconnect with the same Last-Event-ID is not\n   562\t                    // refused with 409 by the conflict check above. Only delete\n   563\t                    // when the mapped entry is still THIS closure's controller:\n   564\t                    // a stale cancel from an earlier resume must not delete a\n   565\t                    // successor resumed stream a re-poll has since registered.\n   566\t                    if (replayedStreamId !== undefined && this._streamMapping.get(replayedStreamId)?.controll