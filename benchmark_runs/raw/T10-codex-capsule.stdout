l\":\"WebStandardStreamableHTTPServerTransport_workers\",\"file\":\"packages/server/src/server/streamableHttp.examples.ts\",\"kind\":\"function\",\"hop_distance\":0,\"relation\":\"direct_match\",\"score\":0.9510679053639609},{\"symbol\":\"WebStandardStreamableHTTPServerTransport_stateless\",\"file\":\"packages/server/src/server/streamableHttp.examples.ts\",\"kind\":\"function\",\"hop_distance\":1,\"relation\":\"imported\",\"score\":0.9496598965318306},{\"symbol\":\"WebStandardStreamableHTTPServerTransport_stateful\",\"file\":\"packages/server/src/server/streamableHttp.examples.ts\",\"kind\":\"function\",\"hop_distance\":1,\"relation\":\"imported\",\"score\":0.9494682627781791}],\"probable_files\":[\"packages/server/src/server/streamableHttp.ts\",\"packages/server/src/server/perRequestTransport.ts\",\"packages/server/src/server/streamableHttp.examples.ts\"],\"decisions\":[{\"summary\":\"BM25 + path-aware ranking ile AST sembolleri ve 1-hop import/call komşuları seçildi.\"},{\"summary\":\"Bağlam ekonomisi: önce en olası dosyaya odaklan; kaynak kanıtı gerekirse en fazla 3 üst sembolü oku ve doğrulama çıktısını hedef dosyayla sınırla.\"},{\"summary\":\"Birincil paket çalışma dizini: packages/server. Aynı komutu tekrarlama; makine-okunur tam lint/typecheck çıktısını model bağlamına alma.\"}],\"success_criteria\":[\"Web-standard Streamable HTTP transport'ta uzun SSE bağlantılarının boşta kalıp ara katmanlarca kapatılmasını önlemek için comment-frame keep-alive desteği ekle. Başarı kriteri: Per\"]}"}],"_meta":{"schema_version":"0.2.0","task_id":"b82caf7c82c894d13ff5cb3d","control":{"estimated_payload_tokens":667,"retrieval_confidence":0.8811737714655449,"uncertainty_reasons":["Sorgu terimlerinin azı sembol/path ile örtüşüyor."],"selected_budget_level":2,"silent_escalation":false,"escalation_attempt":0,"max_escalation_attempts":3,"handoff_required":false,"retrieval_snapshot":"3be17bcb302c97cccad647d97c46d394836c5d84ea7b67b90cd99cc4acd32cd0"}},"structured_content":{"goal":"W